es":"36","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"37","usedDeprecatedRules":"28"},{"filePath":"38","messages":"39","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"40","messages":"41","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"42","messages":"43","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"44","messages":"45","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"46","usedDeprecatedRules":"28"},{"filePath":"47","messages":"48","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"49","messages":"50","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"51","messages":"52","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"53"},"D:\\site-vfinal\\src\\index.js",[],["54","55"],"D:\\site-vfinal\\src\\reportWebVitals.js",[],"D:\\site-vfinal\\src\\App.js",[],"D:\\site-vfinal\\src\\members\\Members.jsx",[],"D:\\site-vfinal\\src\\blogs\\Blog.jsx",["56","57"],"import React, {useState} from \"react\";\nimport CssBaseline from \"@material-ui/core/CssBaseline\";\nimport Grid from \"@material-ui/core/Grid\";\nimport Typography from \"@material-ui/core/Typography\";\nimport Container from \"@material-ui/core/Container\";\nimport Data from \"./blogInfo.json\";\nimport { motion, AnimatePresence} from \"framer-motion\";\nimport Card from 'react-bootstrap/Card';\nimport ExpandLessIcon from '@material-ui/icons/ExpandLess';\nimport ExpandMoreIcon from '@material-ui/icons/ExpandMore';\nimport LocalLibraryIcon from '@material-ui/icons/LocalLibrary';\nimport './blog.css';\nimport {Link} from 'react-bootstrap'\n\nlet data = JSON.stringify(Data);\nlet blogData = JSON.parse(data);\n\nfunction Album(props) {\n  const container = {\n    hidden: { rotate: 180, opacity:0 },\n    show: {\n      rotate: 0,\n      opacity:1,\n    }\n  };\n  // console.log(props.cardOpen)\n  return (\n    <div>\n      <motion.div \n      className=\"cardblock\"\n      variants={container}\n      initial=\"hidden\"\n      animate=\"show\"\n      whileHover={{\n        scale: 1.08,\n        transition: { duration: 0.25 },\n      }}\n      >\n      <Card.Text >\n      <motion.div >\n        <p className=\"heading\" style={{fontSize:20, paddingTop:20}}>\n          {props.blogTitle}\n        </p>\n        </motion.div>\n      </Card.Text>\n      <Card.Body style={{paddingBottom:45}}>\n        <motion.div>\n        <Card.Img \n          src={props.imgsrc} \n          alt=\"Card image\"\n          className=\"cardMedia\" \n        />\n        </motion.div>\n      {props.cardOpen && \n        <AnimatePresence>\n        <motion.div\n        initial={{opacity:0}}\n        animate={{opacity:1, transition:2}}\n        >\n        <p className=\"desc\" gutterbottom>\n          {props.blogDescription}\n        </p>\n         <a href={props.blogLink}\n          style={{color:\"gray\", textDecoration:\"none\", fontSize:17, fontFamily:\"calibri\", fontSmooth: \"auto\", cursor:\"pointer\", display:\"flex\", justifyContent:\"center\"}}>\n            <LocalLibraryIcon style={{marginRight:7}}/>Read blog\n        </a>\n        </motion.div>\n      </AnimatePresence> \n    }\n     {(props.cardOpen) ?\n      <div onClick={props.isOpen} style={{float:\"right\", cursor:\"pointer\"}}>\n        <ExpandLessIcon style={{fontSize:40, color:\"#909090\"}}/>\n    </div> : (\n      <div onClick={props.isOpen} style={{float:\"right\", cursor:\"pointer\"}}>\n        <ExpandMoreIcon style={{fontSize:40, color:\"\t#909090\"}}/>\n    </div>\n    )}\n    </Card.Body>\n    </motion.div>\n    </div>\n  );\n}\n\nexport default function ProjectItems() {\n  const [cardOpen, setCardOpen]= useState(false);\n  return (\n    <React.Fragment>\n      <CssBaseline />\n      <main>\n        <div className=\"heroContent\">\n          <Container maxWidth=\"lg\">\n            <Typography \n              variant=\"h2\"\n              align=\"center\"\n              color=\"whitesmoke\"\n              style={{marginBottom:20, fontSize:70, fontFamily:\"calibri\"}}\n              className=\"root\"\n              gutterBottom\n            >\n              Blogs\n            </Typography>\n          </Container>\n        </div>\n        <Container maxWidth=\"md\">\n        <Grid container spacing={4}>\n        {blogData.map(post => (\n              <Grid item xs={12} sm={6} md={4}  key={post.id}>\n                <div>\n              <Album\n                  blogId={post.id}\n                  blogTitle={post.title}\n                  blogDescription={post.summary}\n                  imgsrc={post.image_link}\n                  blogLink={post.article_link}\n                  isOpen={()=>{setCardOpen(id => {if(post.id==id) return null; return post.id;})}}\n                  cardOpen={cardOpen===post.id}\n                />\n          </div>\n          </Grid>\n          ))}    \n          </Grid>      \n        </Container>\n      </main>\n    </React.Fragment>\n  );\n}","D:\\site-vfinal\\src\\home\\home.js",[],"D:\\site-vfinal\\src\\navbar\\navbar.js",[],"D:\\site-vfinal\\src\\Achievements\\Achievements.jsx",[],"D:\\site-vfinal\\src\\Projects\\Projects.jsx",["58"],"import React, { useEffect } from 'react';\nimport { Container, Row, Col, Image, Card, Button } from 'react-bootstrap';\nimport { motion, AnimateSharedLayout } from 'framer-motion';\nimport './Projects.css';\nimport Modal from '../Modal/Modal';\nimport axios from 'axios';\nexport default function Projects() {\n  const [modalShow, setModalShow] = React.useState(false);\n  const [props, setProps] = React.useState({});\n  const [data, setData] = React.useState([]);\n  const [modalCondn, setModalCondn] = React.useState([].fill(false, 0, 4));\n  useEffect(() => {\n    axios.get('./data.json').then((res) => {\n      setData(res.data);\n    });\n  }, []);\n  const modalDisplay = (title, members, info, image, layoutId, key) => {\n    setProps({\n      title: title,\n      members: members,\n      info: info,\n      image: image,\n      layoutId: layoutId,\n    });\n    setModalShow(true);\n    let newArr = [...modalCondn];\n    newArr.fill(false, 0, 4);\n    newArr[Number(key) - 1] = true;\n    setModalCondn(newArr);\n  };\n  const createModal = () => {\n    return <Modal {...props} show={modalShow} onHide={() => setModalShow(false)}></Modal>;\n  };\n  return (\n    <div id=\"projects-page\">\n      <Image\n        className=\"project_banner\"\n        src=\"https://images.unsplash.com/photo-1572177812156-58036aae439c?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=1050&q=80\"\n        fluid\n      ></Image>\n      <div className=\"domains\">\n        <div className=\"logo web\"></div>\n        <div className=\"logo app\"></div>\n        <div className=\"logo algo\"></div>\n        <div className=\"logo tronix\"></div>\n      </div>\n      <Container fluid=\"md\">\n        <Container fluid>\n          <Row className=\"my-3\">\n            <Col md={5}>\n              <AnimateSharedLayout>\n                {modalShow && modalCondn[0] ? (\n                  createModal()\n                ) : (\n                  <motion.div className=\"motion-card\" layoutId=\"expandable-card-1\">\n                    <Card\n                      style={{ background: 'rgba(163,163,163,0.23)' }}\n                      className=\"text-white project-card\"\n                    >\n                      <Card.Img\n                        className=\"project-image\"\n                        variant=\"top\"\n                        src=\"https://spider.nitt.edu/images/Projects/Fake_real-1_gebpwg%20-%20Adithya%20Krishnakumar.png\"\n                      />\n                      <Card.Body className=\"text-center project-body\">\n                        <motion.div>\n                          <Card.Title className=\"project-title\">Fake News Detector</Card.Title>\n                        </motion.div>\n                        <motion.div whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }}>\n                          <Button\n                            variant=\"outline-light\"\n                            onClick={() => {\n                              modalDisplay(\n                                'Fake News Detector',\n                                ['Mem1', 'Mem2'],\n                                'Lorem ipsum dolor sit, amet consectetur adipisicing elit. Officiis laborum quasi assumenda delectus molestias aperiam esse magni accusantium sequi quos?',\n                                'https://spider.nitt.edu/images/Projects/Fake_real-1_gebpwg%20-%20Adithya%20Krishnakumar.png',\n                                'expandable-card-1',\n                                '1',\n                              );\n                            }}\n                          >\n                            Learn More\n                          </Button>\n                        </motion.div>\n                      </Card.Body>\n                    </Card>\n                  </motion.div>\n                )}\n              </AnimateSharedLayout>\n            </Col>\n            <Col className=\"\" md={7}>\n              <AnimateSharedLayout>\n                {modalShow && modalCondn[1] ? (\n                  createModal()\n                ) : (\n                  <motion.div className=\"motion-card\" layoutId=\"expandable-card-2\">\n                    <Card\n                      style={{ background: 'rgba(163,163,163,0.23)' }}\n                      className=\"text-white project-card\"\n                    >\n                      <Card.Img\n                        className=\"project-image\"\n                        variant=\"top\"\n                        src=\"https://spider.nitt.edu/images/Projects/SpectralClustering%20-%20Anagha%20Sethuraman.jpg\"\n                      />\n                      <Card.Body className=\"text-center project-body\">\n                        <motion.div>\n                          <Card.Title className=\"project-title\">\n                            Image Segmentation using Spectral Clustering\n                          </Card.Title>\n                        </motion.div>\n                        <motion.div whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }}>\n                          <Button\n                            variant=\"outline-light\"\n                            onClick={() => {\n                              modalDisplay(\n                                'Image Segmentation using Spectral Clustering',\n                                ['Mem1', 'Mem2'],\n                                '  Lorem ipsum dolor sit, amet consectetur adipisicing elit. Officiis laborum quasi assumenda delectus molestias aperiam esse magni accusantium sequi quos?',\n                                'https://spider.nitt.edu/images/Projects/SpectralClustering%20-%20Anagha%20Sethuraman.jpg',\n                                'expandable-card-2',\n                                '2',\n                              );\n                            }}\n                          >\n                            Learn More\n                          </Button>\n                        </motion.div>\n                      </Card.Body>\n                    </Card>\n                  </motion.div>\n                )}\n              </AnimateSharedLayout>\n            </Col>\n          </Row>\n        </Container>\n        <Container fluid>\n          <Row>\n            <Col className=\"my-3\" md={7}>\n              <AnimateSharedLayout>\n                {modalShow && modalCondn[2] ? (\n                  createModal()\n                ) : (\n                  <motion.div className=\"motion-card\" layoutId=\"expandable-card-3\">\n                    <Card\n                      style={{ background: 'rgba(163,163,163,0.23)' }}\n                      className=\"text-white project-card\"\n                    >\n                      <Card.Img\n                        className=\"project-image\"\n                        variant=\"top\"\n                        src=\"https://spider.nitt.edu/images/Projects/img%20-%20Ruphan%20S.jpeg\"\n                      />\n                      <Card.Body className=\"text-center project-body\">\n                        <motion.div>\n                          <Card.Title className=\"project-title\">Project Braille</Card.Title>\n                        </motion.div>\n                        <motion.div whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }}>\n                          <Button\n                            variant=\"outline-light\"\n                            onClick={() => {\n                              modalDisplay(\n                                'Project Braille',\n                                ['Mem1', 'Mem2'],\n                                '  Lorem ipsum dolor sit, amet consectetur adipisicing elit. Officiis laborum quasi assumenda delectus molestias aperiam esse magni accusantium sequi quos?',\n                                'https://spider.nitt.edu/images/Projects/img%20-%20Ruphan%20S.jpeg',\n                                'expandable-card-3',\n                                '3',\n                              );\n                            }}\n                          >\n                            Learn More\n                          </Button>\n                        </motion.div>\n                      </Card.Body>\n                    </Card>\n                  </motion.div>\n                )}\n              </AnimateSharedLayout>\n            </Col>\n            <Col className=\"my-3\" md={5}>\n              <AnimateSharedLayout>\n                {modalShow && modalCondn[3] ? (\n                  createModal()\n                ) : (\n                  <motion.div className=\"motion-card\" layoutId=\"expandable-card-4\">\n                    <Card\n                      style={{ background: 'rgba(163,163,163,0.23)' }}\n                      className=\"text-white project-card\"\n                    >\n                      <Card.Img\n                        className=\"project-image\"\n                        variant=\"top\"\n                        src=\"https://spider.nitt.edu/images/Projects/armadillo%20-%20Mukesh%20Gandhi.png\"\n                      />\n                      <Card.Body className=\"text-center project-body\">\n                        <motion.div>\n                          <Card.Title className=\"project-title\">Armadilo</Card.Title>\n                        </motion.div>\n                        <motion.div whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }}>\n                          <Button\n                            variant=\"outline-light\"\n                            onClick={() => {\n                              modalDisplay(\n                                'Armadilo',\n                                ['Mem1', 'Mem2'],\n                                '  Lorem ipsum dolor sit, amet consectetur adipisicing elit. Officiis laborum quasi assumenda delectus molestias aperiam esse magni accusantium sequi quos?',\n                                'https://spider.nitt.edu/images/Projects/armadillo%20-%20Mukesh%20Gandhi.png',\n                                'expandable-card-4',\n                                '4',\n                              );\n                            }}\n                          >\n                            Learn More\n                          </Button>\n                        </motion.div>\n                      </Card.Body>\n                    </Card>\n                  </motion.div>\n                )}\n              </AnimateSharedLayout>\n            </Col>\n          </Row>\n        </Container>\n      </Container>\n    </div>\n  );\n}\n","D:\\site-vfinal\\src\\members\\All_members.js",[],"D:\\site-vfinal\\src\\home\\desc\\desc.js",[],"D:\\site-vfinal\\src\\Modal\\Modal.jsx",["59","60"],"import React from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport './Modal.css';\nimport ModalHeader from 'react-bootstrap/esm/ModalHeader';\nimport {\n  ModalBody,\n  ModalFooter,\n  ModalTitle,\n  Button,\n  Image,\n  ModalDialog,\n  Accordion,\n  Card,\n} from 'react-bootstrap';\nconst backdrop = {\n  visible: {\n    opacity: 1,\n    transition: {\n      from: 0,\n      duration: 1,\n    },\n  },\n  hidden: { opacity: 0 },\n};\nconst modal = {\n  hidden: {\n    // opacity:0,\n    // scale:0,\n    transition: { type: 'spring', stiffness: 120 },\n  },\n  visible: {\n    // opacity:1,\n    // scale:1,\n    transition: { type: 'spring', stiffness: 120 },\n  },\n};\nexport default function Modal(props) {\n  const { show, onHide, title, members, info, image, layoutId } = props;\n  return (\n    <motion.div\n      className=\"backdrop\"\n      variants={backdrop}\n      initial=\"hidden\"\n      animate=\"visible\"\n      exit=\"hidden\"\n      layoutId={layoutId}\n    >\n      <motion.div className=\"custom-modal\" variants={modal}>\n        <ModalDialog className=\"custom-modal\" scrollable centered size=\"lg\">\n          <ModalHeader className=\"modal-title\">\n            <ModalTitle>{title}</ModalTitle>\n          </ModalHeader>\n          <Image className=\"modal-image\" height=\"280px\" width=\"80%\" src={image}></Image>\n          <ModalBody className=\"modal-details\">\n            <Accordion className=\"\" defaultActiveKey=\"0\">\n              <Card style={{ background: 'rgba(163,163,163,0.23)', color: 'white' }}>\n                <Accordion.Toggle\n                  as={Card.Header}\n                  style={{ padding: '0.5rem 1.25rem' }}\n                  eventKey=\"0\"\n                >\n                  Members\n                </Accordion.Toggle>\n                <Accordion.Collapse eventKey=\"0\">\n                  <div className=\"modal-members\">\n                    {members.map((member) => {\n                      return (\n                        <div>\n                          <Image\n                            width={64}\n                            height={64}\n                            src=\"https://www.fg-a.com/wallpapers/white-marble-1-2018.jpg\"\n                            roundedCircle\n                          />\n                          <p>{member}</p>\n                        </div>\n                      );\n                    })}\n                  </div>\n                </Accordion.Collapse>\n              </Card>\n            </Accordion>\n            <p className=\"modal-info\">\n              {info}\n              Lorem, ipsum dolor sit amet consectetur adipisicing elit. Non rerum quae harum est\n              quasi ratione! Quam, laudantium suscipit nulla iste distinctio dicta dolores beatae\n              odit eaque nesciunt eveniet, perspiciatis maiores?\n            </p>\n          </ModalBody>\n          <ModalFooter className=\"custom-modal-footer\">\n            <Button\n              variant=\"primary\"\n              onClick={() => {\n                onHide();\n              }}\n            >\n              Close\n            </Button>\n          </ModalFooter>\n        </ModalDialog>\n      </motion.div>\n    </motion.div>\n  );\n}\n",{"ruleId":"61","replacedBy":"62"},{"ruleId":"63","replacedBy":"64"},{"ruleId":"65","severity":1,"message":"66","line":13,"column":9,"nodeType":"67","messageId":"68","endLine":13,"endColumn":13},{"ruleId":"69","severity":1,"message":"70","line":115,"column":61,"nodeType":"71","messageId":"72","endLine":115,"endColumn":63},{"ruleId":"65","severity":1,"message":"73","line":10,"column":10,"nodeType":"67","messageId":"68","endLine":10,"endColumn":14},{"ruleId":"65","severity":1,"message":"74","line":2,"column":18,"nodeType":"67","messageId":"68","endLine":2,"endColumn":33},{"ruleId":"65","severity":1,"message":"75","line":38,"column":11,"nodeType":"67","messageId":"68","endLine":38,"endColumn":15},"no-native-reassign",["76"],"no-negated-in-lhs",["77"],"no-unused-vars","'Link' is defined but never used.","Identifier","unusedVar","eqeqeq","Expected '===' and instead saw '=='.","BinaryExpression","unexpected","'data' is assigned a value but never used.","'AnimatePresence' is defined but never used.","'show' is assigned a value but never used.","no-global-assign","no-unsafe-negation"]