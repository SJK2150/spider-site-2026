lable centered size=\"lg\">\n          <ModalHeader className=\"modal-title\">\n            <ModalTitle>{title}</ModalTitle>\n          </ModalHeader>\n          <Image className=\"modal-image\" height=\"280px\" width=\"80%\" src={image}></Image>\n          <ModalBody className=\"modal-details\">\n            <div className=\"modal-members\">\n              {members.map((member) => {\n                return <p>{member}</p>;\n              })}\n            </div>\n            <p className=\"modal-info\">\n              {info}\n              Lorem, ipsum dolor sit amet consectetur adipisicing elit. Non rerum quae harum est\n              quasi ratione! Quam, laudantium suscipit nulla iste distinctio dicta dolores beatae\n              odit eaque nesciunt eveniet, perspiciatis maiores?\n            </p>\n          </ModalBody>\n          <ModalFooter className=\"custom-modal-footer\">\n            <Button\n              variant=\"primary\"\n              onClick={() => {\n                onHide();\n              }}\n            >\n              Close\n            </Button>\n          </ModalFooter>\n        </ModalDialog>\n      </motion.div>\n    </motion.div>\n  );\n}\n","/home/rt1301/Programming/site-vfinal/src/Achievements/Achievements.jsx",[],{"ruleId":"44","replacedBy":"45"},{"ruleId":"46","replacedBy":"47"},{"ruleId":"48","severity":1,"message":"49","line":2,"column":18,"nodeType":"50","messageId":"51","endLine":2,"endColumn":33},{"ruleId":"48","severity":1,"message":"52","line":29,"column":11,"nodeType":"50","messageId":"51","endLine":29,"endColumn":15},"no-native-reassign",["53"],"no-negated-in-lhs",["54"],"no-unused-vars","'AnimatePresence' is defined but never used.","Identifier","unusedVar","'show' is assigned a value but never used.","no-global-assign","no-unsafe-negation"]