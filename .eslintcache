1002349854,515.2341918945312 1053.8211002349854,515.2341918945312 \" />\r\n                            <polygon id=\"svg_79\" strokeMiterlimit=\"10\" stroke=\"#070808\" fill=\"#BE5532\" points=\"1060.3211002349854,504.6341857910156 1058.3211002349854,515.2341918945312 1129.7211246490479,515.2341918945312 1127.4210758209229,504.6341857910156 \" />\r\n                            <polygon id=\"svg_80\" fill=\"#AD4025\" points=\"1133.7211246490479,516.2341918945312 1128.5210514068604,516.2341918945312 1095.2211246490479,516.2341918945312 1095.2211246490479,522.3341674804688 1133.7211246490479,522.5341796875 \" />\r\n                            <polygon id=\"svg_81\" fill=\"#AD4025\" points=\"1128.5210514068604,514.4342041015625 1126.7211246490479,505.4342041015625 1095.3211002349854,505.5341796875 1095.3211002349854,514.4342041015625 \" />\r\n                            <polygon id=\"svg_82\" fill=\"#9B3021\" points=\"1059.4211978912354,514.4342041015625 1059.7211246490479,512.4342041015625 1128.1210269927979,512.4342041015625 1128.5210514068604,514.4342041015625 \" />\r\n                        </g>\r\n                        <image stroke=\"null\" xlinkHref={SpiderLogo} id=\"svg_83\" height=\"159.99968\" width=\"159.99968\" y=\"315.55537\" x=\"729.83012\" />\r\n                        <g id=\"sun_icon\" stroke=\"null\">\r\n                        </g>\r\n                    </g>\r\n                </svg>\r\n            </div>\r\n        </>\r\n    )\r\n}\r\n","D:\\site-vfinal\\src\\home\\Team\\CoreMembers\\Members.jsx",["144","145"],"import GitHub from '@material-ui/icons/GitHub';\r\nimport Language from '@material-ui/icons/Language';\r\nimport LinkedIn from '@material-ui/icons/LinkedIn';\r\nimport Card from \"@material-ui/core/Card\";\r\nimport CardContent from \"@material-ui/core/CardContent\";\r\nimport Typography from \"@material-ui/core/Typography\";\r\nimport CardActionArea from \"@material-ui/core/CardActionArea\";\r\nimport CardActions from \"@material-ui/core/CardActions\";\r\nimport CardMedia from \"@material-ui/core/CardMedia\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport React, { useEffect, useState } from 'react'\r\nimport { Container,Row,Col,Button } from 'react-bootstrap'\r\nimport MemData from './coreMembersData.json';\r\nimport './Members.css';\r\nexport default function Members() {\r\n    const [data, setData] = useState([]);\r\n    useEffect(() => {\r\n        setData(MemData);\r\n    }, [])\r\n    return (\r\n        <div>\r\n            <Container id=\"home-core-container\" className=\"text-center\">\r\n               <h1 className=\"home-core-team-title\">Core Members</h1>\r\n               <Row>\r\n                    {data.map((members, index) => {\r\n                        return (\r\n                            <Col md md={4} key={index} style={{margin:\"auto\"}}>\r\n                                <Card className=\"member_card\" style={{ maxWidth: 300 }}>\r\n                                    <CardActionArea>\r\n                                        <CardMedia\r\n                                            component=\"img\"\r\n                                            alt={members.Role}\r\n                                            height=\"270\"\r\n                                            image={members.Photo}\r\n                                            title={members.Role}\r\n                                        />\r\n                                        <CardContent className=\"member_card_content\">\r\n                                            <Typography gutterBottom variant=\"h5\" component=\"h2\">\r\n                                                {members.Name}\r\n                                            </Typography>\r\n                                            <Typography variant=\"h6\" color=\"textSecondary\">\r\n                                                {members.Role}\r\n                                            </Typography>\r\n                                        </CardContent>\r\n\r\n                                        <CardActions\r\n                                            style={{ marginLeft: \"20%\" }}\r\n                                        >\r\n                                            <IconButton\r\n                                                className=\"link_btn\"\r\n                                                aria-label=\"personalSite\"\r\n                                                href={members.Website}\r\n                                            >\r\n                                                <Language></Language>\r\n                                            </IconButton>\r\n                                            <IconButton aria-label=\"linkedIn\" href={members.LinkedIn} className=\"link_btn\">\r\n                                                <LinkedIn></LinkedIn>\r\n                                            </IconButton>\r\n                                            <IconButton aria-label=\"gitHubLink\" href={members.Github} className=\"link_btn\">\r\n                                                <GitHub></GitHub>\r\n                                            </IconButton>\r\n                                        </CardActions>\r\n                                    </CardActionArea>\r\n                                </Card>\r\n                                <br />\r\n                            </Col>\r\n                        )\r\n                    })}\r\n               </Row>\r\n            </Container> \r\n        </div>\r\n    )\r\n}\r\n","D:\\site-vfinal\\src\\DomainToolbar\\Toolbar.jsx",["146","147"],"import React, { useState } from 'react'\r\nimport { Paper, Box } from '@material-ui/core'\r\nimport { Android, Code, Language, SelectAll, CheckBox } from '@material-ui/icons'\r\nimport './Toolbar.css'\r\n\r\nexport default function Toolbar(props) {\r\n    let setDomain = props.setDomain;\r\n    const handleOnClick = (index)=>{\r\n        if(index === -1){\r\n            setDomain([false,false,false,false]);\r\n            return;\r\n        }\r\n        // setDomain([false,false,false,false]);\r\n        let domain = [];\r\n        // domain = [];\r\n        for(let i=0;i<4;i++){\r\n            if(i === index){\r\n                domain.push(true)\r\n            }else{\r\n                domain.push(false)\r\n            }\r\n        }\r\n        setDomain(domain);\r\n        // console.log(domain);\r\n    }\r\n    return (\r\n        <div className='domain-toolbar'>\r\n            <Paper onClick={(e) => {\r\n                e.preventDefault();\r\n                handleOnClick(-1)\r\n            }} className=\"domain-box\" variant=\"outlined\" elevation={5}>\r\n                <CheckBox className='domain-icon'></CheckBox>\r\n                <h6>All</h6>\r\n            </Paper>\r\n            <Paper onClick={(e)=>{\r\n                e.preventDefault();\r\n                handleOnClick(0)\r\n            }} className=\"domain-box\" variant=\"outlined\" elevation={5}>\r\n                <SelectAll className='domain-icon'></SelectAll>\r\n                <h6>Tronix</h6>\r\n            </Paper>\r\n            <Paper onClick={(e) => {\r\n                e.preventDefault();\r\n                handleOnClick(1)\r\n            }} className=\"domain-box\" variant=\"outlined\" elevation={2}>\r\n                <Language className='domain-icon'></Language>\r\n                <h6>Web Dev</h6>\r\n            </Paper>\r\n            <Paper onClick={(e) => {\r\n                e.preventDefault();\r\n                handleOnClick(2)\r\n            }} className=\"domain-box\" variant=\"outlined\" elevation={2}>\r\n                <Code className='domain-icon'></Code>\r\n                <h6>Algos</h6>\r\n            </Paper>\r\n            <Paper onClick={(e) => {\r\n                e.preventDefault();\r\n                handleOnClick(3)\r\n            }} className=\"domain-box\" variant=\"outlined\" elevation={2}>\r\n                <Android className='domain-icon'></Android>\r\n                <h6>App Dev</h6>\r\n            </Paper>\r\n        </div>\r\n    )\r\n}\r\n","D:\\site-vfinal\\src\\Modal\\Modal.jsx",["148","149"],"import React from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport './Modal.css';\nimport ModalHeader from 'react-bootstrap/esm/ModalHeader';\nimport {\n  ModalBody,\n  ModalFooter,\n  ModalTitle,\n  Button,\n  Image,\n  ModalDialog,\n  Accordion,\n  Card,\n} from 'react-bootstrap';\nconst backdrop = {\n  visible: {\n    opacity: 1,\n    transition: {\n      from: 0,\n      duration: 1,\n    },\n  },\n  hidden: { opacity: 0 },\n};\nconst modal = {\n  hidden: {\n    // opacity:0,\n    // scale:0,\n    transition: { type: 'spring', stiffness: 120 },\n  },\n  visible: {\n    // opacity:1,\n    // scale:1,\n    transition: { type: 'spring', stiffness: 120 },\n  },\n};\nexport default function Modal(props) {\n  const { show, onHide, title, members, info, image, layoutId } = props;\n  return (\n    <motion.div\n      className=\"backdrop\"\n      variants={backdrop}\n      initial=\"hidden\"\n      animate=\"visible\"\n      exit=\"hidden\"\n      layoutId={layoutId}\n    >\n      <motion.div className=\"custom-modal\" variants={modal}>\n        <ModalDialog className=\"custom-modal\" scrollable centered size=\"lg\">\n          <ModalHeader className=\"modal-title\">\n            <ModalTitle>{title}</ModalTitle>\n          </ModalHeader>\n          <Image className=\"modal-image\" height=\"280px\" width=\"80%\" src={image}></Image>\n          <ModalBody className=\"modal-details\">\n            <Accordion className=\"\" defaultActiveKey=\"0\">\n              <Card style={{ background: '#6D4DFF', color: 'white', border:\"none\" }}>\n                <Accordion.Toggle\n                  as={Card.Header}\n                  style={{ padding: '0.5rem 1.25rem' }}\n                  eventKey=\"0\"\n                >\n                  Members\n                </Accordion.Toggle>\n                <Accordion.Collapse eventKey=\"0\">\n                  <div className=\"modal-members\">\n                    {members.map((member) => {\n                      return (\n                        <div>\n                          <Image\n                            width={64}\n                            height={64}\n                            src=\"https://www.fg-a.com/wallpapers/white-marble-1-2018.jpg\"\n                            roundedCircle\n                          />\n                          <p>{member}</p>\n                        </div>\n                      );\n                    })}\n                  </div>\n                </Accordion.Collapse>\n              </Card>\n            </Accordion>\n            <p className=\"modal-info\">\n              {info}\n              Lorem, ipsum dolor sit amet consectetur adipisicing elit. Non rerum quae harum est\n              quasi ratione! Quam, laudantium suscipit nulla iste distinctio dicta dolores beatae\n              odit eaque nesciunt eveniet, perspiciatis maiores?\n            </p>\n          </ModalBody>\n          <ModalFooter className=\"custom-modal-footer\">\n            <Button\n              variant=\"primary\"\n              onClick={() => {\n                onHide();\n              }}\n            >\n              Close\n            </Button>\n          </ModalFooter>\n        </ModalDialog>\n      </motion.div>\n    </motion.div>\n  );\n}\n","D:\\site-vfinal\\src\\api\\Index.js",[],"D:\\site-vfinal\\src\\Footer\\footer-bottom.jsx",[],"D:\\site-vfinal\\src\\Footer\\footer-maps.jsx",[],{"ruleId":"150","severity":1,"message":"151","line":5,"column":24,"nodeType":"152","messageId":"153","endLine":5,"endColumn":25,"suggestions":"154"},{"ruleId":"150","severity":1,"message":"151","line":5,"column":30,"nodeType":"152","messageId":"153","endLine":5,"endColumn":31,"suggestions":"155"},{"ruleId":"156","replacedBy":"157"},{"ru