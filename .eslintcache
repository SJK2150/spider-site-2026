ableWarningCount":0,"usedDeprecatedRules":"48"},{"filePath":"62","messages":"63","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"48"},{"filePath":"64","messages":"65","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"48"},"C:\\Users\\bhans\\OneDrive\\Desktop\\site-vfinal\\src\\index.js",[],["66","67"],"C:\\Users\\bhans\\OneDrive\\Desktop\\site-vfinal\\src\\reportWebVitals.js",[],"C:\\Users\\bhans\\OneDrive\\Desktop\\site-vfinal\\src\\App.js",["68","69"],"C:\\Users\\bhans\\OneDrive\\Desktop\\site-vfinal\\src\\home\\home.js",[],"C:\\Users\\bhans\\OneDrive\\Desktop\\site-vfinal\\src\\navbar\\navbar.js",[],"C:\\Users\\bhans\\OneDrive\\Desktop\\site-vfinal\\src\\home\\desc\\desc.js",[],"C:\\Users\\bhans\\OneDrive\\Desktop\\site-vfinal-1\\src\\index.js",[],["70","71"],"C:\\Users\\bhans\\OneDrive\\Desktop\\site-vfinal-1\\src\\reportWebVitals.js",[],"C:\\Users\\bhans\\OneDrive\\Desktop\\site-vfinal-1\\src\\App.js",[],"C:\\Users\\bhans\\OneDrive\\Desktop\\site-vfinal-1\\src\\members\\Members.jsx",["72","73","74","75"],"import { React , useState, useEffect} from 'react';\r\nimport { motion , AnimateSharedLayout, AnimatePresence} from \"framer-motion\";\r\nimport { Container, Row, Col, Button } from \"react-bootstrap\";\r\nimport Card from 'react-bootstrap/Card';\r\nimport CardColumns from 'react-bootstrap/CardColumns';\r\nimport { BrowserRouter as Router } from \"react-router-dom\";\r\nimport MemoryIcon from '@material-ui/icons/Memory';\r\nimport PublicIcon from '@material-ui/icons/Public';\r\nimport AndroidIcon from '@material-ui/icons/Android';\r\nimport AccountTreeIcon from '@material-ui/icons/AccountTree';\r\nimport LinkedInIcon from \"@material-ui/icons/LinkedIn\";\r\nimport LanguageIcon from \"@material-ui/icons/Language\";\r\nimport GitHubIcon from \"@material-ui/icons/GitHub\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport { members } from \"./All_members\";\r\nimport './members.css';\r\n\r\nconst container = {\r\n  hidden: { opacity: 1, scale: 0 },\r\n  visible: {\r\n    opacity: 1,\r\n    scale: 1,\r\n    transition: {\r\n      delayChildren: 0.1,\r\n      staggerChildren: 0.1\r\n    }\r\n  }\r\n}\r\n  \r\nconst item = {\r\n  hidden: { y: 5, opacity: 0 },\r\n  visible: {\r\n    y: 0,\r\n    opacity: 1\r\n  }\r\n}\r\n\r\nconst year = [\r\n  [\"All\", \"All\"],\r\n  [\"B Tech 4th year\", \"2020-21\"],\r\n  [\"B Tech 3rd Year\",\"2021-22\"],\r\n  [\"B Tech 2nd Year\", \"2022-23\"],\r\n  [\"MCA 2nd year\",\"MCA\"],\r\n];\r\n\r\nfunction Members () {\r\n  const [yearName,setYearName]= useState(\"All\");\r\n  const [ProfileName,setProfileName]= useState(\"Tronix\");\r\n  const [clicktronix, setClicktronix] = useState(false);\r\n  const [clickappdev, setClickappdev] = useState(false);\r\n  const [clickwebdev, setClickwebdev] = useState(false);\r\n  const [clickalgos, setClickalgos] = useState(false);\r\n\r\n  const handleClickTronix=()=>{\r\n    setClickappdev(false);\r\n    setClickwebdev(false);\r\n    setClickalgos(false);\r\n    setClicktronix(!clicktronix);\r\n    setProfileName(\"Tronix\");\r\n  }\r\n  const handleClickAppdev=()=>{\r\n    setClicktronix(false);\r\n    setClickwebdev(false);\r\n    setClickalgos(false);\r\n    setClickappdev(!clickappdev);\r\n    setProfileName(\"App Dev\");\r\n  }\r\n  const handleClickWebdev=()=>{\r\n    setClicktronix(false);\r\n    setClickappdev(false);\r\n    setClickalgos(false);\r\n    setClickwebdev(!clickwebdev)\r\n    setProfileName(\"Web Dev\");\r\n  }\r\n  const handleClickAlogs=()=>{\r\n    setClicktronix(false);\r\n    setClickwebdev(false);\r\n    setClickappdev(false);\r\n    setClickalgos(!clickalgos);\r\n    setProfileName(\"Algos\");\r\n  }\r\n\r\n  const handleYearClick =(e, yr)=>{\r\n    setYearName(yr); \r\n  }\r\n\r\n  console.log(yearName, ProfileName)\r\n\r\n  const subMenuAnimate = {\r\n    enter: (i)=> ({\r\n        opacity: 1,\r\n        rotateX: 0,\r\n        transition: {\r\n          duration: i*0.08\r\n        },\r\n        display: \"block\"\r\n      }\r\n    ),\r\n    exit: {\r\n      opacity: 0,\r\n      rotateX: 1,\r\n      display: \"none\"\r\n    }\r\n  };\r\n\r\n  return(\r\n    <Container className=\"container\">\r\n      <Router>\r\n      <h1 style={{color:\"white\", textAlign:\"center\", padding:15, fontSize:55, fontWeight:600}}>Members</h1>\r\n    <br/>\r\n    <>\r\n        <nav className='navbar'>\r\n        <motion.div\r\n            className=\"menu-item\"\r\n        >\r\n          <Button onClick={handleClickTronix} className=\"tronixIcon\"> \r\n            <MemoryIcon fontSize=\"large\" />\r\n            <br/>\r\n            <p className=\"label\">Tronix</p>\r\n          </Button> \r\n          <div className=\"sub-menu\"\r\n              style={{marginTop:12}}\r\n            >\r\n            {clicktronix && \r\n                <div>\r\n                {year.map((item, index)=>{\r\n                  return(\r\n                    <motion.div \r\n                    initial=\"exit\"\r\n                    animate={clicktronix ? \"enter\" : \"exit\"}\r\n                    variants={subMenuAnimate}\r\n                    custom={index}\r\n                    key={index}>\r\n                      <div className=\"batchLinks\" onClick={((e) => handleYearClick(e, item[0]))}>\r\n                        {item[1]}\r\n                      </div>\r\n                  </motion.div>\r\n               )\r\n             })}\r\n           </div>\r\n            }\r\n            </div>\r\n          </motion.div>\r\n          <motion.div\r\n            className=\"menu-item\"\r\n          >\r\n          <Button onClick={handleClickWebdev} className=\"webdevIcon\"> \r\n            <PublicIcon fontSize=\"large\"/>\r\n            <br/>\r\n            <p className=\"label\">Web Dev</p>\r\n          </Button> \r\n          <div className=\"sub-menu\"\r\n              style={{marginTop:12}}\r\n            >\r\n            {clickwebdev && \r\n                <div>\r\n                {year.map((item, index)=>{\r\n                  return(\r\n                    <motion.div \r\n                    initial=\"exit\"\r\n                    animate={clickwebdev ? \"enter\" : \"exit\"}\r\n                    variants={subMenuAnimate}\r\n                    custom={index}\r\n                    key={index}>\r\n                      <div className=\"batchLinks\" onClick={((e) => handleYearClick(e, item[0]))}>\r\n                        {item[1]}\r\n                      </div>\r\n                  </motion.div>\r\n               )\r\n             })}\r\n           </div>\r\n            }\r\n            </div>\r\n          </motion.div> \r\n          <motion.div\r\n            className=\"menu-item\"\r\n          >\r\n          <Button  onClick={handleClickAppdev} className=\"appdevIcon\"> \r\n            <AndroidIcon fontSize=\"large\" />\r\n            <br/>\r\n            <p className=\"label\">App Dev</p>\r\n          </Button> \r\n          <div className=\"sub-menu\"\r\n              style={{marginTop:12}}\r\n            >\r\n            {clickappdev && \r\n                <div>\r\n                {year.map((item, index)=>{\r\n                  return(\r\n                    <motion.div \r\n                    initial=\"exit\"\r\n                    animate={clickappdev ? \"enter\" : \"exit\"}\r\n                    variants={subMenuAnimate}\r\n                    custom={index}\r\n                    key={index}>\r\n                      <div className=\"batchLinks\" onClick={((e) => handleYearClick(e, item[0]))}>\r\n                        {item[1]}\r\n                      </div>\r\n                  </motion.div>\r\n               )\r\n             })}\r\n           </div>\r\n            }\r\n            </div>\r\n          </motion.div>\r\n          <motion.div\r\n            className=\"menu-item\"\r\n          >\r\n          <Button onClick={handleClickAlogs} className=\"algosIcon\"> \r\n            <AccountTreeIcon fontSize=\"large\" />\r\n            <br/>\r\n            <p className=\"label\">Algos</p>\r\n          </Button> \r\n          <div className=\"sub-menu\"\r\n              style={{marginTop:12}}\r\n            >\r\n            {clickalgos && \r\n                <div>\r\n                {year.map((item, index)=>{\r\n                  return(\r\n                    <motion.div \r\n                    initial=\"exit\"\r\n                    animate={clickalgos ? \"enter\" : \"exit\"}\r\n                    variants={subMenuAnimate}\r\n                    custom={index}\r\n                    key={index}>\r\n                      <div className=\"batchLinks\" onClick={((e) => handleYearClick(e, item[0]))}>\r\n                        {item[1]}\r\n                      </div>\r\n                  </motion.div>\r\n               )\r\n             })}\r\n           </div>\r\n            }\r\n            </div>\r\n          </motion.div>\r\n        </nav>\r\n      </>  \r\n    <AnimatePresence initial={true}>\r\n    <motion.ul\r\n    className=\"container\"\r\n    variants={container}\r\n    initial=\"hidden\"\r\n    animate=\"visible\"\r\n    style={{display:\"flex\", justifyContent:\"space-around\", padding:30}}\r\n    >  \r\n    <CardColumns>\r\n      <Container>\r\n        {members\r\n        .filter(member => member.Profile === ProfileName)\r\n        .filter(member => member.Year === yearName)\r\n        .map(member => (\r\n        <motion.div className=\"item\" variants={item} >\r\n        <motion.div\r\n         whileHover={{\r\n          scale: 1.1,\r\n          transition: { duration: 0.3 },\r\n        }}\r\n      >\r\n        <Card className=\"bg-dark text-white\" style={{margin:20}}> \r\n        <Card.Img src={member.Photo} alt={member.Name} />\r\n          <Card.ImgOverlay>\r\n            <Card.Title>{member.Name}</Card.Title>\r\n          </Card.ImgOverlay>\r\n        <Card.Body>\r\n          <Card.Text className=\"iconLinks\">\r\n                  {member.LinkedIn ? (\r\n                    <a href={member.LinkedIn}>\r\n                      <IconButton >\r\n                        <LinkedInIcon fontSize=\"large\" className=\"buttonlinkedInIcon\"/>\r\n                      </IconButton>\r\n                    </a>\r\n                  ) : (\r\n                    <IconButton>\r\n                      <LinkedInIcon fontSize=\"large\" className=\"buttonlinkedInIcon\"/>\r\n                    </IconButton>\r\n                  )}\r\n                  {member.Website ? (\r\n                    <a href={member.Website}>\r\n                      <IconButton>\r\n                        <LanguageIcon className=\"buttonwebIcon\" fontSize=\"large\"/>\r\n                      </IconButton>\r\n                    </a>\r\n                  ) : (\r\n                    <IconButton >\r\n                      <LanguageIcon className=\"buttonwebIcon\" fontSize=\"large\"/>\r\n                    </IconButton>\r\n                  )}\r\n                  {member.Github ? (\r\n                    <a href={member.Github}>\r\n                      <IconButton >\r\n                        <GitHubIcon className=\"buttongithubIcon\" fontSize=\"large\"/>\r\n                      </IconButton>\r\n                    </a>\r\n                  ) : (\r\n                    <IconButton>\r\n                      <GitHubIcon className=\"buttongithubIcon\" fontSize=\"large\"/>\r\n                    </IconButton>\r\n                  )}\r\n              </Card.Text>\r\n            </Card.Body>\r\n            </Card>\r\n            </motion.div>\r\n          </motion.div>\r\n        ))}       \r\n      </Container>  \r\n    </CardColumns>\r\n    </motion.ul> \r\n    </AnimatePresence>   \r\n    </Router>\r\n   </Container>    \r\n)};\r\n\r\nexport default Members;","C:\\Users\\bhans\\OneDrive\\Desktop\\site-vfinal-1\\src\\blogs\\Blog.jsx",["76","77"],"C:\\Users\\bhans\\OneDrive\\Desktop\\site-vfinal-1