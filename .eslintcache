sults":"35","hashOfConfig":"20"},{"size":940,"mtime":1633764450054,"results":"36","hashOfConfig":"20"},{"size":986,"mtime":1633764450055,"results":"37","hashOfConfig":"20"},{"filePath":"38","messages":"39","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"40","usedDeprecatedRules":"41"},"qjvqsy",{"filePath":"42","messages":"43","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"41"},{"filePath":"44","messages":"45","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"41"},{"filePath":"46","messages":"47","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"41"},{"filePath":"48","messages":"49","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"50","usedDeprecatedRules":"41"},{"filePath":"51","messages":"52","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"41"},{"filePath":"53","messages":"54","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"41"},{"filePath":"55","messages":"56","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"57","usedDeprecatedRules":"41"},{"filePath":"58","messages":"59","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"60","usedDeprecatedRules":"41"},{"filePath":"61","messages":"62","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"41"},{"filePath":"63","messages":"64","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"41"},{"filePath":"65","messages":"66","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"67","usedDeprecatedRules":"41"},{"filePath":"68","messages":"69","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"70","messages":"71","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"72","usedDeprecatedRules":"41"},{"filePath":"73","messages":"74","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"75","usedDeprecatedRules":"41"},{"filePath":"76","messages":"77","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"41"},{"filePath":"78","messages":"79","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"41"},{"filePath":"80","messages":"81","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"41"},"D:\\site-vfinal\\src\\index.js",["82","83"],"import React from 'react';\nimport ReactDOM from 'react-dom';\nimport './index.css';\nimport App from './App';\nimport './fonts/Product\\ Sans\\ Regular.ttf'\nimport reportWebVitals from './reportWebVitals';\n\nReactDOM.render(\n  <React.StrictMode>\n    <App />\n  </React.StrictMode>,\n  document.getElementById('root')\n);\n\n// If you want to start measuring performance in your app, pass a function\n// to log results (for example: reportWebVitals(console.log))\n// or send to an analytics endpoint. Learn more: https://bit.ly/CRA-vitals\nreportWebVitals();",["84","85"],"D:\\site-vfinal\\src\\reportWebVitals.js",[],"D:\\site-vfinal\\src\\App.js",[],"D:\\site-vfinal\\src\\members\\Members.jsx",[],"D:\\site-vfinal\\src\\blogs\\Blog.jsx",["86","87"],"import React, {useState} from \"react\";\nimport CssBaseline from \"@material-ui/core/CssBaseline\";\nimport Grid from \"@material-ui/core/Grid\";\nimport Typography from \"@material-ui/core/Typography\";\nimport Container from \"@material-ui/core/Container\";\nimport Data from \"./blogInfo.json\";\nimport { motion, AnimatePresence} from \"framer-motion\";\nimport Card from 'react-bootstrap/Card';\nimport ExpandLessIcon from '@material-ui/icons/ExpandLess';\nimport ExpandMoreIcon from '@material-ui/icons/ExpandMore';\nimport LocalLibraryIcon from '@material-ui/icons/LocalLibrary';\nimport './blog.css';\nimport {Link} from 'react-bootstrap'\n\nlet data = JSON.stringify(Data);\nlet blogData = JSON.parse(data);\n\nfunction Album(props) {\n  const container = {\n    hidden: { rotate: 180, opacity:0 },\n    show: {\n      rotate: 0,\n      opacity:1,\n    }\n  };\n  // console.log(props.cardOpen)\n  return (\n    <div>\n      <motion.div \n      className=\"cardblock\"\n      variants={container}\n      initial=\"hidden\"\n      animate=\"show\"\n      whileHover={{\n        scale: 1.08,\n        transition: { duration: 0.25 },\n      }}\n      >\n      <Card.Text >\n      <motion.div >\n        <p className=\"heading\" style={{fontSize:20, paddingTop:20}}>\n          {props.blogTitle}\n        </p>\n        </motion.div>\n      </Card.Text>\n      <Card.Body style={{paddingBottom:45}}>\n        <motion.div>\n        <Card.Img \n          src={props.imgsrc} \n          alt=\"Card image\"\n          className=\"cardMedia\" \n        />\n        </motion.div>\n      {props.cardOpen && \n        <AnimatePresence>\n        <motion.div\n        initial={{opacity:0}}\n        animate={{opacity:1, transition:2}}\n        >\n        <p className=\"desc\" gutterbottom>\n          {props.blogDescription}\n        </p>\n         <a href={props.blogLink}\n          style={{color:\"gray\", textDecoration:\"none\", fontSize:17, fontFamily:\"calibri\", fontSmooth: \"auto\", cursor:\"pointer\", display:\"flex\", justifyContent:\"center\"}}>\n            <LocalLibraryIcon style={{marginRight:7}}/>Read blog\n        </a>\n        </motion.div>\n      </AnimatePresence> \n    }\n     {(props.cardOpen) ?\n      <div onClick={props.isOpen} style={{float:\"right\", cursor:\"pointer\"}}>\n        <ExpandLessIcon style={{fontSize:40, color:\"#909090\"}}/>\n    </div> : (\n      <div onClick={props.isOpen} style={{float:\"right\", cursor:\"pointer\"}}>\n        <ExpandMoreIcon style={{fontSize:40, color:\"\t#909090\"}}/>\n    </div>\n    )}\n    </Card.Body>\n    </motion.div>\n    </div>\n  );\n}\n\nexport default function ProjectItems() {\n  const [cardOpen, setCardOpen]= useState(false);\n  return (\n    <React.Fragment>\n      <CssBaseline />\n      <main>\n        <div className=\"heroContent\">\n          <Container maxWidth=\"lg\">\n            <Typography \n              variant=\"h2\"\n              align=\"center\"\n              color=\"whitesmoke\"\n              style={{marginBottom:20, fontSize:70, fontFamily:\"calibri\"}}\n              className=\"root\"\n              gutterBottom\n            >\n              Blogs\n            </Typography>\n          </Container>\n        </div>\n        <Container maxWidth=\"md\">\n        <Grid container spacing={4}>\n        {blogData.map(post => (\n              <Grid item xs={12} sm={6} md={4}  key={post.id}>\n                <div>\n              <Album\n                  blogId={post.id}\n                  blogTitle={post.title}\n                  blogDescription={post.summary}\n                  imgsrc={post.image_link}\n                  blogLink={post.article_link}\n                  isOpen={()=>{setCardOpen(id => {if(post.id==id) return null; return post.id;})}}\n                  cardOpen={cardOpen===post.id}\n                />\n          </div>\n          </Grid>\n          ))}    \n          </Grid>      \n        </Container>\n      </main>\n    </React.Fragment>\n  );\n}","D:\\site-vfinal\\src\\home\\home.js",[],"D:\\site-vfinal\\src\\navbar\\navbar.js",[],"D:\\site-vfinal\\src\\Achievements\\Achievements.jsx",["88","89"],"import React from 'react';\nimport { Container, Row, Col, Image, Card, Button } from 'react-bootstrap';\nimport { motion, AnimateSharedLayout } from 'framer-motion';\nimport './Achievements.css';\nimport Modal from '../Modal/Modal';\nimport data from './data.json';\nexport default function Achievements() {\n  const [modalShow, setModalShow] = React.useState(false);\n  const [props, setProps] = React.useState({});\n  const [modalCondn, setModalCondn] = React.useState([].fill(false, 0, 4));\n  const modalDisplay = (title, members, info, image, layoutId, key) => {\n    setProps({\n      title: title,\n      members: members,\n      info: info,\n      image: image,\n      layoutId: layoutId,\n    });\n    setModalShow(true);\n    let newArr = [...modalCondn];\n    newArr.fill(false, 0, 4);\n    newArr[Number(key) - 1] = true;\n    setModalCondn(newArr);\n  };\n  const createModal = () => {\n    return <Modal {...props} show={modalShow} onHide={() => setModalShow(false)}></Modal>;\n  };\n  return (\n    <div id=\"achv-page\">\n      <div className=\"achv-intro-section\">\n        {/* <Image\n          className=\"achv_banner\"\n          src=\"https://images.unsplash.com/photo-1488229297570-58520851e868?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=1049&q=80\"\n          fluid\n        ></Image> */}\n        <div className=\"display-3 achv_banner_title\">Achievements</div>\n      </div>\n      <Container fluid=\"md\">\n        <Container fluid>\n          <Row>\n            {data.map((ele,id)=>{\n              if(id%2 == 0){\n                return(\n                  <Col className=\"my-3\" md={5}>\n                    <AnimateSharedLayout>\n                      {modalShow && modalCondn[id] ? (\n                        createModal()\n                      ) : (\n                          <motion.div className=\"motion-card\" layoutId={`expandable-card-${id+1}`}>\n                          <Card\n                              style={{ background: '#141C3A' }}\n                            className=\"text-white achv-card\"\n                          >\n                            <Card.Img\n                              className=\"achv-image\"\n                              variant=\"top\"\n                              src={ele.image}\n                            />\n                            <Card.Body className=\"text-center achv-body\">\n                              <motion.div>\n                                <Card.Title className=\"achv-title\">{ele.title}</Card.Title>\n                              </motion.div>\n                              <motion.div whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }}>\n                                <Button\n                                  variant=\"outline-light\"\n                                  onClick={() => {\n                                    modalDisplay(\n                                      ele.title,\n                                      ele.members,\n                                      ele.desc,\n                                      ele.image,\n                                      `expandable-card-${id+1}`,\n                                      `${id+1}`,\n                                    );\n                                  }}\n                                >\n                                  Learn More\n                                </Button>\n                              </motion.div>\n                            </Card.Body>\n                          </Card>\n                        </motion.div>\n                      )}\n                    </AnimateSharedLayout>\n                  </Col>\n                )\n              }else{\n                return(\n                  <Col className=\"my-3\" md={7}>\n                    <AnimateSharedLayout>\n                      {modalShow && modalCondn[id] ? (\n                        createModal()\n                      ) : (\n                        <motion.div className=\"motion-card\" layoutId={`expandable-card-${id + 1}`}>\n                          <Card\n                            style={{ background: '#141C3A' }}\n                            className=\"text-white achv-card\"\n                          >\n                            <Card.Img\n                              className=\"achv-image\"\n                              variant=\"top\"\n                              src={ele.image}\n                            />\n                            <Card.Body className=\"text-center achv-body\">\n                              <motion.div>\n                                <Card.Title className=\"achv-title\">{ele.title}</Card.Title>\n                              </motion.div>\n                              <motion.div whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }}>\n                                <Button\n                                  variant=\"outline-light\"\n                                  onClick={() => {\n                                    modalDisplay(\n                                      ele.title,\n                                      ele.members,\n                                      ele.desc,\n                                      ele.image,\n                                      `expandable-card-${id + 1}`,\n                                      `${id + 1}`,\n                                    );\n                                  }}\n                                >\n                                  Learn More\n                                </Button>\n                              </motion.div>\n                            </Card.Body>\n                          </Card>\n                        </motion.div>\n                      )}\n                    </AnimateSharedLayout>\n                  </Col>\n                )\n              }\n            })}\n          </Row>\n        </Container>\n      </Container>\n    </div>\n  );\n}\n","D:\\site-vfinal\\src\\Projects\\Projects.jsx",["90","91","92"],"import React, { useEffect } from 'react';\nimport { Container, Row, Col, Image, Card, Button } from 'react-bootstrap';\nimport { motion, AnimateSharedLayout } from 'framer-motion';\nimport './Projects.css';\nimport Modal from '../Modal/Modal';\nimport axios from 'axios';\nimport data from './data.json'\nexport default function Projects() {\n  const [modalShow, setModalShow] = React.useState(false);\n  const [props, setProps] = React.useState({});\n  // const [data, setData] = React.useState([]);\n  const [modalCondn, setModalCondn] = React.useState([].fill(false, 0, 4));\n  // useEffect(() => {\n  //   axios.get('./data.json').then((res) => {\n  //     setData(res.data);\n  //   });\n  // }, []);\n  const modalDisplay = (title, members, info, image, layoutId, key) => {\n    setProps({\n      title: title,\n      members: members,\n      info: info,\n      image: image,\n      layoutId: layoutId,\n    });\n    setModalShow(true);\n    let newArr = [...modalCondn];\n    console.log(key);\n    newArr.fill(false, 0, 4);\n    newArr[Number(key) - 1] = true;\n    setModalCondn(newArr);\n  };\n  const createModal = () => {\n    return <Modal {...props} show={modalShow} onHide={() => setModalShow(false)}></Modal>;\n  };\n  return (\n    <div id=\"projects-page\">\n      <Image\n        className=\"project_banner\"\n        src=\"https://images.unsplash.com/photo-1572177812156-58036aae439c?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=1050&q=80\"\n        fluid\n      ></Image>\n      <div className=\"domains\">\n        <div className=\"logo web\"></div>\n        <div className=\"logo app\"></div>\n        <div className=\"logo algo\"></div>\n        <div className=\"logo tronix\"></div>\n      </div>\n      <Container fluid=\"md\">\n        <Container fluid>\n          <Row className=\"my-3\">\n            {data.map((ele,id)=>{\n              if(id%2 == 0){\n                return(\n                  <Col className=\"proj-col\" md={5}>\n                    <AnimateSharedLayout>\n                      {modalShow && modalCondn[id] ? (\n                        createModal()\n                      ) : (\n                        <motion.div className=\"motion-card\" layoutId={`expandable-card-${id+1}`}>\n                          <Card\n                            style={{ background: '#141C3A' }}\n                            className=\"text-white project-card\"\n                          >\n                            <Card.Img\n                              className=\"project-image\"\n                              variant=\"top\"\n                              src={ele.projImg}\n                            />\n                            <Card.Body className=\"text-center project-body\">\n                              <motion.div>\n                                <Card.Title className=\"project-title\">{ele.projTitle} {id}</Card.Title>\n                              </motion.div>\n                              <motion.div whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }}>\n                                <Button\n                                  variant=\"outline-light\"\n                                  onClick={() => {\n                                    modalDisplay(\n                                      ele.projTitle,\n                                      ele.projMembers,\n                                      ele.projInfo,\n                                      ele.projImage,\n                                      `expandable-card-${id+1}`,\n                                      `${id+1}`,\n                                    );\n                                  }}\n                                >\n                                  Learn More\n                                </Button>\n                              </motion.div>\n                            </Card.Body>\n                          </Card>\n                        </motion.div>\n                      )}\n                    </AnimateSharedLayout>\n                  </Col>\n                )\n              }else{\n                return(\n                  <Col md={7} className=\"proj-col\">\n                    <AnimateSharedLayout>\n                      {modalShow && modalCondn[id] ? (\n                        createModal()\n                      ) : (\n                          <motion.div className=\"motion-card\" layoutId={`expandable-card-${id + 1}`}>\n                          <Card\n                            style={{ background: '#141C3A' }}\n                            className=\"text-white project-card\"\n                          >\n                            <Card.Img\n                              className=\"project-image\"\n                              variant=\"top\"\n                              src={ele.projImg}\n                            />\n                            <Card.Body className=\"text-center project-body\">\n                              <motion.div>\n                                  <Card.Title className=\"project-title\">{ele.projTitle} {id}</Card.Title>\n                              </motion.div>\n                              <motion.div whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }}>\n                                <Button\n                                  variant=\"outline-light\"\n                                  onClick={() => {\n                                    modalDisplay(\n                                      ele.projTitle,\n                                      ele.projMembers,\n                                      ele.projInfo,\n                                      ele.projImage,\n                                      `expandable-card-${id + 1}`,\n                                      `${id + 1}`,\n                                    );\n                                  }}\n                                >\n                                  Learn More\n                                </Button>\n                              </motion.div>\n                            </Card.Body>\n                          </Card>\n                        </motion.div>\n                      )}\n                    </AnimateSharedLayout>\n                  </Col>\n                )\n              }\n            })}\n          </Row>\n        </Container>\n      </Container>\n    </div>\n  );\n}\n","D:\\site-vfinal\\src\\members\\All_members.js",[],"D:\\site-vfinal\\src\\home\\desc\\desc.js",[],"D:\\site-vfinal\\src\\Modal\\Modal.jsx",["93","94"],"import React from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport './Modal.css';\nimport ModalHeader from 'react-bootstrap/esm/ModalHeader';\nimport {\n  ModalBody,\n  ModalFooter,\n  ModalTitle,\n  Button,\n  Image,\n  ModalDialog,\n  Accordion,\n  Card,\n} from 'react-bootstrap';\nconst backdrop = {\n  visible: {\n    opacity: 1,\n    transition: {\n      from: 0,\n      duration: 1,\n    },\n  },\n  hidden: { opacity: 0 },\n};\nconst modal = {\n  hidden: {\n    // opacity:0,\n    // scale:0,\n    transition: { type: 'spring', stiffness: 120 },\n  },\n  visible: {\n    // opacity:1,\n    // scale:1,\n    transition: { type: 'spring', stiffness: 120 },\n  },\n};\nexport default function Modal(props) {\n  const { show, onHide, title, members, info, image, layoutId } = props;\n  return (\n    <motion.div\n      className=\"backdrop\"\n      variants={backdrop}\n      initial=\"hidden\"\n      animate=\"visible\"\n      exit=\"hidden\"\n      layoutId={layoutId}\n    >\n      <motion.div className=\"custom-modal\" variants={modal}>\n        <ModalDialog className=\"custom-modal\" scrollable centered size=\"lg\">\n          <ModalHeader className=\"modal-title\">\n            <ModalTitle>{title}</ModalTitle>\n          </ModalHeader>\n          <Image className=\"modal-image\" height=\"280px\" width=\"80%\" src={image}></Image>\n          <ModalBody className=\"modal-details\">\n            <Accordion className=\"\" defaultActiveKey=\"0\">\n              <Card style={{ background: '#6D4DFF', color: 'white', border:\"none\" }}>\n                <Accordion.Toggle\n                  as={Card.Header}\n                  style={{ padding: '0.5rem 1.25rem' }}\n                  eventKey=\"0\"\n                >\n                  Members\n                </Accordion.Toggle>\n                <Accordion.Collapse eventKey=\"0\">\n                  <div className=\"modal-members\">\n                    {members.map((member) => {\n                      return (\n                        <div>\n                          <Image\n                            width={64}\n                            height={64}\n                            src=\"https://www.fg-a.com/wallpapers/white-marble-1-2018.jpg\"\n                            roundedCircle\n                          />\n                          <p>{member}</p>\n                        </div>\n                      );\n                    })}\n                  </div>\n                </Accordion.Collapse>\n              </Card>\n            </Accordion>\n            <p className=\"modal-info\">\n              {info}\n              Lorem, ipsum dolor sit amet consectetur adipisicing elit. Non rerum quae harum est\n              quasi ratione! Quam, laudantium suscipit nulla iste distinctio dicta dolores beatae\n              odit eaque nesciunt eveniet, perspiciatis maiores?\n            </p>\n          </ModalBody>\n          <ModalFooter className=\"custom-modal-footer\">\n            <Button\n              variant=\"primary\"\n              onClick={() => {\n                onHide();\n              }}\n            >\n              Close\n            </Button>\n          </ModalFooter>\n        </ModalDialog>\n      </motion.div>\n    </motion.div>\n  );\n}\n","D:\\site-vfinal\\src\\home\\Animation\\Animation.jsx",["95","96","97"],"D:\\site-vfinal\\src\\home\\Team\\Team.jsx",["98"],"import React from 'react'\r\nimport { Image,Container,Button } from 'react-bootstrap'\r\nimport './Team.css'\r\nexport default function Team() {\r\n    return (\r\n        <Container className=\"text-center\" id=\"team-container\">\r\n            <h1 className=\"home-team-title\">Our Team</h1>\r\n            <Image src=\"images/team.jpg\" fluid></Image>\r\n            <hr />\r\n            <button id=\"view-team-btn\" onClick={() => {\r\n                window.location.href = \"/members\";\r\n            }}>View All Members</button>\r\n            <hr />\r\n        </Container>\r\n    )\r\n}\r\n","D:\\site-vfinal\\src\\home\\Team\\CoreMembers\\Members.jsx",["99","100"],"import GitHub from '@material-ui/icons/GitHub';\r\nimport Language from '@material-ui/icons/Language';\r\nimport LinkedIn from '@material-ui/icons/LinkedIn';\r\nimport Card from \"@material-ui/core/Card\";\r\nimport CardContent from \"@material-ui/core/CardContent\";\r\nimport Typography from \"@material-ui/core/Typography\";\r\nimport CardActionArea from \"@material-ui/core/CardActionArea\";\r\nimport CardActions from \"@material-ui/core/CardActions\";\r\nimport CardMedia from \"@material-ui/core/CardMedia\";\r\nimport IconButton from \"@material-ui/core/IconButton\";\r\nimport React, { useEffect, useState } from 'react'\r\nimport { Container,Row,Col,Button } from 'react-bootstrap'\r\nimport MemData from './coreMembersData.json';\r\nimport './Members.css';\r\nexport default function Members() {\r\n    const [data, setData] = useState([]);\r\n    useEffect(() => {\r\n        setData(MemData);\r\n    }, [])\r\n    return (\r\n        <div>\r\n            <Container id=\"home-core-container\" className=\"text-center\">\r\n               <h1 className=\"home-core-team-title\">Core Members</h1>\r\n               <Row>\r\n                    {data.map((members, index) => {\r\n                        return (\r\n                            <Col md md={4} key={index} style={{margin:\"auto\"}}>\r\n                                <Card className=\"member_card\" style={{ maxWidth: 300 }}>\r\n                                    <CardActionArea>\r\n                                        <CardMedia\r\n                                            component=\"img\"\r\n                                            alt={members.Role}\r\n                                            height=\"270\"\r\n                                            image={members.Photo}\r\n                                            title={members.Role}\r\n                                        />\r\n                                        <CardContent className=\"member_card_content\">\r\n                                            <Typography gutterBottom variant=\"h5\" component=\"h2\">\r\n                                                {members.Name}\r\n                                            </Typography>\r\n                                            <Typography variant=\"h6\" color=\"textSecondary\">\r\n                                                {members.Role}\r\n                                            </Typography>\r\n                                        </CardContent>\r\n\r\n                                        <CardActions\r\n                                            style={{ marginLeft: \"20%\" }}\r\n                                        >\r\n                                            <IconButton\r\n                                                className=\"link_btn\"\r\n                                                aria-label=\"personalSite\"\r\n                                                href={members.Website}\r\n                                            >\r\n                                                <Language></Language>\r\n                                            </IconButton>\r\n                                            <IconButton aria-label=\"linkedIn\" href={members.LinkedIn} className=\"link_btn\">\r\n                                                <LinkedIn></LinkedIn>\r\n                                            </IconButton>\r\n                                            <IconButton aria-label=\"gitHubLink\" href={members.Github} className=\"link_btn\">\r\n                                                <GitHub></GitHub>\r\n                                            </IconButton>\r\n                                        </CardActions>\r\n                                    </CardActionArea>\r\n                                </Card>\r\n                                <br />\r\n                            </Col>\r\n                        )\r\n                    })}\r\n               </Row>\r\n            </Container> \r\n        </div>\r\n    )\r\n}\r\n","D:\\site-vfinal\\src\\Footer\\footer-overall.jsx",[],"D:\\site-vfinal\\src\\Footer\\footer-bottom.jsx",[],"D:\\site-vfinal\\src\\Footer\\footer-maps.jsx",[],{"ruleId":"101","severity":1,"message":"102","line":5,"column":24,"nodeType":"103","messageId":"104","endLine":5,"endColumn":25,"suggestions":"105"},{"ruleId":"101","severity":1,"message":"102","line":5,"column":30,"nodeType":"103","messageId":"104","endLine":5,"endColumn":31,"suggestions":"106"},{"ruleId":"107","replacedBy":"108"},{"ruleId":"109","replacedBy":"110"},{"ruleId":"111","severity":1,"message":"112","line":13,"column":9,"nodeType":"113","messageId":"114","endLine":13,"endColumn":13},{"ruleId":"115","severity":1,"message":"116","line":115,"column":61,"nodeType":"117","messageId":"118","endLine":115,"endColumn":63},{"ruleId":"111","severity":1,"message":"119","line":2,"column":31,"nodeType":"113","messageId":"114","endLine":2,"endColumn":36},{"ruleId":"115","severity":1,"message":"116","line":42,"column":23,"nodeType":"117","messageId":"118","endLine":42,"endColumn":25},{"ruleId":"111","severity":1,"message":"120","line":1,"column":17,"nodeType":"113","messageId":"114","endLine":1,"endColumn":26},{"ruleId":"111","severity":1,"message":"121","line":6,"column":8,"nodeType":"113","messageId":"114","endLine":6,"endColumn":13},{"ruleId":"115","severity":1,"message":"116","line":53,"column":23,"nodeType":"117","messageId":"118","endLine":53,"endColumn":25},{"ruleId":"111","severity":1,"message":"122","line":2,"column":18,"nodeType":"113","messageId":"114","endLine":2,"endColumn":33},{"ru