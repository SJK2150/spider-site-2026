= async () => {\r\n  //   try {\r\n  //     const data = await blogs();\r\n  //     if (data.status >= 400) {\r\n  //       console.log('error:', data.statusText);\r\n  //       // console.log(data.data.message)\r\n  //       return;\r\n  //     }\r\n  //     console.log(data);\r\n  //   } catch (error) {\r\n  //     console.log(error);\r\n  //   }\r\n  // };\r\n  useEffect(() => {\r\n    // getBlogs();\r\n    test();\r\n  }, []);\r\n  return (\r\n    <Router>\r\n      <div className=\"App\">\r\n        <NavBar />\r\n        <Switch>\r\n          <Route path=\"/projects\">\r\n            <Projects></Projects>\r\n          </Route>\r\n          <Route path=\"/achievements\">\r\n            <Achievements></Achievements>\r\n          </Route>\r\n          <Route exact path=\"/blogs\">\r\n            <Blog />\r\n          </Route>\r\n          <Route exact path=\"/members\">\r\n            <Members />\r\n          </Route>\r\n          {/* <Route exact path=\"/admin\">\r\n            <Admin></Admin>\r\n          </Route> */}\r\n          <Route path=\"/\">\r\n            <Home></Home>\r\n          </Route>\r\n        </Switch>\r\n        {/* {window.location.pathname !== '/' ? <FooterBar></FooterBar> : <></>} */}\r\n      </div>\r\n    </Router>\r\n  );\r\n}\r\nexport default App;\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\reportWebVitals.js",[],"C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\members\\Members.jsx",["272","273"],"import { React, useState } from 'react';\r\nimport { motion, AnimatePresence } from 'framer-motion';\r\nimport { Container, Nav } from 'react-bootstrap';\r\nimport Card from 'react-bootstrap/Card';\r\nimport CardColumns from 'react-bootstrap/CardColumns';\r\nimport { BrowserRouter as Router } from 'react-router-dom';\r\nimport LinkedInIcon from '@material-ui/icons/LinkedIn';\r\nimport LanguageIcon from '@material-ui/icons/Language';\r\nimport GitHubIcon from '@material-ui/icons/GitHub';\r\nimport IconButton from '@material-ui/core/IconButton';\r\nimport { members } from './All_members';\r\nimport './members.css';\r\n\r\nconst container = {\r\n  hidden: { opacity: 1, scale: 0 },\r\n  visible: {\r\n    opacity: 1,\r\n    scale: 1,\r\n    transition: {\r\n      delayChildren: 0.1,\r\n      staggerChildren: 0.1,\r\n    },\r\n  },\r\n};\r\n\r\nconst item = {\r\n  hidden: {\r\n    scale: 0,\r\n    opacity: 0,\r\n    transition: { type: 'tween', duration: 0.8 },\r\n  },\r\n  visible: {\r\n    scale: 1,\r\n    opacity: 1,\r\n    transition: { type: 'tween', duration: 0.8 },\r\n  },\r\n};\r\n\r\nconst year = [\r\n  ['All', 'All'],\r\n  ['B Tech 4th year', '2020-21'],\r\n  ['B Tech 3rd Year', '2021-22'],\r\n  ['B Tech 2nd Year', '2022-23'],\r\n  ['MCA 2nd year', 'MCA'],\r\n];\r\n\r\nfunction Members() {\r\n  const [yearName, setYearName] = useState('All');\r\n  const [ProfileName, setProfileName] = useState('Hardware');\r\n  const [clickHardware, setClickHardware] = useState(false);\r\n  const [clickSoftware, setClickSoftware] = useState(false);\r\n  const [domain, setDomain] = useState([true, false]);\r\n\r\n  const handleClickHardware = () => {\r\n    setClickSoftware(false);\r\n    setClickHardware(!clickHardware);\r\n    setDomain([true, false]);\r\n    setProfileName('Hardware');\r\n  };\r\n\r\n  const handleClickSoftware = () => {\r\n    setClickHardware(false);\r\n    setClickSoftware(!clickSoftware);\r\n    setDomain([false, true]);\r\n    setProfileName('Software');\r\n  };\r\n\r\n  const subMenuAnimate = {\r\n    enter: (i) => ({\r\n      opacity: 1,\r\n      transition: {\r\n        duration: i * 0.8,\r\n      },\r\n      display: 'block',\r\n    }),\r\n    exit: {\r\n      opacity: 0,\r\n      transition: {\r\n        duration: 2,\r\n      },\r\n      // display: \"none\"\r\n    },\r\n  };\r\n\r\n  const displayYearNav = (index) => {\r\n    const domainCond = [clickHardware, clickSoftware];\r\n    if (domainCond[index]) {\r\n      return (\r\n        <Nav variant=\"tabs\" defaultActiveKey=\"All\" style={{ justifyContent: 'space-between' }}>\r\n          {year.map((item, idx) => {\r\n            if (index === 0 && idx === 4) {\r\n              return <></>;\r\n            }\r\n            return (\r\n              <motion.div\r\n                initial=\"exit\"\r\n                animate={domainCond[index] ? 'enter' : 'exit'}\r\n                variants={subMenuAnimate}\r\n                custom={idx}\r\n                key={idx}\r\n              >\r\n                <Nav.Item className=\"batch_item\">\r\n                  <Nav.Link onClick={(e) => handleYearClick(e, item[0])} eventKey={item[1]}>\r\n                    {item[1]}\r\n                  </Nav.Link>\r\n                </Nav.Item>\r\n              </motion.div>\r\n            );\r\n          })}\r\n        </Nav>\r\n      );\r\n    } else {\r\n      return <></>;\r\n    }\r\n  };\r\n\r\n  const handleYearClick = (e, yr) => {\r\n    setYearName(yr);\r\n  };\r\n  // console.log(yearName, ProfileName)\r\n\r\n  return (\r\n    <Container className=\"container\">\r\n      <Router>\r\n        <h1\r\n          style={{\r\n            color: 'white',\r\n            textAlign: 'center',\r\n            padding: 15,\r\n            fontSize: 55,\r\n            fontWeight: 600,\r\n          }}\r\n        >\r\n          Members\r\n        </h1>\r\n        <br />\r\n        <>\r\n          <nav className=\"navbar\">\r\n            <motion.div className=\"menu-item \">\r\n              <button onClick={handleClickHardware} className=\"HardwareIcon btn shadow-none mx-5\">\r\n                <img src=\"images/hardware.png\" />\r\n              </button>\r\n            </motion.div>\r\n            <motion.div className=\"menu-item\">\r\n              <button onClick={handleClickSoftware} className=\"SoftwareIcon btn shadow-none mx-5\">\r\n                <img src=\"images/software.png\" />\r\n              </button>\r\n            </motion.div>\r\n          </nav>\r\n          {displayYearNav(domain.findIndex((e) => e === true))}\r\n        </>\r\n        <AnimatePresence initial={true}>\r\n          <motion.div\r\n            variants={container}\r\n            initial=\"hidden\"\r\n            animate=\"visible\"\r\n            style={{ display: 'flex', justifyContent: 'space-around', padding: 30 }}\r\n          >\r\n            <CardColumns>\r\n              <Container fluid=\"lg\">\r\n                {members\r\n                  .filter((member) => member.Profile === ProfileName)\r\n                  .filter((member) => member.Year === yearName)\r\n                  .map((member, id) => (\r\n                    <motion.div className=\"item\" variants={item} key={`member_${id}`}>\r\n                      <Card\r\n                        className=\"bg-dark text-white member_card\"\r\n                        style={{ margin: 20, background: '#141C3A' }}\r\n                      >\r\n                        <Card.Img src={member.Photo} alt={member.Name} />\r\n                        <Card.Title\r\n                          className=\"member_name\"\r\n                          style={{ background: '#141C3A', textAlign: 'center' }}\r\n                        >\r\n                          {member.Name}\r\n                        </Card.Title>\r\n                        <Card.Body style={{ background: '#141C3A' }}>\r\n                          <Card.Text style={{ background: '#141C3A' }} className=\"iconLinks\">\r\n                            {member.LinkedIn ? (\r\n                              <a href={member.LinkedIn}>\r\n                                <IconButton>\r\n                                  <LinkedInIcon fontSize=\"large\" className=\"buttonlinkedInIcon\" />\r\n                                </IconButton>\r\n                              </a>\r\n                            ) : (\r\n                              <IconButton>\r\n                                <LinkedInIcon fontSize=\"large\" className=\"buttonlinkedInIcon\" />\r\n                              </IconButton>\r\n                            )}\r\n                            {member.Website ? (\r\n                              <a href={member.Website}>\r\n                                <IconButton>\r\n                                  <LanguageIcon className=\"buttonwebIcon\" fontSize=\"large\" />\r\n                                </IconButton>\r\n                              </a>\r\n                            ) : (\r\n                              <IconButton>\r\n                                <LanguageIcon className=\"buttonwebIcon\" fontSize=\"large\" />\r\n                              </IconButton>\r\n                            )}\r\n                            {member.Github ? (\r\n                              <a href={member.Github}>\r\n                                <IconButton>\r\n                                  <GitHubIcon className=\"buttongithubIcon\" fontSize=\"large\" />\r\n                                </IconButton>\r\n                              </a>\r\n                            ) : (\r\n                              <IconButton>\r\n                                <GitHubIcon className=\"buttongithubIcon\" fontSize=\"large\" />\r\n                              </IconButton>\r\n                            )}\r\n                          </Card.Text>\r\n                        </Card.Body>\r\n                      </Card>\r\n                      <br></br>\r\n                    </motion.div>\r\n                  ))}\r\n              </Container>\r\n            </CardColumns>\r\n          </motion.div>\r\n        </AnimatePresence>\r\n      </Router>\r\n    </Container>\r\n  );\r\n}\r\n\r\nexport default Members;\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\blogs\\Blog.jsx",["274","275"],"import React, {useState} from \"react\";\r\nimport CssBaseline from \"@material-ui/core/CssBaseline\";\r\nimport Grid from \"@material-ui/core/Grid\";\r\nimport Typography from \"@material-ui/core/Typography\";\r\nimport Container from \"@material-ui/core/Container\";\r\nimport Data from \"./blogInfo.json\";\r\nimport { motion, AnimatePresence} from \"framer-motion\";\r\nimport Card from 'react-bootstrap/Card';\r\nimport ExpandLessIcon from '@material-ui/icons/ExpandLess';\r\nimport ExpandMoreIcon from '@material-ui/icons/ExpandMore';\r\nimport LocalLibraryIcon from '@material-ui/icons/LocalLibrary';\r\nimport './blog.css';\r\nimport {Link} from 'react-bootstrap'\r\n\r\nlet data = JSON.stringify(Data);\r\nlet blogData = JSON.parse(data);\r\n\r\nfunction Album(props) {\r\n  const container = {\r\n    hidden: { rotate: 180, opacity:0 },\r\n    show: {\r\n      rotate: 0,\r\n      opacity:1,\r\n    }\r\n  };\r\n  // console.log(props.cardOpen)\r\n  return (\r\n    <div>\r\n      <motion.div \r\n      className=\"cardblock\"\r\n      variants={container}\r\n      initial=\"hidden\"\r\n      animate=\"show\"\r\n      whileHover={{\r\n        scale: 1.08,\r\n        transition: { duration: 0.25 },\r\n      }}\r\n      >\r\n      <Card.Text >\r\n      <motion.div >\r\n        <p className=\"heading\" style={{fontSize:20, paddingTop:20}}>\r\n          {props.blogTitle}\r\n        </p>\r\n        </motion.div>\r\n      </Card.Text>\r\n      <Card.Body style={{paddingBottom:45}}>\r\n        <motion.div>\r\n        <Card.Img \r\n          src={props.imgsrc} \r\n          alt=\"Card image\"\r\n          className=\"cardMedia\" \r\n        />\r\n        </motion.div>\r\n      {props.cardOpen && \r\n        <AnimatePresence>\r\n        <motion.div\r\n        initial={{opacity:0}}\r\n        animate={{opacity:1, transition:2}}\r\n        >\r\n        <p className=\"desc\" gutterbottom>\r\n          {props.blogDescription}\r\n        </p>\r\n         <a href={props.blogLink}\r\n          style={{color:\"gray\", textDecoration:\"none\", fontSize:17, fontFamily:\"calibri\", fontSmooth: \"auto\", cursor:\"pointer\", display:\"flex\", justifyContent:\"center\"}}>\r\n            <LocalLibraryIcon style={{marginRight:7}}/>Read blog\r\n        </a>\r\n        </motion.div>\r\n      </AnimatePresence> \r\n    }\r\n     {(props.cardOpen) ?\r\n      <div onClick={props.isOpen} style={{float:\"right\", cursor:\"pointer\"}}>\r\n        <ExpandLessIcon style={{fontSize:40, color:\"#909090\"}}/>\r\n    </div> : (\r\n      <div onClick={props.isOpen} style={{float:\"right\", cursor:\"pointer\"}}>\r\n        <ExpandMoreIcon style={{fontSize:40, color:\"\t#909090\"}}/>\r\n    </div>\r\n    )}\r\n    </Card.Body>\r\n    </motion.div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default function ProjectItems() {\r\n  const [cardOpen, setCardOpen]= useState(false);\r\n  return (\r\n    <React.Fragment>\r\n      <CssBaseline />\r\n      <main>\r\n        <div className=\"heroContent\">\r\n          <Container maxWidth=\"lg\">\r\n            <Typography \r\n              variant=\"h2\"\r\n              align=\"center\"\r\n              color=\"whitesmoke\"\r\n              style={{marginBottom:20, fontSize:70, fontFamily:\"calibri\"}}\r\n              className=\"root\"\r\n              gutterBottom\r\n            >\r\n              Blogs\r\n            </Typography>\r\n          </Container>\r\n        </div>\r\n        <Container maxWidth=\"md\">\r\n        <Grid container spacing={4}>\r\n        {blogData.map(post => (\r\n              <Grid item xs={12} sm={6} md={4}  key={post.id}>\r\n                <div>\r\n              <Album\r\n                  blogId={post.id}\r\n                  blogTitle={post.title}\r\n                  blogDescription={post.summary}\r\n                  imgsrc={post.image_link}\r\n                  blogLink={post.article_link}\r\n                  isOpen={()=>{setCardOpen(id => {if(post.id==id) return null; return post.id;})}}\r\n                  cardOpen={cardOpen===post.id}\r\n                />\r\n          </div>\r\n          </Grid>\r\n          ))}    \r\n          </Grid>      \r\n        </Container>\r\n      </main>\r\n    </React.Fragment>\r\n  );\r\n}","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\navbar\\navbar.js",[],"C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\home\\home.js",["276","277"],"import React from 'react';\r\nimport Desc from './desc/desc';\r\nimport './home.css';\r\nimport Animation from './Animation/Animation';\r\nimport Team from './Team/Team';\r\nimport Members from './Team/CoreMembers/Members';\r\nimport Footer from '../Footer/footer-overall';\r\nimport SpiderLogo from '../assets/SpiderLogo.svg';\r\nfunction Home() {\r\n  return (\r\n    <div id=\"home-page\" style={{ overflowX: 'hidden' }}>\r\n      {/* <img src={SpiderLogo} className=\"home-spiderLogo-img\" /> */}\r\n      <Animation />\r\n      <Desc />\r\n      {/* <Team></Team> */}\r\n      <Members></Members>\r\n      <Footer></Footer>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Home;\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\api\\test.js",["278","279","280","281"],"import { deleteMember, getAllBlogsDetails, getBlogDetailsById, login } from './requests';\r\n\r\nconst test = () => {\r\n  //   getAllBlogsDetails();\r\n  //   getBlogDetailsById(1);\r\n  // login({\r\n  //   username: 'user',\r\n  //   password: 'password',\r\n  // });\r\n  // deleteMember(2);\r\n};\r\n\r\nexport { test };\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\blogs\\blogs.jsx",["282","283","284"],"import React, { useEffect, useState } from 'react'\r\nimport { Container, Row, Col, Card, Button } from 'react-bootstrap';\r\nimport Typography from \"@material-ui/core/Typography\";\r\nimport './blog.css';\r\n// import data from './blogInfo.json'\r\n\r\nimport { Link } from 'react-router-dom';\r\nimport { getAllBlogsDetails } from '../api/requests';\r\nimport FooterBar from '../Footer/footer-bottom';\r\nexport default function Blog() {\r\n    const [data,setData] = useState([]);\r\n    const fetchData = async ()=>{\r\n        const res = await getAllBlogsDetails();\r\n        console.log(res);\r\n        setData(res);\r\n    }\r\n    useEffect(() => {\r\n      fetchData()\r\n    }, [])\r\n    \r\n    return (\r\n        <div id=\"blogs-page\">\r\n            <Container>\r\n                {/* <Typography variant=\"h1\" style={{fontFamily:\"Product Sans\"}} className=\"text-center text-white\" component=\"div\" gutterBottom>\r\n                    Blogs\r\n                </Typography> */}\r\n                <div className=\"display-3 blogs_header\" style={{ fontFamily: \"Product Sans\" }}>BLOGS</div>\r\n            </Container>\r\n            <Container fluid=\"md\">\r\n                <Container style={{maxWidth:\"1300px\"}}>\r\n                    <Row className=\"my-3\">\r\n                        {data.map((ele, id) => {\r\n                            if (id % 2 == 0) {\r\n                                return (\r\n                                    <Col className=\"blog-col\" md={5}>\r\n                                        <Card className=\"text-white blog_card\" style={{ background: '#141C3A' }}>\r\n                                            <Card.Img className=\"blog_card_img\" variant=\"top\" src={ele.image_link} />\r\n                                            <Card.Body className=\"blog_card_body\">\r\n                                                <Card.Title as=\"h3\">{ele.title}</Card.Title>\r\n                                                <Card.Text as=\"h6\">\r\n                                                    {ele.summary}\r\n                                                </Card.Text>\r\n                                                <Button variant=\"primary\" href={ele.article_link} target=\"_blank\">\r\n                                                    Learn More\r\n                                                </Button>\r\n                                            </Card.Body>\r\n                                        </Card>\r\n                                        <br />\r\n                                    </Col>\r\n                                )\r\n                            }else{\r\n                                return (\r\n                                    <Col className=\"blog-col\" md={7}>\r\n                                        <Card className=\"text-white blog_card\" style={{ background: '#141C3A' }}>\r\n                                            <Card.Img className=\"blog_card_img\" variant=\"top\" src={ele.image_link} />\r\n                                            <Card.Body className=\"blog_card_body\">\r\n                                                <Card.Title as=\"h3\">{ele.title}</Card.Title>\r\n                                                <Card.Text as=\"h6\">\r\n                                                    {ele.summary}\r\n                                                </Card.Text>\r\n                                                <Button variant=\"primary\" href={ele.article_link} target=\"_blank\">\r\n                                                    Learn More\r\n                                                </Button>\r\n                                            </Card.Body>\r\n                                        </Card>\r\n                                        <br />\r\n                                    </Col>\r\n                                )\r\n                            }\r\n                        })}\r\n                    </Row>\r\n                </Container>\r\n            </Container>\r\n            <FooterBar />\r\n        </div>\r\n    )\r\n}\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\Projects\\Projects.jsx",["285","286","287","288"],"import React, { useEffect } from 'react';\r\nimport { Container, Row, Col, Image, Card, Button } from 'react-bootstrap';\r\nimport { Typography } from '@material-ui/core';\r\nimport { motion, AnimateSharedLayout } from 'framer-motion';\r\nimport './Projects.css';\r\nimport Modal from '../Modal/Modal';\r\nimport Toolbar from '../DomainToolbar/Toolbar';\r\nimport axios from 'axios';\r\nimport FooterBar from '../Footer/footer-bottom';\r\n// import data from './data.json'\r\nimport { getAllProjectsDetails } from '../api/requests';\r\nexport default function Projects() {\r\n  const [modalShow, setModalShow] = React.useState(false);\r\n  const [props, setProps] = React.useState({});\r\n  const [data, setData] = React.useState([]);\r\n  const [domain,setDomain] = React.useState([].fill(false,0,4));\r\n  const [modalCondn, setModalCondn] = React.useState([].fill(false, 0, data.length));\r\n  const [displayAll,setDisplayAll] = React.useState(true);\r\n  const [domainMap,setDomainMap] = React.useState({\r\n    \"TRONIX\":0,\r\n    \"WEBDEV\":1,\r\n    \"ALGOS\":2,\r\n    \"APPDEV\":3\r\n  });\r\n  useEffect(() => {\r\n    fetchData();\r\n    let arr = [];\r\n    for(let i=0;i<4;i++){\r\n      arr.push(false);\r\n    }\r\n    setDomain([...arr]);\r\n  }, []);\r\n  useEffect(()=>{\r\n    let val = domain[0];\r\n    for(let i=1;i<domain.length;i++){\r\n      val = val || domain[i];\r\n    }\r\n    if(val){\r\n      setDisplayAll(false);\r\n    }else{\r\n      setDisplayAll(true);\r\n    }\r\n  },[domain])\r\n\r\n  const fetchData = async()=>{\r\n    const res = await getAllProjectsDetails();\r\n    console.log(res);\r\n    setData(res);\r\n  }\r\n\r\n  const displayContent = (ele,id)=>{\r\n    if (id % 2 == 0) {\r\n      return (\r\n        <Col className=\"proj-col\" md={5}>\r\n          <AnimateSharedLayout>\r\n            {modalShow && modalCondn[id] ? (\r\n              createModal()\r\n            ) : (\r\n              <motion.div className=\"motion-card\" layoutId={`expandable-card-${id + 1}`}>\r\n                <Card\r\n                  style={{ background: '#141C3A' }}\r\n                  className=\"text-white project-card\"\r\n                >\r\n                  <div className='proj-image-bg'>\r\n                      <Card.Img\r\n                        className=\"project-image\"\r\n                        variant=\"top\"\r\n                        src={ele.project_photo_url}\r\n                      />\r\n                  </div>\r\n                  <Card.Body className=\"text-center project-body\">\r\n                    <motion.div>\r\n                      <Card.Title className=\"project-title\">{ele.name}</Card.Title>\r\n                    </motion.div>\r\n                    <motion.div whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }}>\r\n                      <Button\r\n                        variant=\"outline-light\"\r\n                        onClick={() => {\r\n                          modalDisplay(\r\n                            ele.name,\r\n                            ele.Members,\r\n                            ele.desc,\r\n                            ele.project_photo_url,\r\n                            `expandable-card-${id + 1}`,\r\n                            `${id + 1}`,\r\n                          );\r\n                        }}\r\n                      >\r\n                        Learn More\r\n                      </Button>\r\n                    </motion.div>\r\n                  </Card.Body>\r\n                </Card>\r\n              </motion.div>\r\n            )}\r\n          </AnimateSharedLayout>\r\n        </Col>\r\n      )\r\n    } else {\r\n      return (\r\n        <Col md={7} className=\"proj-col\">\r\n          <AnimateSharedLayout>\r\n            {modalShow && modalCondn[id] ? (\r\n              createModal()\r\n            ) : (\r\n              <motion.div className=\"motion-card\" layoutId={`expandable-card-${id + 1}`}>\r\n                <Card\r\n                  style={{ background: '#141C3A' }}\r\n                  className=\"text-white project-card\"\r\n                >\r\n                  <div className='proj-image-bg'>\r\n                    <Card.Img\r\n                      className=\"project-image\"\r\n                      variant=\"top\"\r\n                      src={ele.project_photo_url}\r\n                    />\r\n                  </div>\r\n                  <Card.Body className=\"text-center project-body\">\r\n                    <motion.div>\r\n                      <Card.Title className=\"project-title\">{ele.name}</Card.Title>\r\n                    </motion.div>\r\n                    <motion.div whileHover={{ scale: 1.1 }}>\r\n                      <Button\r\n                        variant=\"outline-light\"\r\n                        onClick={() => {\r\n                          modalDisplay(\r\n                            ele.name,\r\n                            ele.Members,\r\n                            ele.desc,\r\n                            ele.project_photo_url,\r\n                            `expandable-card-${id + 1}`,\r\n                            `${id + 1}`,\r\n                          );\r\n                        }}\r\n                      >\r\n                        Learn More\r\n                      </Button>\r\n                    </motion.div>\r\n                  </Card.Body>\r\n                </Card>\r\n              </motion.div>\r\n            )}\r\n          </AnimateSharedLayout>\r\n        </Col>\r\n      )\r\n    }\r\n  }\r\n\r\n  const modalDisplay = (title, members, info, image, layoutId, key) => {\r\n    let mem = members;\r\n    let newMemberList = [];\r\n    for(let i=0;i<mem.length;i++){\r\n      newMemberList.push([ mem[i].name, mem[i].photo_url ]);\r\n    }\r\n    setProps({\r\n      title: title,\r\n      members: newMemberList,\r\n      info: info,\r\n      image: image,\r\n      layoutId: layoutId,\r\n    });\r\n    setModalShow(true);\r\n    let newArr = [...modalCondn];\r\n    // console.log(key);\r\n    newArr.fill(false, 0, 4);\r\n    newArr[Number(key) - 1] = true;\r\n    setModalCondn(newArr);\r\n  };\r\n  const createModal = () => {\r\n    return <Modal {...props} show={modalShow} onHide={() => setModalShow(false)}></Modal>;\r\n  };\r\n  return (\r\n    <div id=\"projects-page\">\r\n      <Typography className='project-header' variant='h2' align='center'>PROJECTS</Typography>\r\n      <div className=\"domains\">\r\n        <Toolbar setDomain={setDomain} domain={domain}></Toolbar>\r\n      </div>\r\n      <Container fluid=\"md\">\r\n        <Container fluid>\r\n          <Row className=\"my-3\">\r\n            {displayAll ? data.map((ele, id) => {\r\n              return displayContent(ele,id);\r\n            }):data.filter(e=>{\r\n              return domain[domainMap[e.domain]];\r\n            }).map((ele,id)=>{\r\n              return displayContent(ele,id);\r\n            })}\r\n          </Row>\r\n        </Container>\r\n      </Container>\r\n      <FooterBar />\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\Footer\\footer-bottom.jsx",["289","290","291","292"],"import React from 'react';\r\nimport './footer-bottom.css';\r\n\r\nexport default function FooterBar() {\r\n  return (\r\n    <footer className=\"footer-bottom\">\r\n      <p>Weaved with 🕸 by Spider</p>\r\n      <div className=\"footer-bottom-links\">\r\n        <a\r\n          href=\"https://www.facebook.com/SpiderNitt/\"\r\n          rel=\"noopener noreferrer\"\r\n          target=\"_blank\"\r\n          className=\"fa fa-facebook\"\r\n        ></a>\r\n        <a\r\n          href=\"https://www.instagram.com/spider_nitt/\"\r\n          rel=\"noopener noreferrer\"\r\n          target=\"_blank\"\r\n          className=\"fa fa-instagram\"\r\n        ></a>\r\n        <a\r\n          href=\"https://www.linkedin.com/company/spider-r-d/\"\r\n          rel=\"noopener noreferrer\"\r\n          target=\"_blank\"\r\n          className=\"fa fa-linkedin\"\r\n        ></a>\r\n        <a\r\n          href=\"https://medium.com/spidernitt\"\r\n          rel=\"noopener noreferrer\"\r\n          target=\"_blank\"\r\n          className=\"fa fa-medium\"\r\n        ></a>\r\n      </div>\r\n      <br />\r\n    </footer>\r\n  );\r\n}\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\Achievements\\Achievements.jsx",["293","294","295"],"import React , {useEffect} from 'react';\r\nimport { Container, Row, Col, Image, Card, Button } from 'react-bootstrap';\r\nimport { motion, AnimateSharedLayout } from 'framer-motion';\r\nimport './Achievements.css';\r\nimport Modal from '../Modal/Modal';\r\nimport FooterBar from '../Footer/footer-bottom';\r\n\r\n// import data from './data.json';\r\n\r\nimport Toolbar from '../DomainToolbar/Toolbar';\r\nimport { getAllAchievementDetails } from '../api/requests';\r\nexport default function Achievements() {\r\n  const [modalShow, setModalShow] = React.useState(false);\r\n  const [props, setProps] = React.useState({});\r\n  const [data,setData] = React.useState([]);\r\n  const [domain, setDomain] = React.useState([].fill(false, 0, 4));\r\n  const [modalCondn, setModalCondn] = React.useState([].fill(false, 0, 4));\r\n  const [displayAll, setDisplayAll] = React.useState(true);\r\n  const [domainMap, setDomainMap] = React.useState({\r\n    \"TRONIX\": 0,\r\n    \"WEBDEV\": 1,\r\n    \"ALGOS\": 2,\r\n    \"APPDEV\": 3\r\n  });\r\n  useEffect(() => {\r\n    let arr = [];\r\n    for (let i = 0; i < 4; i++) {\r\n      arr.push(false);\r\n    }\r\n    setDomain([...arr]);\r\n    fetchData();\r\n  }, []);\r\n  useEffect(() => {\r\n    // console.log(domain);\r\n    let val = domain[0];\r\n    for (let i = 1; i < domain.length; i++) {\r\n      val = val || domain[i];\r\n    }\r\n    if (val) {\r\n      setDisplayAll(false);\r\n    } else {\r\n      setDisplayAll(true);\r\n    }\r\n  }, [domain])\r\n\r\n  const fetchData = async ()=>{\r\n    const res = await getAllAchievementDetails();\r\n    console.log(res);\r\n    setData(res);\r\n  }\r\n\r\n  const displayContent = (ele,id)=>{\r\n    if (id % 2 == 0) {\r\n      return (\r\n        <Col className=\"my-3\" md={5}>\r\n          <AnimateSharedLayout>\r\n            {modalShow && modalCondn[id] ? (\r\n              createModal()\r\n            ) : (\r\n              <motion.div className=\"motion-card\" layoutId={`expandable-card-${id + 1}`}>\r\n                <Card\r\n                  style={{ background: '#141C3A' }}\r\n                  className=\"text-white achv-card\"\r\n                >\r\n                  <div className=\"achv-image-bg\">\r\n                    <Card.Img\r\n                    className=\"achv-image\"\r\n                    variant=\"top\"\r\n                    src={ele.achievement_photo_url}\r\n                  />\r\n                  </div>\r\n                  \r\n                  <Card.Body className=\"text-center achv-body\">\r\n                    <motion.div>\r\n                      <Card.Title className=\"achv-title\">{ele.name_of_event}</Card.Title>\r\n                    </motion.div>\r\n                    <motion.div whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }}>\r\n                      <Button\r\n                        variant=\"outline-light\"\r\n                        onClick={() => {\r\n                          modalDisplay(\r\n                            ele.name_of_event,\r\n                            ele.Members,\r\n                            ele.desc,\r\n                            ele.achievement_photo_url,\r\n                            `expandable-card-${id + 1}`,\r\n                            `${id + 1}`,\r\n                          );\r\n                        }}\r\n                      >\r\n                        Learn More\r\n                      </Button>\r\n                    </motion.div>\r\n                  </Card.Body>\r\n                </Card>\r\n              </motion.div>\r\n            )}\r\n          </AnimateSharedLayout>\r\n        </Col>\r\n      )\r\n    } else {\r\n      return (\r\n        <Col className=\"my-3\" md={7}>\r\n          <AnimateSharedLayout>\r\n            {modalShow && modalCondn[id] ? (\r\n              createModal()\r\n            ) : (\r\n              <motion.div className=\"motion-card\" layoutId={`expandable-card-${id + 1}`}>\r\n                <Card\r\n                  style={{ background: '#141C3A' }}\r\n                  className=\"text-white achv-card\"\r\n                >\r\n                  <div className=\"achv-image-bg\">\r\n                    <Card.Img\r\n                    className=\"achv-image\"\r\n                    variant=\"top\"\r\n                    src={ele.achievement_photo_url}\r\n                  />\r\n                  </div>\r\n                  <Card.Body className=\"text-center achv-body\">\r\n                    <motion.div>\r\n                      <Card.Title className=\"achv-title\">{ele.name_of_event}</Card.Title>\r\n                    </motion.div>\r\n                    <motion.div whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }}>\r\n                      <Button\r\n                        variant=\"outline-light\"\r\n                        onClick={() => {\r\n                          modalDisplay(\r\n                            ele.name_of_event,\r\n                            ele.Members,\r\n                            ele.desc,\r\n                            ele.achievement_photo_url,\r\n                            `expandable-card-${id + 1}`,\r\n                            `${id + 1}`,\r\n                          );\r\n                        }}\r\n                      >\r\n                        Learn More\r\n                      </Button>\r\n                    </motion.div>\r\n                  </Card.Body>\r\n                </Card>\r\n              </motion.div>\r\n            )}\r\n          </AnimateSharedLayout>\r\n        </Col>\r\n      )\r\n    }\r\n  }\r\n\r\n  const modalDisplay = (title, members, info, image, layoutId, key) => {\r\n    let mem = members;\r\n    let newMemberList = [];\r\n    for (let i = 0; i < mem.length; i++) {\r\n      newMemberList.push([mem[i].name, mem[i].photo_url]);\r\n    }\r\n    setProps({\r\n      title: title,\r\n      members: newMemberList,\r\n      info: info,\r\n      image: image,\r\n      layoutId: layoutId,\r\n    });\r\n    setModalShow(true);\r\n    let newArr = [...modalCondn];\r\n    newArr.fill(false, 0, 4);\r\n    newArr[Number(key) - 1] = true;\r\n    setModalCondn(newArr);\r\n  };\r\n  const createModal = () => {\r\n    return <Modal {...props} show={modalShow} onHide={() => setModalShow(false)}></Modal>;\r\n  };\r\n  return (\r\n    <div id=\"achv-page\">\r\n      <div className=\"achv-intro-section\">\r\n        {/* <Image\r\n          className=\"achv_banner\"\r\n          src=\"https://images.unsplash.com/photo-1488229297570-58520851e868?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=1049&q=80\"\r\n          fluid\r\n        ></Image> */}\r\n        <div className=\"display-3 achv_banner_title\">ACHIEVEMENTS</div>\r\n      </div>\r\n      <div className=\"domains\">\r\n      <Toolbar setDomain={setDomain} domain={domain}></Toolbar>\r\n      </div>\r\n      <Container fluid=\"md\">\r\n        <Container fluid>\r\n          <Row>\r\n            {displayAll?data.map((ele,id)=>{\r\n              return displayContent(ele,id);\r\n            }) : data.filter((ele) => {\r\n              return domain[domainMap[ele.domain]];\r\n            }).map((ele,idx)=>{\r\n              console.log(\"Clicked\");\r\n              return displayContent(ele,idx);\r\n            })}\r\n          </Row>\r\n        </Container>\r\n      </Container>\r\n      <FooterBar />\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\Admin\\Admin.jsx",["296","297"],"import React, { useState, useEffect } from 'react';\r\nimport {Row, Col, Container, ListGroup, Tab} from 'react-bootstrap';\r\nimport AdminProj from './AdminProj';\r\nfunction Admin() {\r\n    return ( \r\n    <div style={{height:\"100vh\",color:\"white\"}}>\r\n        <h1 className='text-center'>Admin Dashboard</h1>\r\n            <Container>\r\n                <Tab.Container id=\"list-group-tabs-example\" defaultActiveKey=\"#link1\">\r\n                    <Row>\r\n                        <Col sm={3}>\r\n                            <ListGroup>\r\n                                <ListGroup.Item action href=\"#link1\">\r\n                                    Project\r\n                                </ListGroup.Item>\r\n                                <ListGroup.Item action href=\"#link2\">\r\n                                    Achievement\r\n                                </ListGroup.Item>\r\n                                <ListGroup.Item action href=\"#link3\">\r\n                                    Blogs\r\n                                </ListGroup.Item>\r\n                                <ListGroup.Item action href=\"#link4\">\r\n                                    Members\r\n                                </ListGroup.Item>\r\n                            </ListGroup>\r\n                        </Col>\r\n                        <Col sm={9}>\r\n                            <Tab.Content>\r\n                                <Tab.Pane eventKey=\"#link1\">\r\n                                    <AdminProj></AdminProj>\r\n                                </Tab.Pane>\r\n                                <Tab.Pane eventKey=\"#link2\">\r\n                                    <div>Hello World</div>\r\n                                </Tab.Pane>\r\n                                <Tab.Pane eventKey=\"#link3\">\r\n                                    <div>Hello World</div>\r\n                                </Tab.Pane>\r\n                                <Tab.Pane eventKey=\"#link4\">\r\n                                    <div>Hello World</div>\r\n                                </Tab.Pane>\r\n                            </Tab.Content>\r\n                        </Col>\r\n                    </Row>\r\n                </Tab.Container>\r\n            </Container>\r\n    </div> \r\n    );\r\n}\r\n\r\nexport default Admin;","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\members\\All_memb