filePath":"93","messages":"94","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"55"},{"filePath":"95","messages":"96","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"97","usedDeprecatedRules":"55"},{"filePath":"98","messages":"99","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"100","usedDeprecatedRules":"55"},{"filePath":"101","messages":"102","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"103","messages":"104","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"105","usedDeprecatedRules":"55"},{"filePath":"106","messages":"107","errorCount":0,"warningCount":7,"fixableErrorCount":0,"fixableWarningCount":0,"source":"108","usedDeprecatedRules":"55"},{"filePath":"109","messages":"110","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"111","usedDeprecatedRules":"55"},{"filePath":"112","messages":"113","errorCount":0,"warningCount":13,"fixableErrorCount":0,"fixableWarningCount":0,"source":"114","usedDeprecatedRules":"55"},{"filePath":"115","messages":"116","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"55"},{"filePath":"117","messages":"118","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"55"},"C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\index.js",["119","120"],"import React from 'react';\r\nimport ReactDOM from 'react-dom';\r\nimport './index.css';\r\nimport App from './App';\r\nimport './fonts/Product\\ Sans\\ Regular.ttf'\r\nimport reportWebVitals from './reportWebVitals';\r\n\r\nReactDOM.render(\r\n  <React.StrictMode>\r\n    <App />\r\n  </React.StrictMode>,\r\n  document.getElementById('root')\r\n);\r\n\r\n// If you want to start measuring performance in your app, pass a function\r\n// to log results (for example: reportWebVitals(console.log))\r\n// or send to an analytics endpoint. Learn more: https://bit.ly/CRA-vitals\r\nreportWebVitals();",["121","122"],"C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\reportWebVitals.js",[],"C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\App.js",["123","124","125"],"import './App.css';\r\nimport Home from './home/home';\r\nimport NavBar from './navbar/navbar';\r\nimport Projects from './Projects/Projects';\r\nimport Members from './members/Members.jsx';\r\nimport ProjectItems from './blogs/Blog.jsx';\r\nimport Blog from './blogs/blogs';\r\nimport FooterBar from './Footer/footer-bottom';\r\nimport Achievements from './Achievements/Achievements';\r\nimport { BrowserRouter as Router, Route, Switch } from 'react-router-dom';\r\n// import { blogs } from './api/requests';\r\nimport { useEffect } from 'react';\r\nimport { test } from './api/test';\r\nimport Admin from './Admin/Admin';\r\n\r\nfunction App() {\r\n  // const getBlogs = async () => {\r\n  //   try {\r\n  //     const data = await blogs();\r\n  //     if (data.status >= 400) {\r\n  //       console.log('error:', data.statusText);\r\n  //       // console.log(data.data.message)\r\n  //       return;\r\n  //     }\r\n  //     console.log(data);\r\n  //   } catch (error) {\r\n  //     console.log(error);\r\n  //   }\r\n  // };\r\n  useEffect(() => {\r\n    // getBlogs();\r\n    test();\r\n  }, []);\r\n  return (\r\n    <Router>\r\n      <div className=\"App\">\r\n        <NavBar />\r\n        <Switch>\r\n          <Route path=\"/projects\">\r\n            <Projects></Projects>\r\n          </Route>\r\n          <Route path=\"/achievements\">\r\n            <Achievements></Achievements>\r\n          </Route>\r\n          <Route exact path=\"/blogs\">\r\n            <Blog />\r\n          </Route>\r\n          <Route exact path=\"/members\">\r\n            <Members />\r\n          </Route>\r\n          {/* <Route exact path=\"/admin\">\r\n            <Admin></Admin>\r\n          </Route> */}\r\n          <Route path=\"/\">\r\n            <Home></Home>\r\n          </Route>\r\n        </Switch>\r\n        {/* {window.location.pathname !== '/' ? <FooterBar></FooterBar> : <></>} */}\r\n      </div>\r\n    </Router>\r\n  );\r\n}\r\nexport default App;\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\blogs\\Blog.jsx",["126","127"],"import React, {useState} from \"react\";\r\nimport CssBaseline from \"@material-ui/core/CssBaseline\";\r\nimport Grid from \"@material-ui/core/Grid\";\r\nimport Typography from \"@material-ui/core/Typography\";\r\nimport Container from \"@material-ui/core/Container\";\r\nimport Data from \"./blogInfo.json\";\r\nimport { motion, AnimatePresence} from \"framer-motion\";\r\nimport Card from 'react-bootstrap/Card';\r\nimport ExpandLessIcon from '@material-ui/icons/ExpandLess';\r\nimport ExpandMoreIcon from '@material-ui/icons/ExpandMore';\r\nimport LocalLibraryIcon from '@material-ui/icons/LocalLibrary';\r\nimport './blog.css';\r\nimport {Link} from 'react-bootstrap'\r\n\r\nlet data = JSON.stringify(Data);\r\nlet blogData = JSON.parse(data);\r\n\r\nfunction Album(props) {\r\n  const container = {\r\n    hidden: { rotate: 180, opacity:0 },\r\n    show: {\r\n      rotate: 0,\r\n      opacity:1,\r\n    }\r\n  };\r\n  // console.log(props.cardOpen)\r\n  return (\r\n    <div>\r\n      <motion.div \r\n      className=\"cardblock\"\r\n      variants={container}\r\n      initial=\"hidden\"\r\n      animate=\"show\"\r\n      whileHover={{\r\n        scale: 1.08,\r\n        transition: { duration: 0.25 },\r\n      }}\r\n      >\r\n      <Card.Text >\r\n      <motion.div >\r\n        <p className=\"heading\" style={{fontSize:20, paddingTop:20}}>\r\n          {props.blogTitle}\r\n        </p>\r\n        </motion.div>\r\n      </Card.Text>\r\n      <Card.Body style={{paddingBottom:45}}>\r\n        <motion.div>\r\n        <Card.Img \r\n          src={props.imgsrc} \r\n          alt=\"Card image\"\r\n          className=\"cardMedia\" \r\n        />\r\n        </motion.div>\r\n      {props.cardOpen && \r\n        <AnimatePresence>\r\n        <motion.div\r\n        initial={{opacity:0}}\r\n        animate={{opacity:1, transition:2}}\r\n        >\r\n        <p className=\"desc\" gutterbottom>\r\n          {props.blogDescription}\r\n        </p>\r\n         <a href={props.blogLink}\r\n          style={{color:\"gray\", textDecoration:\"none\", fontSize:17, fontFamily:\"calibri\", fontSmooth: \"auto\", cursor:\"pointer\", display:\"flex\", justifyContent:\"center\"}}>\r\n            <LocalLibraryIcon style={{marginRight:7}}/>Read blog\r\n        </a>\r\n        </motion.div>\r\n      </AnimatePresence> \r\n    }\r\n     {(props.cardOpen) ?\r\n      <div onClick={props.isOpen} style={{float:\"right\", cursor:\"pointer\"}}>\r\n        <ExpandLessIcon style={{fontSize:40, color:\"#909090\"}}/>\r\n    </div> : (\r\n      <div onClick={props.isOpen} style={{float:\"right\", cursor:\"pointer\"}}>\r\n        <ExpandMoreIcon style={{fontSize:40, color:\"\t#909090\"}}/>\r\n    </div>\r\n    )}\r\n    </Card.Body>\r\n    </motion.div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default function ProjectItems() {\r\n  const [cardOpen, setCardOpen]= useState(false);\r\n  return (\r\n    <React.Fragment>\r\n      <CssBaseline />\r\n      <main>\r\n        <div className=\"heroContent\">\r\n          <Container maxWidth=\"lg\">\r\n            <Typography \r\n              variant=\"h2\"\r\n              align=\"center\"\r\n              color=\"whitesmoke\"\r\n              style={{marginBottom:20, fontSize:70, fontFamily:\"calibri\"}}\r\n              className=\"root\"\r\n              gutterBottom\r\n            >\r\n              Blogs\r\n            </Typography>\r\n          </Container>\r\n        </div>\r\n        <Container maxWidth=\"md\">\r\n        <Grid container spacing={4}>\r\n        {blogData.map(post => (\r\n              <Grid item xs={12} sm={6} md={4}  key={post.id}>\r\n                <div>\r\n              <Album\r\n                  blogId={post.id}\r\n                  blogTitle={post.title}\r\n                  blogDescription={post.summary}\r\n                  imgsrc={post.image_link}\r\n                  blogLink={post.article_link}\r\n                  isOpen={()=>{setCardOpen(id => {if(post.id==id) return null; return post.id;})}}\r\n                  cardOpen={cardOpen===post.id}\r\n                />\r\n          </div>\r\n          </Grid>\r\n          ))}    \r\n          </Grid>      \r\n        </Container>\r\n      </main>\r\n    </React.Fragment>\r\n  );\r\n}","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\members\\Members.jsx",["128","129","130","131","132","133"],"C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\home\\home.js",["134","135"],"import React from 'react';\r\nimport Desc from './desc/desc';\r\nimport './home.css';\r\nimport Animation from './Animation/Animation';\r\nimport Team from './Team/Team';\r\nimport Members from './Team/CoreMembers/Members';\r\nimport Footer from '../Footer/footer-overall';\r\nimport SpiderLogo from '../assets/SpiderLogo.svg';\r\nfunction Home() {\r\n  return (\r\n    <div id=\"home-page\" style={{ overflowX: 'hidden' }}>\r\n      {/* <img src={SpiderLogo} className=\"home-spiderLogo-img\" /> */}\r\n      <Animation />\r\n      <Desc />\r\n      {/* <Team></Team> */}\r\n      <Members></Members>\r\n      <Footer></Footer>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Home;\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\navbar\\navbar.js",[],"C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\api\\test.js",["136","137","138","139"],"import { deleteMember, getAllBlogsDetails, getBlogDetailsById, login } from './requests';\r\n\r\nconst test = () => {\r\n  //   getAllBlogsDetails();\r\n  //   getBlogDetailsById(1);\r\n  // login({\r\n  //   username: 'user',\r\n  //   password: 'password',\r\n  // });\r\n  // deleteMember(2);\r\n};\r\n\r\nexport { test };\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\Footer\\footer-bottom.jsx",["140","141","142","143"],"import React from 'react';\r\nimport './footer-bottom.css';\r\n\r\nexport default function FooterBar() {\r\n  return (\r\n    <footer className=\"footer-bottom\">\r\n      <p>Weaved with 🕸 by Spider</p>\r\n      <div className=\"footer-bottom-links\">\r\n        <a\r\n          href=\"https://www.facebook.com/SpiderNitt/\"\r\n          rel=\"noopener noreferrer\"\r\n          target=\"_blank\"\r\n          className=\"fa fa-facebook\"\r\n        ></a>\r\n        <a\r\n          href=\"https://www.instagram.com/spider_nitt/\"\r\n          rel=\"noopener noreferrer\"\r\n          target=\"_blank\"\r\n          className=\"fa fa-instagram\"\r\n        ></a>\r\n        <a\r\n          href=\"https://www.linkedin.com/company/spider-r-d/\"\r\n          rel=\"noopener noreferrer\"\r\n          target=\"_blank\"\r\n          className=\"fa fa-linkedin\"\r\n        ></a>\r\n        <a\r\n          href=\"https://medium.com/spidernitt\"\r\n          rel=\"noopener noreferrer\"\r\n          target=\"_blank\"\r\n          className=\"fa fa-medium\"\r\n        ></a>\r\n      </div>\r\n      <br />\r\n    </footer>\r\n  );\r\n}\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\Admin\\Admin.jsx",["144","145"],"import React, { useState, useEffect } from 'react';\r\nimport {Row, Col, Container, ListGroup, Tab} from 'react-bootstrap';\r\nimport AdminProj from './AdminProj';\r\nfunction Admin() {\r\n    return ( \r\n    <div style={{height:\"100vh\",color:\"white\"}}>\r\n        <h1 className='text-center'>Admin Dashboard</h1>\r\n            <Container>\r\n                <Tab.Container id=\"list-group-tabs-example\" defaultActiveKey=\"#link1\">\r\n                    <Row>\r\n                        <Col sm={3}>\r\n                            <ListGroup>\r\n                                <ListGroup.Item action href=\"#link1\">\r\n                                    Project\r\n                                </ListGroup.Item>\r\n                                <ListGroup.Item action href=\"#link2\">\r\n                                    Achievement\r\n                                </ListGroup.Item>\r\n                                <ListGroup.Item action href=\"#link3\">\r\n                                    Blogs\r\n                                </ListGroup.Item>\r\n                                <ListGroup.Item action href=\"#link4\">\r\n                                    Members\r\n                                </ListGroup.Item>\r\n                            </ListGroup>\r\n                        </Col>\r\n                        <Col sm={9}>\r\n                            <Tab.Content>\r\n                                <Tab.Pane eventKey=\"#link1\">\r\n                                    <AdminProj></AdminProj>\r\n                                </Tab.Pane>\r\n                                <Tab.Pane eventKey=\"#link2\">\r\n                                    <div>Hello World</div>\r\n                                </Tab.Pane>\r\n                                <Tab.Pane eventKey=\"#link3\">\r\n                                    <div>Hello World</div>\r\n                                </Tab.Pane>\r\n                                <Tab.Pane eventKey=\"#link4\">\r\n                                    <div>Hello World</div>\r\n                                </Tab.Pane>\r\n                            </Tab.Content>\r\n                        </Col>\r\n                    </Row>\r\n                </Tab.Container>\r\n            </Container>\r\n    </div> \r\n    );\r\n}\r\n\r\nexport default Admin;","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\blogs\\blogs.jsx",["146","147","148","149","150","151","152"],"import React, { useEffect, useState } from 'react'\r\nimport { Container, Row, Col, Card, Button } from 'react-bootstrap';\r\nimport Typography from \"@material-ui/core/Typography\";\r\nimport './blog.css';\r\n// import data from './blogInfo.json'\r\n\r\nimport { Link } from 'react-router-dom';\r\nimport { getAllBlogsDetails } from '../api/requests';\r\nimport FooterBar from '../Footer/footer-bottom';\r\nimport ErrorIcon from '@material-ui/icons/Error';\r\nimport CircularProgress from '@material-ui/core/CircularProgress';\r\nexport default function Blog() {\r\n    const [data,setData] = useState([]);\r\n    const [error, setError] = React.useState(false)\r\n    const [loading, setLoading] = React.useState(false)\r\n\r\n    const fetchData = async ()=>{\r\n        setLoading(true)\r\n        const res = await getAllBlogsDetails();\r\n        console.log(res);\r\n        if(res){\r\n            if(res.status && res.status == 500){\r\n              setError(true)\r\n            }\r\n            else{\r\n              setData(res);\r\n            }\r\n            setLoading(false)\r\n          }\r\n    }\r\n    useEffect(() => {\r\n      fetchData()\r\n    }, [])\r\n\r\n    useEffect(() => {\r\n        const timer = setTimeout(() => {\r\n          setData(data=>{\r\n            if(data.length == 0){\r\n              setLoading(false)\r\n              setError(true)\r\n            }\r\n            return data\r\n          })\r\n        }, 3000);\r\n        return () => clearTimeout(timer);\r\n      }, []);\r\n\r\n    return (\r\n        <div id=\"blogs-page\">\r\n            <div>\r\n                {/* <Typography variant=\"h1\" style={{fontFamily:\"Product Sans\"}} className=\"text-center text-white\" component=\"div\" gutterBottom>\r\n                    Blogs\r\n                </Typography> */}\r\n                <div className=\"display-3 blogs_header\">BLOGS</div>\r\n            </div>\r\n            <Container fluid=\"md\">\r\n                <Container style={{maxWidth:\"1300px\"}}>\r\n                    <Row className=\"my-3 blogs-display-cards\">\r\n                    {loading==true? <div className='blog-error-div' ><CircularProgress className='blog-error-icon'/></div>:<>\r\n                        {error==false ? data.map((ele, id) => {\r\n                            if (id % 2 == 0) {\r\n                                return (\r\n                                    <Col className=\"blog-col\" md={5}>\r\n                                        <Card className=\"text-white blog_card\"  style={{background:'none'}} >\r\n                                            <Card.Img className=\"blog_card_img\" variant=\"top\" src={ele.image_link} />\r\n                                            <Card.Body className=\"blog_card_body\">\r\n                                                <Card.Title as=\"h3\" style={{ fontFamily: 'MontserratBold'}} className='blog-title'>{ele.title}</Card.Title>\r\n                                                <Card.Text as=\"h6\" className='blog-desc'>\r\n                                                    {ele.summary}\r\n                                                </Card.Text>\r\n                                                <div className='blog-card-btn-div'>\r\n                                                    <Button className='blog-card-btn' href={ele.article_link} target=\"_blank\">\r\n                                                        Learn More\r\n                                                    </Button>\r\n                                                </div>\r\n                                            </Card.Body>\r\n                                        </Card>\r\n                                        <br />\r\n                                    </Col>\r\n                                )\r\n                            }else{\r\n                                return (\r\n                                    <Col className=\"blog-col\" md={5}>\r\n                                        <Card className=\"text-white blog_card\" style={{background:'none'}}>\r\n                                            <Card.Img className=\"blog_card_img\" variant=\"top\" src={ele.image_link} />\r\n                                            <Card.Body className=\"blog_card_body\">\r\n                                                <Card.Title as=\"h3\" style={{ fontFamily: 'MontserratBold' }}>{ele.title}</Card.Title>\r\n                                                <Card.Text as=\"h6\" className='blog-desc'>\r\n                                                    {ele.summary}\r\n                                                </Card.Text>\r\n                                                <div className='blog-card-btn-div'>\r\n                                                    <Button className='blog-card-btn' href={ele.article_link} target=\"_blank\">\r\n                                                        Learn More\r\n                                                    </Button>\r\n                                                </div>\r\n                                            </Card.Body>\r\n                                        </Card>\r\n                                        <br />\r\n                                    </Col>\r\n                                )\r\n                            }\r\n                        }): (\r\n                    <> \r\n                    <div className='blog-error-div'>\r\n                      <ErrorIcon className='blog-error-icon'/>\r\n                      <div>\r\n                        <h3 >Error</h3>\r\n                        <h5 >Cannot connect to Server!</h5>\r\n                      </div>\r\n                    </div>\r\n                    </>\r\n                  )}\r\n            </>}\r\n                    </Row>\r\n                </Container>\r\n            </Container>\r\n            <FooterBar />\r\n        </div>\r\n    )\r\n}\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\Projects\\Projects.jsx",["153","154","155","156","157","158","159","160","161","162","163","164","165","166","167"],"import React, { useEffect } from 'react';\r\nimport { Container, Row, Col, Image, Card, Button } from 'react-bootstrap';\r\nimport { Typography } from '@material-ui/core';\r\nimport { motion, AnimateSharedLayout } from 'framer-motion';\r\nimport './Projects.css';\r\nimport Modal from '../Modal/Modal';\r\nimport Toolbar from '../DomainToolbar/Toolbar';\r\nimport axios from 'axios';\r\nimport FooterBar from '../Footer/footer-bottom';\r\nimport ErrorIcon from '@material-ui/icons/Error';\r\nimport CircularProgress from '@material-ui/core/CircularProgress';\r\n// import data from './data.json'\r\nimport { getAllProjectsDetails } from '../api/requests';\r\nexport default function Projects() {\r\n  const [modalShow, setModalShow] = React.useState(false);\r\n  const [props, setProps] = React.useState({});\r\n  const [data, setData] = React.useState([]);\r\n  const [domain, setDomain] = React.useState([].fill(false, 0, 2));\r\n  const [modalCondn, setModalCondn] = React.useState([].fill(false, 0, data.length));\r\n  const [displayAll,setDisplayAll] = React.useState(true);\r\n  const [error, setError] = React.useState(false)\r\n  const [domainMap,setDomainMap] = React.useState({\r\n    \"TRONIX\":0,\r\n    \"WEBDEV\":1,\r\n    \"ALGOS\":2,\r\n    \"APPDEV\":3\r\n  });\r\n  useEffect(() => {\r\n    fetchData();\r\n    let arr = [];\r\n    for (let i = 0; i < 2; i++) {\r\n      arr.push(false);\r\n    }\r\n    setDomain([...arr]);\r\n  }, []);\r\n  useEffect(() => {\r\n    let val = domain[0];\r\n    for (let i = 1; i < domain.length; i++) {\r\n      val = val || domain[i];\r\n    }\r\n    if (val) {\r\n      setDisplayAll(false);\r\n    } else {\r\n      setDisplayAll(true);\r\n    }\r\n  }, [domain]);\r\n\r\n  const [loading, setLoading] = React.useState(false)\r\n  const fetchData = async () => {\r\n    setLoading(true)\r\n    const res = await getAllProjectsDetails();\r\n    console.log(res);\r\n    if(res){\r\n      if(res.status && res.status == 500){\r\n        setError(true)\r\n      }\r\n      else{\r\n        setData(res);\r\n      }\r\n      setLoading(false)\r\n    }\r\n  };\r\n  useEffect(() => {\r\n    const timer = setTimeout(() => {\r\n      setData(data=>{\r\n        if(data.length == 0){\r\n          setLoading(false)\r\n          setError(true)\r\n        }\r\n        return data\r\n      })\r\n      \r\n    }, 3000);\r\n    return () => clearTimeout(timer);\r\n  }, []);\r\n\r\n  const displayContent = (ele,id)=>{\r\n    if (id % 2 == 0) {\r\n      return (\r\n        <Col className=\"proj-col\" sm={5} >\r\n          <AnimateSharedLayout>\r\n            {modalShow && modalCondn[id] ? (\r\n              createModal()\r\n            ) : (\r\n              <motion.div className=\"motion-card\" layoutId={`expandable-card-${id + 1}`}>\r\n                <Card className=\"text-white project-card\"\r\n                   onClick={() => {\r\n                          modalDisplay(\r\n                            ele.name,\r\n                            ele.Members,\r\n                            ele.desc,\r\n                            ele.project_photo_url,\r\n                            `expandable-card-${id + 1}`,\r\n                            `${id + 1}`,\r\n                          );\r\n                        }}\r\n                >\r\n                  <div className=\"proj-image-bg\">\r\n                    <Card.Img className=\"project-image\" variant=\"top\" src={ele.project_photo_url} />\r\n                  </div>\r\n                  <Card.Body className=\"text-center project-body\">\r\n                    <motion.div>\r\n                      <Card.Title className=\"project-title\">{ele.name}</Card.Title>\r\n                    </motion.div>\r\n                    <div className='project-card-desc'>\r\n                      {ele.desc}\r\n                    </div>\r\n                    <span className='project-card-learn-more' >{\"Learn more =>\"}</span>\r\n                    {/* <motion.div whileHover={{ scale: 1.05 }} whileTap={{ scale: 0.9 }}>\r\n                    <button\r\n                        className='project-card-button'\r\n                        onClick={() => {\r\n                          modalDisplay(\r\n                            ele.name,\r\n                            ele.Members,\r\n                            ele.desc,\r\n                            ele.project_photo_url,\r\n                            `expandable-card-${id + 1}`,\r\n                            `${id + 1}`,\r\n                          );\r\n                        }}\r\n                      >\r\n                        Learn More\r\n                      </button>\r\n                    </motion.div> */}\r\n                  </Card.Body>\r\n                </Card>\r\n              </motion.div>\r\n            )}\r\n          </AnimateSharedLayout>\r\n        </Col>\r\n      );\r\n    } else {\r\n      return (\r\n        <Col sm={5} className=\"proj-col\">\r\n          <AnimateSharedLayout>\r\n            {modalShow && modalCondn[id] ? (\r\n              createModal()\r\n            ) : (\r\n              <motion.div className=\"motion-card\" layoutId={`expandable-card-${id + 1}`}>\r\n                <Card className=\"text-white project-card\"\r\n                   onClick={() => {\r\n                          modalDisplay(\r\n                            ele.name,\r\n                            ele.Members,\r\n                            ele.desc,\r\n                            ele.project_photo_url,\r\n                            `expandable-card-${id + 1}`,\r\n                            `${id + 1}`,\r\n                          );\r\n                        }}\r\n                >\r\n                  <div className=\"proj-image-bg\">\r\n                    <Card.Img className=\"project-image\" variant=\"top\" src={ele.project_photo_url} />\r\n                  </div>\r\n                  <Card.Body className=\"text-center project-body\">\r\n                    <motion.div>\r\n                      <Card.Title className=\"project-title\">{ele.name}</Card.Title>\r\n                    </motion.div>\r\n                    <div className='project-card-desc'>\r\n                      {ele.desc}\r\n                    </div>\r\n                    <span className='project-card-learn-more' >{\"Learn more =>\"}</span>\r\n                    {/* <motion.div whileHover={{ scale: 1.05 }} whileTap={{ scale: 0.9 }}>\r\n                      <button\r\n                        className='project-card-button'\r\n                        onClick={() => {\r\n                          modalDisplay(\r\n                            ele.name,\r\n                            ele.Members,\r\n                            ele.desc,\r\n                            ele.project_photo_url,\r\n                            `expandable-card-${id + 1}`,\r\n                            `${id + 1}`,\r\n                          );\r\n                        }}\r\n                      >\r\n                        Learn More\r\n                      </button>\r\n                    </motion.div> */}\r\n                  </Card.Body>\r\n                </Card>\r\n              </motion.div>\r\n            )}\r\n          </AnimateSharedLayout>\r\n        </Col>\r\n      );\r\n    }\r\n  };\r\n\r\n  const modalDisplay = (title, members, info, image, layoutId, key) => {\r\n    let mem = members;\r\n    let newMemberList = [];\r\n    for (let i = 0; i < mem.length; i++) {\r\n      newMemberList.push([mem[i].name, mem[i].photo_url]);\r\n    }\r\n    setProps({\r\n      title: title,\r\n      members: newMemberList,\r\n      info: info,\r\n      image: image,\r\n      layoutId: layoutId,\r\n    });\r\n    setModalShow(true);\r\n    let newArr = [...modalCondn];\r\n    // console.log(key);\r\n    newArr.fill(false, 0, 4);\r\n    newArr[Number(key) - 1] = true;\r\n    setModalCondn(newArr);\r\n  };\r\n  const createModal = () => {\r\n    return <Modal {...props} show={modalShow} onHide={() => setModalShow(false)}></Modal>;\r\n  };\r\n  return (\r\n    <div id=\"projects-page\">\r\n      <Typography className=\"project-header-title\" variant=\"h2\" align=\"center\">\r\n        PROJECTS\r\n      </Typography>\r\n      {data.length>0 &&\r\n      <div className=\"domains\">\r\n        <Toolbar setDomain={setDomain} domain={domain}></Toolbar>\r\n      </div>\r\n      }\r\n      <Container fluid=\"md\">\r\n        <Container fluid>\r\n          <Row className=\"my-3 projects-display-cards\">\r\n\r\n          {loading==true? <div className='project-error-div' ><CircularProgress className='project-error-icon'/></div>:<>\r\n          {error==false ? displayAll \r\n              ? data.map((ele, id) => {\r\n                  return displayContent(ele, id);\r\n                })\r\n              : data\r\n                  .filter((e) => {\r\n                    if(e.domain == 'TRONIX'){\r\n                      return domain[0];\r\n                    }\r\n                    if(e.domain == 'WEBDEV' || e.domain == 'ALGOS' || e.domain == 'APPDEV'){\r\n                      return domain[1] ;\r\n                    }\r\n                  })\r\n                  .map((ele, id) => {\r\n                    return displayContent(ele, id);\r\n                  }):\r\n                  <div className='project-error-div'>\r\n                      <ErrorIcon className='project-error-icon'/>\r\n                      <div>\r\n                        <h3 >Error</h3>\r\n                        <h5 >Cannot connect to Server!</h5>\r\n                      </div>\r\n                    </div>\r\n                  }\r\n                  </>}\r\n          </Row>\r\n        </Container>\r\n      </Container>\r\n      <FooterBar />\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\Achievements\\Achievements.jsx",["168","169","170","171","172","173","174","175","176","177","178","179","180","181"],"import React , {useEffect} from 'react';\r\nimport { Container, Row, Col, Image, Card, Button } from 'react-bootstrap';\r\nimport { motion, AnimateSharedLayout } from 'framer-motion';\r\nimport './Achievements.css';\r\nimport Modal from '../Modal/Modal';\r\nimport FooterBar from '../Footer/footer-bottom';\r\nimport ErrorIcon from '@material-ui/icons/Error';\r\nimport CircularProgress from '@material-ui/core/CircularProgress';\r\n\r\n// import data from './data.json';\r\n\r\nimport Toolbar from '../DomainToolbar/Toolbar';\r\nimport { getAllAchievementDetails } from '../api/requests';\r\nexport default function Achievements() {\r\n  const [modalShow, setModalShow] = React.useState(false);\r\n  const [props, setProps] = React.useState({});\r\n  const [data,setData] = React.useState([]);\r\n  const [domain, setDomain] = React.useState([].fill(false, 0, 4));\r\n  const [modalCondn, setModalCondn] = React.useState([].fill(false, 0, 4));\r\n  const [displayAll, setDisplayAll] = React.useState(true);\r\n  const [error, setError] = React.useState(false)\r\n  const [domainMap, setDomainMap] = React.useState({\r\n    \"TRONIX\": 0,\r\n    \"WEBDEV\": 1,\r\n    \"ALGOS\": 2,\r\n    \"APPDEV\": 3\r\n  });\r\n  useEffect(() => {\r\n    let arr = [];\r\n    for (let i = 0; i < 4; i++) {\r\n      arr.push(false);\r\n    }\r\n    setDomain([...arr]);\r\n    fetchData();\r\n  }, []);\r\n  useEffect(() => {\r\n    // console.log(domain);\r\n    let val = domain[0];\r\n    for (let i = 1; i < domain.length; i++) {\r\n      val = val || domain[i];\r\n    }\r\n    if (val) {\r\n      setDisplayAll(false);\r\n    } else {\r\n      setDisplayAll(true);\r\n    }\r\n  }, [domain])\r\n\r\n  const [loading, setLoading] = React.useState(false)\r\n  const fetchData = async ()=>{\r\n    setLoading(true)\r\n    const res = await getAllAchievementDetails();\r\n    console.log(res);\r\n    if(res){\r\n      if(res.status && res.status == 500){\r\n        setError(true)\r\n      }\r\n      else{\r\n        setData(res);\r\n      }\r\n      setLoading(false)\r\n    }\r\n    \r\n    \r\n  }\r\n\r\n  useEffect(() => {\r\n    const timer = setTimeout(() => {\r\n      setData(data=>{\r\n        if(data.length == 0){\r\n          setLoading(false)\r\n          setError(true)\r\n        }\r\n        return data\r\n      })\r\n    }, 3000);\r\n    return () => clearTimeout(timer);\r\n  }, []);\r\n\r\n  const DisplayContent = ({ele,id})=>{\r\n    if (id % 2 == 0) {\r\n      return (\r\n        <Col className=\"my-3\" sm={5} >\r\n          <AnimateSharedLayout>\r\n            {modalShow && modalCondn[id] ? (\r\n              createModal()\r\n            ) : (\r\n              <motion.div className=\"motion-card\" layoutId={`expandable-card-${id + 1}`}>\r\n                <Card\r\n                  className=\"text-white achv-card\"\r\n                  onClick={() => {\r\n                          modalDisplay(\r\n                            ele.name_of_event,\r\n                            ele.Members,\r\n                            ele.desc,\r\n                            ele.achievement_photo_url,\r\n                            `expandable-card-${id + 1}`,\r\n                            `${id + 1}`,\r\n                          );\r\n                        }}\r\n                >\r\n                  <div className=\"achv-image-bg\">\r\n                    <Card.Img\r\n                    className=\"achv-image\"\r\n                    variant=\"top\"\r\n                    src={ele.achievement_photo_url}\r\n                  />\r\n                  </div>\r\n                  \r\n                  <Card.Body className=\"text-center achv-body\">\r\n                    <motion.div>\r\n                      <Card.Title className=\"achv-title\">{ele.name_of_event}</Card.Title>\r\n                    </motion.div>\r\n                    <div className='achv-card-desc'>\r\n                      {ele.desc}\r\n                    </div>\r\n                    <span className='achv-card-learn-more' >{\"Learn more =>\"}</span>\r\n                    {/* <motion.div whileHover={{ scale: 1.05 }} whileTap={{ scale: 0.9 }}>\r\n                      <button\r\n                        className='achv-card-button'\r\n                        onClick={() => {\r\n                          modalDisplay(\r\n                            ele.name_of_event,\r\n                            ele.Members,\r\n                            ele.desc,\r\n                            ele.achievement_photo_url,\r\n                            `expandable-card-${id + 1}`,\r\n                            `${id + 1}`,\r\n                          );\r\n                        }}\r\n                      >\r\n                        Learn More\r\n                      </button>\r\n                    </motion.div> */}\r\n                  </Card.Body>\r\n                </Card>\r\n              </motion.div>\r\n            )}\r\n          </AnimateSharedLayout>\r\n        </Col>\r\n      )\r\n    } else {\r\n      return (\r\n        <Col className=\"my-3\" sm={5}>\r\n          <AnimateSharedLayout>\r\n            {modalShow && modalCondn[id] ? (\r\n              createModal()\r\n            ) : (\r\n              <motion.div className=\"motion-card\" layoutId={`expandable-card-${id + 1}`}>\r\n                <Card\r\n                  style={{ background: '#141C3A' }}\r\n                  className=\"text-white achv-card\"\r\n                  onClick={() => {\r\n                          modalDisplay(\r\n                            ele.name_of_event,\r\n                            ele.Members,\r\n                            ele.desc,\r\n                            ele.achievement_photo_url,\r\n                            `expandable-card-${id + 1}`,\r\n                            `${id + 1}`,\r\n                          );\r\n                        }}\r\n                >\r\n                  <div className=\"achv-image-bg\">\r\n                    <Card.Img\r\n                    className=\"achv-image\"\r\n                    variant=\"top\"\r\n                    src={ele.achievement_photo_url}\r\n                  />\r\n                  </div>\r\n                  <Card.Body className=\"text-center achv-body\">\r\n                    <motion.div>\r\n                      <Card.Title className=\"achv-title\">{ele.name_of_event}</Card.Title>\r\n                    </motion.div>\r\n                    <div className='achv-card-desc'>\r\n                      {ele.desc}\r\n                    </div>\r\n                    <span className='achv-card-learn-more'>{\"Learn more =>\"}</span>\r\n                    {/* <motion.div whileHover={{ scale: 1.05 }} whileTap={{ scale: 0.9 }}>\r\n                      <button\r\n                        className='achv-card-button'\r\n                        onClick={() => {\r\n                          modalDisplay(\r\n                            ele.name_of_event,\r\n                            ele.Members,\r\n                            ele.desc,\r\n                            ele.achievement_photo_url,\r\n                            `expandable-card-${id + 1}`,\r\n                            `${id + 1}`,\r\n                          );\r\n                        }}\r\n                      >\r\n                        Learn More\r\n                      </button>\r\n                    </motion.div> */}\r\n                  </Card.Body>\r\n                </Card>\r\n              </motion.div>\r\n            )}\r\n          </AnimateSharedLayout>\r\n        </Col>\r\n      )\r\n    }\r\n  }\r\n\r\n  const modalDisplay = (title, members, info, image, layoutId, key) => {\r\n    let mem = members;\r\n    let newMemberList = [];\r\n    for (let i = 0; i < mem.length; i++) {\r\n      newMemberList.push([mem[i].name, mem[i].photo_url]);\r\n    }\r\n    setProps({\r\n      title: title,\r\n      members: newMemberList,\r\n      info: info,\r\n      image: image,\r\n      layoutId: layoutId,\r\n    });\r\n    setModalShow(true);\r\n    let newArr = [...modalCondn];\r\n    newArr.fill(false, 0, 4);\r\n    newArr[Number(key) - 1] = true;\r\n    setModalCondn(newArr);\r\n  };\r\n  const createModal = () => {\r\n    return <Modal {...props} show={modalShow} onHide={() => setModalShow(false)}></Modal>;\r\n  };\r\n  return (\r\n    <div id=\"achv-page\">\r\n      <div className=\"achv-intro-section\">\r\n        {/* <Image\r\n          className=\"achv_banner\"\r\n          src=\"https://images.unsplash.com/photo-1488229297570-58520851e868?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=1049&q=80\"\r\n          fluid\r\n        ></Image> */}\r\n        <div className=\"display-3 achv_banner_title\">ACHIEVEMENTS</div>\r\n      </div>\r\n      {data.length>0 &&\r\n      <div className=\"domains\">\r\n      <Toolbar setDomain={setDomain} domain={domain}></Toolbar>\r\n      </div>\r\n      }\r\n      <Container fluid=\"md\">\r\n        <Container fluid>\r\n          <Row className='achv-display-cards'>\r\n          {loading==true? <div className='achv-error-div' ><CircularProgress className='achv-error-icon'/></div>:<>\r\n          {error==false ? displayAll \r\n              ? data.map((ele, id) => {\r\n                  return <DisplayContent ele={ele} id={id} />\r\n                })\r\n              : data\r\n                  .filter((e) => {\r\n                    if(e.domain == 'TRONIX'){\r\n                      return domain[0];\r\n                    }\r\n                    if(e.domain == 'WEBDEV' || e.domain == 'ALGOS' || e.domain == 'APPDEV'){\r\n                      return domain[1] ;\r\n                    }\r\n                  })\r\n                  .map((ele, id) => {\r\n                    return <DisplayContent ele={ele} id={id} />\r\n                  }) : (\r\n                    <> \r\n                    <div className='achv-error-div'>\r\n                      <ErrorIcon className='achv-error-icon'/>\r\n                      <div>\r\n                        <h3 >Error</h3>\r\n                        <h5 >Cannot connect to Server!</h5>\r\n                      </div>\r\n                    </div>\r\n                    </>\r\n                  )}\r\n            </>}\r\n          </Row>\r\n        </Container>\r\n      </Container>\r\n      <FooterBar />\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\members\\All_members.js",[],"C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\api\\requests.js",[],"C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\home\\desc\\desc.js",[],"C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\Footer\\footer-overall.jsx",["182","183"],"import React from 'react';\r\nimport BottomFooter from './footer-bottom';\r\nimport MapComponent from './footer-maps';\r\nimport Grid from '@material-ui/core/Grid';\r\nimport Typography from '@material-ui/core/Typography';\r\nimport './footer-overall.css';\r\n\r\nfunction Footer() {\r\n  return (\r\n    <div id=\"Footer-Contacts\">\r\n      <div className=\"footer-main\">\r\n        <center>\r\n          <br />\r\n          <h3 className=\"footer-header\">\r\n            <strong>Find Us</strong>\r\n          </h3>\r\n        </center>\r\n      </div>\r\n      <div className=\"footer-contact-info\">\r\n        <div className=\"footer-contact-text\">\r\n          <h6>Primary Office</h6>\r\n          <p>Spider R&D Lab, </p>\r\n          <p>Ground floor, Old SAC,</p>\r\n          <p>(Opposite to CCD), NIT Tiruchirappalli.</p>\r\n\r\n          <h6>Email</h6>\r\n          <p><span>xyz@gmail.com</span> </p>\r\n        </div>\r\n        <div className=\"map-component\">\r\n          <MapComponent />\r\n        </div>\r\n        {/* <Grid item xs={12} sm={6}> */}\r\n        {/* <br />\r\n          <br />\r\n          <br />\r\n          <br />\r\n          <br />\r\n          <Typography align=\"center\" variant=\"h6\" gutterBottom>\r\n            <b>Primary Office</b>\r\n            <br />\r\n          </Typography>\r\n          <Typography align=\"center\" variant=\"body1\" gutterBottom>\r\n            Spider R&D Lab,\r\n            <br /> Ground floor, Old SAC,\r\n            <br /> (Opposite to CCD), NIT Tiruchirappalli.\r\n            <br />\r\n            <br />\r\n          </Typography> */}\r\n\r\n        {/* <Typography align=\"center\" variant=\"h6\" gutterBottom>\r\n            <b>Points of Contact</b>\r\n            <br />\r\n          </Typography>\r\n          <Typography align=\"center\" variant=\"body1\" gutterBottom>\r\n            Kumar Gaurav Singh\r\n            <br /> President, Spider\r\n            <br />\r\n            Mobile : 8210982383\r\n          </Typography>\r\n          <Typography align=\"center\" variant=\"body1\" gutterBottom>\r\n            Sudharshan S\r\n            <br /> Treasurer, Spider\r\n            <br />\r\n            Mobile : 9600897202\r\n          </Typography> */}\r\n        {/* </Grid> */}\r\n        {/* <Grid item xs={12} sm={6} className=\"map-grid\">\r\n          <MapComponent />\r\n        </Grid> */}\r\n      </div>\r\n      <br />\r\n      <br />\r\n      <br />\r\n      {/* <Grid container spacing={4}> */}\r\n      {/* <Grid item xs={12}>\r\n          <Typography align=\"center\" variant=\"h6\" gutterBottom>\r\n            <b>Points of Contact</b>\r\n            <br />\r\n          </Typography>\r\n        </Grid>\r\n\r\n        <Grid item md={3}>\r\n          <Typography align=\"center\" variant=\"body1\" gutterBottom>\r\n            Kumar Gaurav Singh\r\n            <br /> President, Spider\r\n            <br />\r\n            Ph: <span>6546468464</span>\r\n          </Typography>\r\n        </Grid>\r\n        <Grid item md={3}>\r\n          <Typography align=\"center\" variant=\"body1\" gutterBottom>\r\n            Kumar Gaurav Singh\r\n            <br /> President, Spider\r\n            <br />\r\n            Ph: <span>6546468464</span>\r\n          </Typography>\r\n        </Grid>\r\n        <Grid item md={3}>\r\n          <Typography align=\"center\" variant=\"body1\" gutterBottom>\r\n            Kumar Gaurav Singh\r\n            <br /> President, Spider\r\n            <br />\r\n            Ph: <span>6546468464</span>\r\n          </Typography>\r\n        </Grid>\r\n        <Grid item md={3}>\r\n          <Typography align=\"center\" variant=\"body1\" gutterBottom>\r\n            Kumar Gaurav Singh\r\n            <br /> President, Spider\r\n            <br />\r\n            Ph: <span>6546468464</span>\r\n          </Typography>\r\n        </Grid> */}\r\n      {/* <Grid item md={3} >\r\n        <Typography align=\"center\" variant=\"body1\" gutterBottom>\r\n            Kumar Gaurav Singh\r\n            <br /> President, Spider\r\n            <br />\r\n            Ph: <span>6546468464</span>\r\n          </Typography>\r\n        </Grid>\r\n        <Grid item md={3}>\r\n        <Typography align=\"center\" variant=\"body1\" gutterBottom>\r\n            Kumar Gaurav Singh\r\n            <br /> President, Spider\r\n            <br />\r\n            Ph: <span>6546468464</span>\r\n          </Typography>\r\n          </Grid>\r\n        <Grid item md={3}>\r\n        <Typography align=\"center\" variant=\"body1\" gutterBottom>\r\n            Kumar Gaurav Singh\r\n            <br /> President, Spider\r\n            <br />\r\n            Ph: <span>6546468464</span>\r\n          </Typography>\r\n          </Grid>\r\n        <Grid item md={3}>\r\n        <Typography align=\"center\" variant=\"body1\" gutterBottom>\r\n            Kumar Gaurav Singh\r\n            <br /> President, Spider\r\n            <br />\r\n            Ph: <span>6546468464</span>\r\n          </Typography>\r\n          </Grid> */}\r\n      {/* </Grid> */}\r\n      {/* <h4 className=\"footer-header\">\r\n        <strong>Points of Contact</strong>\r\n      </h4>\r\n      <div className=\"footer-points-of-contact\">\r\n        <div>\r\n          <strong> Kumar Gaurav Singh </strong>\r\n          <br /> President, Spider\r\n          <br />\r\n          Ph: <span>6546468464</span>\r\n        </div>\r\n        <div>\r\n          <strong> Kumar Gaurav Singh </strong>\r\n          <br /> President, Spider\r\n          <br />\r\n          Ph: <span>6546468464</span>\r\n        </div>\r\n        <div>\r\n          <strong>Kumar Gaurav Singh</strong>\r\n          <br /> President, Spider\r\n          <br />\r\n          Ph: <span>6546468464</span>\r\n        </div>\r\n        <div>\r\n          <strong> Kumar Gaurav Singh </strong>\r\n          <br /> President, Spider\r\n          <br />\r\n          Ph: <span>6546468464</span>\r\n        </div>\r\n      </div> */}\r\n      <br />\r\n      <hr />\r\n      <BottomFooter />\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Footer;\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\home\\Team\\Team.jsx",["184"],"import React from 'react';\r\nimport { Image, Container, Button } from 'react-bootstrap';\r\nimport './Team.css';\r\nexport default function Team() {\r\n  return (\r\n    <Container className=\"text-center\" id=\"team-container\">\r\n      <h1 className=\"home-team-title\">Our Team</h1>\r\n      <Image\r\n        className=\"home-team-image\"\r\n        style={{ borderRadius: 3 }}\r\n        src=\"images/team.jpg\"\r\n        fluid\r\n      ></Image>\r\n      <hr />\r\n      {/* <button id=\"view-team-btn\" onClick={() => {\r\n                window.location.href = \"/members\";\r\n            }}>View All Members</button> */}\r\n      <hr />\r\n    </Container>\r\n  );\r\n}\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\home\\Animation\\Animation.jsx",["185","186"],"C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\home\\Team\\CoreMembers\\Members.jsx",["187"],"import GitHub from '@material-ui/icons/GitHub';\r\nimport Language from '@material-ui/icons/Language';\r\nimport LinkedIn from '@material-ui/icons/LinkedIn';\r\nimport Card from '@material-ui/core/Card';\r\nimport CardContent from '@material-ui/core/CardContent';\r\nimport Typography from '@material-ui/core/Typography';\r\nimport CardActionArea from '@material-ui/core/CardActionArea';\r\nimport CardActions from '@material-ui/core/CardActions';\r\nimport CardMedia from '@material-ui/core/CardMedia';\r\nimport IconButton from '@material-ui/core/IconButton';\r\nimport React, { useEffect, useState } from 'react';\r\nimport { Container, Row, Col, Button } from 'react-bootstrap';\r\nimport MemData from './coreMembersData.json';\r\nimport './Members.css';\r\nimport { Link } from 'react-router-dom';\r\nexport default function Members() {\r\n  const [data, setData] = useState([]);\r\n\r\n  useEffect(() => {\r\n    setData(MemData);\r\n  }, []);\r\n\r\n  return (\r\n    <div>\r\n      <Container id=\"home-core-container\" className=\"text-center\">\r\n        <h1 className=\"home-core-team-title\">Core Members</h1>\r\n        <Row>\r\n          {data.map((members, index) => {\r\n            return <MemberCard members={members} index={index} />;\r\n          })}\r\n        </Row>\r\n      </Container>\r\n      <Link to=\"/members\">\r\n        <button className=\"members-buttons\" onClick={() => {}}>\r\n          View All members\r\n        </button>\r\n      </Link>\r\n    </div>\r\n  );\r\n}\r\n\r\nconst MemberCard = ({ members, index }) => {\r\n  const [isHover, setIsHover] = useState(false);\r\n  return (\r\n    <Col\r\n      md={4}\r\n      key={index}\r\n      style={{ margin: 'auto' }}\r\n      onMouseEnter={() => {\r\n        setIsHover(true);\r\n      }}\r\n      onMouseLeave={() => {\r\n        setIsHover(false);\r\n      }}\r\n    >\r\n      <Card\r\n        className=\"member_card\"\r\n        style={isHover ? { filter: 'blur(5px)', opacity: '50%', scale: '100%' } : {}}\r\n      >\r\n        <CardActionArea>\r\n          <CardMedia\r\n            component=\"img\"\r\n            alt={members.Role}\r\n            className=\"member_card_img\"\r\n            // height=\"360\"\r\n            image={members.Photo}\r\n            title={members.Role}\r\n          />\r\n          <CardContent className=\"member_card_content\">\r\n            <Typography gutterBottom variant=\"h5\" component=\"h2\">\r\n              {members.Name}\r\n            </Typography>\r\n            <Typography variant=\"h6\" color=\"textSecondary\">\r\n              {members.Role}\r\n            </Typography>\r\n          </CardContent>\r\n        </CardActionArea>\r\n      </Card>\r\n      {isHover && (\r\n        <div>\r\n          <div\r\n            style={{\r\n              position: 'absolute',\r\n              top:0,\r\n              bottom:'25px',\r\n              left:'15px',\r\n              right:'15px'\r\n            }}\r\n            className='members-hoverBorder'\r\n          ></div>\r\n          <div\r\n            style={{\r\n              position: 'absolute',\r\n              top: '30%',\r\n              left: '50%',\r\n              transform: 'translateX(-50%)',\r\n              color: 'white',\r\n            }}\r\n          >\r\n            <Typography\r\n              gutterBottom\r\n              variant=\"h5\"\r\n              component=\"h2\"\r\n              style={{ fontFamily: 'MontserratBold' }}\r\n            >\r\n              {members.Name}\r\n            </Typography>\r\n            <Typography variant=\"h6\" style={{ color: 'white' }}>\r\n              {members.Role}\r\n            </Typography>\r\n          </div>\r\n\r\n          <div\r\n            style={{ position: 'absolute', top: '60%', left: '50%', transform: 'translateX(-50%)' }}\r\n          >\r\n            <CardActions>\r\n              <IconButton className=\"link_btn\" aria-label=\"personalSite\" href={members.Website}>\r\n                <Language className=\"member-links\"></Language>\r\n              </IconButton>\r\n              <IconButton aria-label=\"linkedIn\" href={members.LinkedIn} className=\"link_btn\">\r\n                <LinkedIn className=\"member-links\"></LinkedIn>\r\n              </IconButton>\r\n              <IconButton aria-label=\"gitHubLink\" href={members.Github} className=\"link_btn\">\r\n                <GitHub className=\"member-links\"></GitHub>\r\n              </IconButton>\r\n            </CardActions>\r\n          </div>\r\n        </div>\r\n      )}\r\n\r\n      <br />\r\n    </Col>\r\n  );\r\n};\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\Admin\\AdminProj.jsx",["188","189","190","191","192","193","194"],"import { TextareaAutosize } from '@material-ui/core';\r\nimport React, { useState, useEffect } from 'react';\r\nimport { Col, Container, Row, Button, Form, Card } from 'react-bootstrap';\r\nimport { getAllProjectsDetails, getProjectDetailsById, addProject, deleteProject, updateProject } from '../api/requests';\r\n\r\nfunction AdminProj() {\r\n    const [projData, setProjData] = useState([]);\r\n    const [edit, setEdit] = useState(false);\r\n    const [currentProj,setCurrentProj] = useState({});\r\n    const [isLoading, setIsLoading] = useState(true);\r\n    useEffect(() => {\r\n        fetchData();\r\n    }, []);\r\n    \r\n    const submitEditForm = async(ele,name,img,desc,domain)=>{\r\n        let data = ele;\r\n        data.name = name;\r\n        data.project_photo_url = img;\r\n        data.desc = desc;\r\n        data.domain = domain;\r\n        const res = await updateProject(data,data.id);\r\n        console.log(res);\r\n    }\r\n\r\n    const fetchData = async () => {\r\n        const res = await getAllProjectsDetails();\r\n        setProjData([...res]);\r\n    }\r\n    return (\r\n        <>\r\n            <div>\r\n                <Row xs={1} md={2} className=\"g-4\">\r\n                    {!edit?(\r\n                        <>\r\n                            {projData.map((ele, id) => {\r\n                                \r\n                                return (\r\n                                    <Col>\r\n                                        <Card>\r\n                                            <Card.Img variant=\"top\" src={ele.project_photo_url} />\r\n                                            <Card.Body style={{ color: \"black\" }}>\r\n                                                <Card.Title>{ele.name}</Card.Title>\r\n                                                <Card.Text>\r\n                                                    <p>{ele.desc}</p>\r\n                                                </Card.Text>\r\n                                                <Card.Text>\r\n                                                    <h4>{ele.domain}</h4>\r\n                                                </Card.Text>\r\n                                            </Card.Body>\r\n                                            <Card.Footer className=\"text-muted\">\r\n                                                <Row>\r\n                                                    <Col><Button variant='Warning'\r\n                                                        onClick={() => {\r\n                                                            setEdit(true);\r\n                                                            setCurrentProj(ele);\r\n                                                        }}\r\n                                                    >Edit</Button></Col>\r\n                                                    {/* <Col><Button></Button></Col> */}\r\n                                                </Row>\r\n                                            </Card.Footer>\r\n                                        </Card>\r\n                                    </Col>\r\n                                )\r\n                            })}\r\n                        </>\r\n                    ):(\r\n                        <>\r\n                                <Form style={{width:\"100%\"}}>\r\n                                    <Form.Group className=\"mb-3\">\r\n                                        <Form.Label>Title</Form.Label>\r\n                                        <Form.Control id=\"edit-name\" type=\"text\" value={currentProj.name} placeholder=\"Enter title\" />\r\n                                    </Form.Group>\r\n                                    <Form.Group className=\"mb-3 d-flex flex-column\">\r\n                                        <Form.Label>Summary</Form.Label>\r\n                                        <textarea name=\"\" id=\"edit-desc\" cols=\"30\" rows=\"10\">\r\n                                            {currentProj.desc}\r\n                                        </textarea>\r\n                                    </Form.Group>\r\n                                    <Form.Group className=\"mb-3\">\r\n                                        <Form.Label>Image Link</Form.Label>\r\n                                        <Form.Control type=\"text\" id=\"edit-img\" value={currentProj.project_photo_url} placeholder=\"Enter Image Link\" />\r\n                                    </Form.Group>\r\n                                    <Form.Group className=\"mb-3\">\r\n                                        <Form.Label>Domain</Form.Label>\r\n                                        <Form.Control id=\"edit-domain\" type=\"text\" value={currentProj.domain} placeholder=\"Enter domain\" />\r\n                                    </Form.Group>\r\n                                    <div>\r\n                                        <Button style={{marginRight:\"10px\"}} variant=\"primary\" type=\"submit\" onClick={()=>{\r\n                                            let name = document.getElementById(\"edit-name\").value;\r\n                                            let desc = document.getElementById(\"edit-desc\").innerHTML;\r\n                                            let img = document.getElementById(\"edit-img\").value;\r\n                                            let domain = document.getElementById(\"edit-domain\").value;\r\n\r\n                                            submitEditForm(currentProj,name,img,desc,domain);\r\n                                        }}>\r\n                                            Submit\r\n                                        </Button>\r\n                                        <Button variant='danger' onClick={() => {\r\n                                            setEdit(false) }}>Close</Button>\r\n                                    </div>\r\n                                </Form>\r\n                        </>\r\n                    )}\r\n                </Row>\r\n            </div>\r\n        </>\r\n    );\r\n}\r\n\r\nexport default AdminProj;","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\Modal\\Modal.jsx",["195","196"],"import React from 'react';\r\nimport { motion, AnimatePresence } from 'framer-motion';\r\nimport './Modal.css';\r\nimport ModalHeader from 'react-bootstrap/esm/ModalHeader';\r\nimport {\r\n  ModalBody,\r\n  ModalFooter,\r\n  ModalTitle,\r\n  Button,\r\n  Image,\r\n  ModalDialog,\r\n  Accordion,\r\n  Card,\r\n} from 'react-bootstrap';\r\nconst backdrop = {\r\n  visible: {\r\n    opacity: 1,\r\n    transition: {\r\n      from: 0,\r\n      duration: 1,\r\n    },\r\n  },\r\n  hidden: { opacity: 0 },\r\n};\r\nconst modal = {\r\n  hidden: {\r\n    // opacity:0,\r\n    // scale:0,\r\n    transition: { type: 'spring', stiffness: 120 },\r\n  },\r\n  visible: {\r\n    // opacity:1,\r\n    // scale:1,\r\n    transition: { type: 'spring', stiffness: 120 },\r\n  },\r\n};\r\nexport default function Modal(props) {\r\n  const { show, onHide, title, members, info, image, layoutId } = props;\r\n  return (\r\n    <motion.div\r\n      className=\"backdrop\"\r\n      variants={backdrop}\r\n      initial=\"hidden\"\r\n      animate=\"visible\"\r\n      exit=\"hidden\"\r\n      layoutId={layoutId}\r\n    >\r\n      <motion.div className=\"custom-modal\" variants={modal}>\r\n        <ModalDialog className=\"custom-modal\" scrollable centered size=\"lg\">\r\n          <ModalHeader className=\"modal-title\">\r\n            <ModalTitle>{title}</ModalTitle>\r\n          </ModalHeader>\r\n          <Image className=\"modal-image\" height=\"280px\" width=\"80%\" src={image}></Image>\r\n          <ModalBody className=\"modal-details\">\r\n            <Accordion className=\"\" defaultActiveKey=\"0\">\r\n              <Card style={{ background: '#6D4DFF', color: 'white', border:\"none\" }}>\r\n                <Accordion.Toggle\r\n                  as={Card.Header}\r\n                  style={{ padding: '0.5rem 1.25rem' }}\r\n                  eventKey=\"0\"\r\n                >\r\n                  Members\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"0\">\r\n                  <div className=\"modal-members\">\r\n                    {members.map((member,i) => {\r\n                      return (\r\n                        <div key={i}>\r\n                          <Image\r\n                            width={64}\r\n                            height={64}\r\n                            src={member[1]}\r\n                            roundedCircle\r\n                          />\r\n                          <p>{member[0]}</p>\r\n                        </div>\r\n                      );\r\n                    })}\r\n                  </div>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n            </Accordion>\r\n            <p className=\"modal-info\">\r\n              {info}\r\n              {/* Lorem, ipsum dolor sit amet consectetur adipisicing elit. Non rerum quae harum est\r\n              quasi ratione! Quam, laudantium suscipit nulla iste distinctio dicta dolores beatae\r\n              odit eaque nesciunt eveniet, perspiciatis maiores? */}\r\n            </p>\r\n          </ModalBody>\r\n          <ModalFooter className=\"custom-modal-footer\">\r\n            <Button\r\n              variant=\"primary\"\r\n              onClick={() => {\r\n                onHide();\r\n              }}\r\n            >\r\n              Close\r\n            </Button>\r\n          </ModalFooter>\r\n        </ModalDialog>\r\n      </motion.div>\r\n    </motion.div>\r\n  );\r\n}\r\n","C:\\Users\\adity\\Desktop\\site 3\\site-vfinal\\src\\DomainToolbar\\Toolbar.jsx",["197","198","199","200","201","202","203","204","205","206","207","208","209"],"import React, { useState } from 'react'\r\nimport { Paper, Box } from '@material-ui/core'\r\nimport { Android, Code, Language, SelectAll, CheckBox, Flag } from '@material-ui/icons'\r\nimport './Toolbar.css'\r\nimport HardwareIcon from \"../assets/HardwareIcon.svg\"\r\nimport SoftwareIcon from \"../assets/SoftwareIcon.svg\"\r\n\r\nexport default function Toolbar(props) {\r\n    let setDomain = props.setDomain;\r\n    let domain = props.domain\r\n    const handleOnClick = (index)=>{\r\n        // if(index === -1){\r\n        //     setDomain([false,false]);\r\n        //     return;\r\n        // }\r\n        // setDomain([false,false,false,false]);\r\n        let newDomain = [];\r\n        // domain = [];\r\n        for(let i=0;i<2;i++){\r\n            if(i === index){\r\n                if(domain[i]!=true)\r\n                    newDomain.push(true)\r\n                else\r\n                    newDomain.push(false)\r\n            }else{\r\n                newDomain.push(false)\r\n            }\r\n        }\r\n        setDomain(newDomain);\r\n        // console.log(domain);\r\n    }\r\n    return (\r\n        <div className='domain-toolbar'>\r\n            <Paper onClick={(e) => {\r\n                e.preventDefault();\r\n                handleOnClick(0)\r\n            }} className={\"domain-box\"+(domain[0] == true ? ' domain-box-clicked' : '')} variant=\"outlined\" elevation={5}  >\r\n                <img src={HardwareIcon} className=\"domain-image\" />\r\n                <h6>HARDWARE</h6>\r\n            </Paper>\r\n            <Paper onClick={(e)=>{\r\n                e.preventDefault();\r\n                handleOnClick(1)\r\n            }} className={\"domain-box\"+(domai