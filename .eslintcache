":"37","hashOfConfig":"26"},{"size":67856,"mtime":1643019596478,"results":"38","hashOfConfig":"26"},{"size":3403,"mtime":1643019596360,"results":"39","hashOfConfig":"26"},{"size":919,"mtime":1643019596436,"results":"40","hashOfConfig":"26"},{"size":558,"mtime":1643019596435,"results":"41","hashOfConfig":"26"},{"size":2173,"mtime":1643019596318,"results":"42","hashOfConfig":"26"},{"size":22608,"mtime":1643019596409,"results":"43","hashOfConfig":"26"},{"size":3859,"mtime":1643019596434,"results":"44","hashOfConfig":"26"},{"size":2344,"mtime":1643019596302,"results":"45","hashOfConfig":"26"},{"size":3132,"mtime":1643019596341,"results":"46","hashOfConfig":"26"},{"size":485,"mtime":1644169409137,"results":"47","hashOfConfig":"26"},{"size":940,"mtime":1643019596303,"results":"48","hashOfConfig":"26"},{"size":986,"mtime":1643019596317,"results":"49","hashOfConfig":"26"},{"filePath":"50","messages":"51","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"52","usedDeprecatedRules":"53"},"qjvqsy",{"filePath":"54","messages":"55","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"53"},{"filePath":"56","messages":"57","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"58","usedDeprecatedRules":"53"},{"filePath":"59","messages":"60","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"61","usedDeprecatedRules":"53"},{"filePath":"62","messages":"63","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"64","usedDeprecatedRules":"53"},{"filePath":"65","messages":"66","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"53"},{"filePath":"67","messages":"68","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"53"},{"filePath":"69","messages":"70","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"71","usedDeprecatedRules":"53"},{"filePath":"72","messages":"73","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"74","usedDeprecatedRules":"53"},{"filePath":"75","messages":"76","errorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"77","usedDeprecatedRules":"53"},{"filePath":"78","messages":"79","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"80","usedDeprecatedRules":"53"},{"filePath":"81","messages":"82","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"83","usedDeprecatedRules":"53"},{"filePath":"84","messages":"85","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"53"},{"filePath":"86","messages":"87","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"53"},{"filePath":"88","messages":"89","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"53"},{"filePath":"90","messages":"91","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"92","usedDeprecatedRules":"53"},{"filePath":"93","messages":"94","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"53"},{"filePath":"95","messages":"96","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"97","usedDeprecatedRules":"53"},{"filePath":"98","messages":"99","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"100","usedDeprecatedRules":"53"},{"filePath":"101","messages":"102","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"103","usedDeprecatedRules":"53"},{"filePath":"104","messages":"105","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"106","usedDeprecatedRules":"53"},{"filePath":"107","messages":"108","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"53"},{"filePath":"109","messages":"110","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"53"},{"filePath":"111","messages":"112","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"D:\\site-vfinal\\src\\index.js",["113","114"],"import React from 'react';\nimport ReactDOM from 'react-dom';\nimport './index.css';\nimport App from './App';\nimport './fonts/Product\\ Sans\\ Regular.ttf'\nimport reportWebVitals from './reportWebVitals';\n\nReactDOM.render(\n  <React.StrictMode>\n    <App />\n  </React.StrictMode>,\n  document.getElementById('root')\n);\n\n// If you want to start measuring performance in your app, pass a function\n// to log results (for example: reportWebVitals(console.log))\n// or send to an analytics endpoint. Learn more: https://bit.ly/CRA-vitals\nreportWebVitals();",["115","116"],"D:\\site-vfinal\\src\\reportWebVitals.js",[],"D:\\site-vfinal\\src\\App.js",["117"],"import './App.css';\nimport Home from './home/home';\nimport NavBar from './navbar/navbar';\nimport Projects from './Projects/Projects';\nimport Members from './members/Members.jsx';\nimport ProjectItems from './blogs/Blog.jsx';\nimport Blog from './blogs/blogs';\nimport Achievements from './Achievements/Achievements';\nimport { BrowserRouter as Router, Route, Switch } from 'react-router-dom';\n// import { blogs } from './api/requests';\nimport { useEffect } from 'react';\nimport { test } from './api/test';\nimport Admin from './Admin/Admin';\n\nfunction App() {\n  // const getBlogs = async () => {\n  //   try {\n  //     const data = await blogs();\n  //     if (data.status >= 400) {\n  //       console.log('error:', data.statusText);\n  //       // console.log(data.data.message)\n  //       return;\n  //     }\n  //     console.log(data);\n  //   } catch (error) {\n  //     console.log(error);\n  //   }\n  // };\n  useEffect(() => {\n    // getBlogs();\n    test();\n  }, []);\n  return (\n    <Router>\n      <div className=\"App\">\n        <NavBar />\n        <Switch>\n          <Route path=\"/projects\">\n            <Projects></Projects>\n          </Route>\n          <Route path=\"/achievements\">\n            <Achievements></Achievements>\n          </Route>\n          <Route exact path=\"/blogs\">\n            <Blog />\n          </Route>\n          <Route exact path=\"/members\">\n            <Members />\n          </Route>\n          <Route exact path=\"/admin\">\n            <Admin></Admin>\n          </Route>\n          <Route path=\"/\">\n            <Home></Home>\n          </Route>\n        </Switch>\n      </div>\n    </Router>\n  );\n}\nexport default App;\n","D:\\site-vfinal\\src\\blogs\\Blog.jsx",["118","119"],"import React, {useState} from \"react\";\nimport CssBaseline from \"@material-ui/core/CssBaseline\";\nimport Grid from \"@material-ui/core/Grid\";\nimport Typography from \"@material-ui/core/Typography\";\nimport Container from \"@material-ui/core/Container\";\nimport Data from \"./blogInfo.json\";\nimport { motion, AnimatePresence} from \"framer-motion\";\nimport Card from 'react-bootstrap/Card';\nimport ExpandLessIcon from '@material-ui/icons/ExpandLess';\nimport ExpandMoreIcon from '@material-ui/icons/ExpandMore';\nimport LocalLibraryIcon from '@material-ui/icons/LocalLibrary';\nimport './blog.css';\nimport {Link} from 'react-bootstrap'\n\nlet data = JSON.stringify(Data);\nlet blogData = JSON.parse(data);\n\nfunction Album(props) {\n  const container = {\n    hidden: { rotate: 180, opacity:0 },\n    show: {\n      rotate: 0,\n      opacity:1,\n    }\n  };\n  // console.log(props.cardOpen)\n  return (\n    <div>\n      <motion.div \n      className=\"cardblock\"\n      variants={container}\n      initial=\"hidden\"\n      animate=\"show\"\n      whileHover={{\n        scale: 1.08,\n        transition: { duration: 0.25 },\n      }}\n      >\n      <Card.Text >\n      <motion.div >\n        <p className=\"heading\" style={{fontSize:20, paddingTop:20}}>\n          {props.blogTitle}\n        </p>\n        </motion.div>\n      </Card.Text>\n      <Card.Body style={{paddingBottom:45}}>\n        <motion.div>\n        <Card.Img \n          src={props.imgsrc} \n          alt=\"Card image\"\n          className=\"cardMedia\" \n        />\n        </motion.div>\n      {props.cardOpen && \n        <AnimatePresence>\n        <motion.div\n        initial={{opacity:0}}\n        animate={{opacity:1, transition:2}}\n        >\n        <p className=\"desc\" gutterbottom>\n          {props.blogDescription}\n        </p>\n         <a href={props.blogLink}\n          style={{color:\"gray\", textDecoration:\"none\", fontSize:17, fontFamily:\"calibri\", fontSmooth: \"auto\", cursor:\"pointer\", display:\"flex\", justifyContent:\"center\"}}>\n            <LocalLibraryIcon style={{marginRight:7}}/>Read blog\n        </a>\n        </motion.div>\n      </AnimatePresence> \n    }\n     {(props.cardOpen) ?\n      <div onClick={props.isOpen} style={{float:\"right\", cursor:\"pointer\"}}>\n        <ExpandLessIcon style={{fontSize:40, color:\"#909090\"}}/>\n    </div> : (\n      <div onClick={props.isOpen} style={{float:\"right\", cursor:\"pointer\"}}>\n        <ExpandMoreIcon style={{fontSize:40, color:\"\t#909090\"}}/>\n    </div>\n    )}\n    </Card.Body>\n    </motion.div>\n    </div>\n  );\n}\n\nexport default function ProjectItems() {\n  const [cardOpen, setCardOpen]= useState(false);\n  return (\n    <React.Fragment>\n      <CssBaseline />\n      <main>\n        <div className=\"heroContent\">\n          <Container maxWidth=\"lg\">\n            <Typography \n              variant=\"h2\"\n              align=\"center\"\n              color=\"whitesmoke\"\n              style={{marginBottom:20, fontSize:70, fontFamily:\"calibri\"}}\n              className=\"root\"\n              gutterBottom\n            >\n              Blogs\n            </Typography>\n          </Container>\n        </div>\n        <Container maxWidth=\"md\">\n        <Grid container spacing={4}>\n        {blogData.map(post => (\n              <Grid item xs={12} sm={6} md={4}  key={post.id}>\n                <div>\n              <Album\n                  blogId={post.id}\n                  blogTitle={post.title}\n                  blogDescription={post.summary}\n                  imgsrc={post.image_link}\n                  blogLink={post.article_link}\n                  isOpen={()=>{setCardOpen(id => {if(post.id==id) return null; return post.id;})}}\n                  cardOpen={cardOpen===post.id}\n                />\n          </div>\n          </Grid>\n          ))}    \n          </Grid>      \n        </Container>\n      </main>\n    </React.Fragment>\n  );\n}","D:\\site-vfinal\\src\\members\\Members.jsx",["120","121","122","123"],"import { React , useState} from 'react';\nimport { motion , AnimatePresence} from \"framer-motion\";\nimport { Container,Button, Nav, Col, Row } from \"react-bootstrap\";\nimport Card from 'react-bootstrap/Card';\nimport CardColumns from 'react-bootstrap/CardColumns';\nimport { BrowserRouter as Router } from \"react-router-dom\";\nimport MemoryIcon from '@material-ui/icons/Memory';\nimport PublicIcon from '@material-ui/icons/Public';\nimport AndroidIcon from '@material-ui/icons/Android';\nimport AccountTreeIcon from '@material-ui/icons/AccountTree';\nimport LinkedInIcon from \"@material-ui/icons/LinkedIn\";\nimport LanguageIcon from \"@material-ui/icons/Language\";\nimport GitHubIcon from \"@material-ui/icons/GitHub\";\nimport IconButton from \"@material-ui/core/IconButton\";\nimport { members } from \"./All_members\";\nimport './members.css';\nimport { BottomNavigationAction, BottomNavigation } from '@material-ui/core';\n\nconst container = {\n  hidden: { opacity: 1, scale: 0 },\n  visible: {\n    opacity: 1,\n    scale: 1,\n    transition: {\n      delayChildren: 0.1,\n      staggerChildren: 0.1\n    }\n  }\n}\n  \nconst item = {\n  hidden: { \n    scale:0, \n    opacity: 0,\n    transition: { type: 'tween', duration:0.8 }\n  },\n  visible: {\n    scale: 1,\n    opacity: 1,\n    transition: { type: 'tween', duration:0.8 }\n  }\n}\n\nconst year = [\n  [\"All\", \"All\"],\n  [\"B Tech 4th year\", \"2020-21\"],\n  [\"B Tech 3rd Year\",\"2021-22\"],\n  [\"B Tech 2nd Year\", \"2022-23\"],\n  [\"MCA 2nd year\",\"MCA\"],\n];\n\nfunction Members () {\n  const [yearName,setYearName]= useState(\"All\");\n  const [ProfileName,setProfileName]= useState(\"Tronix\");\n  const [clicktronix, setClicktronix] = useState(false);\n  const [clickappdev, setClickappdev] = useState(false);\n  const [clickwebdev, setClickwebdev] = useState(false);\n  const [clickalgos, setClickalgos] = useState(false);\n  const [domain, setDomain] = useState([true,false,false,false])\n  const handleClickTronix=()=>{\n    setClickappdev(false);\n    setClickwebdev(false);\n    setClickalgos(false);\n    setClicktronix(!clicktronix);\n    setDomain([true,false,false,false]);\n    setProfileName(\"Tronix\");\n  }\n  const handleClickAppdev=()=>{\n    setClicktronix(false);\n    setClickwebdev(false);\n    setClickalgos(false);\n    setClickappdev(!clickappdev);\n    setDomain([false,false,true,false])\n    setProfileName(\"App Dev\");\n  }\n  const handleClickWebdev=()=>{\n    setClicktronix(false);\n    setClickappdev(false);\n    setClickalgos(false);\n    setClickwebdev(!clickwebdev)\n    setDomain([false,true,false,false])\n    setProfileName(\"Web Dev\");\n  }\n  const handleClickAlogs=()=>{\n    setClicktronix(false);\n    setClickwebdev(false);\n    setClickappdev(false);\n    setClickalgos(!clickalgos);\n    setDomain([false,false,false,true])\n    setProfileName(\"Algos\");\n  }\n\n  const subMenuAnimate = {\n    enter: (i) => ({\n      opacity: 1,\n      transition: {\n        duration: i * 0.8\n      },\n      display: \"block\"\n    }\n    ),\n    exit: {\n      opacity: 0,\n      transition: {\n        duration: 2\n      },\n      // display: \"none\"\n    }\n  };\n\n  const displayYearNav = (index)=>{\n    const domainCond = [clicktronix,clickwebdev,clickappdev,clickalgos];\n    if(domainCond[index]){\n      return (\n        <Nav variant=\"tabs\" defaultActiveKey=\"All\" style={{justifyContent:\"space-between\"}}>\n          {year.map((item, idx) => {\n\n            if(index === 0 && idx === 4){\n              return (<></>)\n            }\n            return (\n              <motion.div\n                initial=\"exit\"\n                animate={domainCond[index] ? \"enter\" : \"exit\"}\n                variants={subMenuAnimate}\n                custom={idx}\n                key={idx}>\n                <Nav.Item className=\"batch_item\">\n                  <Nav.Link onClick={((e) => handleYearClick(e, item[0]))} eventKey={item[1]}>{item[1]}</Nav.Link>\n                </Nav.Item>\n              </motion.div>\n            )\n          })}\n        </Nav>\n      )\n    }else{\n      return(\n        <></>\n      )\n    }\n  }\n\n  const handleYearClick =(e, yr)=>{\n    setYearName(yr); \n  }\n// console.log(yearName, ProfileName)\n\n  return(\n    <Container className=\"container\">\n      <Router>\n      <h1 style={{color:\"white\", textAlign:\"center\", padding:15, fontSize:55, fontWeight:600}}>Members</h1>\n    <br/>\n    <>\n    <nav className='navbar'>\n        <motion.div\n            className=\"menu-item\"\n        >\n          <Button onClick={handleClickTronix} className=\"tronixIcon\"> \n            <MemoryIcon fontSize=\"large\" />\n            <br/>\n            <p className=\"label\">Tronix</p>\n          </Button> \n          </motion.div>\n          <motion.div\n            className=\"menu-item\"\n          >\n          <Button onClick={handleClickWebdev} className=\"webdevIcon\"> \n            <PublicIcon fontSize=\"large\"/>\n            <br/>\n            <p className=\"label\">Web Dev</p>\n          </Button> \n          </motion.div> \n          <motion.div\n            className=\"menu-item\"\n          >\n          <Button  onClick={handleClickAppdev} className=\"appdevIcon\"> \n            <AndroidIcon fontSize=\"large\" />\n            <br/>\n            <p className=\"label\">App Dev</p>\n          </Button> \n          </motion.div>\n          <motion.div\n            className=\"menu-item\"\n          >\n          <Button onClick={handleClickAlogs} className=\"algosIcon\"> \n            <AccountTreeIcon fontSize=\"large\" />\n            <br/>\n            <p className=\"label\">Algos</p>\n          </Button> \n          </motion.div>\n        </nav>\n        {displayYearNav(domain.findIndex(e=> e===true))}\n      </>  \n    <AnimatePresence initial={true}>\n    <motion.div\n    variants={container}\n    initial=\"hidden\"\n    animate=\"visible\"\n    style={{display:\"flex\", justifyContent:\"space-around\", padding:30}}\n    >  \n    <CardColumns>\n      <Container fluid=\"lg\">\n        {members\n        .filter(member => member.Profile === ProfileName)\n        .filter(member => member.Year === yearName)\n        .map((member,id) => (\n        <motion.div className=\"item\"\n          variants={item}\n          key={`member_${id}`}\n        >\n            <Card className=\"bg-dark text-white member_card\" style={{ margin: 20, background: '#141C3A'}}>\n        <Card.Img src={member.Photo} alt={member.Name} />\n          <Card.Title className=\"member_name\" style={{ background: '#141C3A', textAlign:\"center\"}}>{member.Name}</Card.Title>\n          <Card.Body style={{ background: '#141C3A'}}>\n          <Card.Text style={{ background: '#141C3A'}} className=\"iconLinks\">\n                  {member.LinkedIn ? (\n                    <a href={member.LinkedIn}>\n                      <IconButton >\n                        <LinkedInIcon fontSize=\"large\" className=\"buttonlinkedInIcon\"/>\n                      </IconButton>\n                    </a>\n                  ) : (\n                    <IconButton>\n                      <LinkedInIcon fontSize=\"large\" className=\"buttonlinkedInIcon\"/>\n                    </IconButton>\n                  )}\n                  {member.Website ? (\n                    <a href={member.Website}>\n                      <IconButton>\n                        <LanguageIcon className=\"buttonwebIcon\" fontSize=\"large\"/>\n                      </IconButton>\n                    </a>\n                  ) : (\n                    <IconButton >\n                      <LanguageIcon className=\"buttonwebIcon\" fontSize=\"large\"/>\n                    </IconButton>\n                  )}\n                  {member.Github ? (\n                    <a href={member.Github}>\n                      <IconButton >\n                        <GitHubIcon className=\"buttongithubIcon\" fontSize=\"large\"/>\n                      </IconButton>\n                    </a>\n                  ) : (\n                    <IconButton>\n                      <GitHubIcon className=\"buttongithubIcon\" fontSize=\"large\"/>\n                    </IconButton>\n                  )}\n              </Card.Text>\n            </Card.Body>\n            </Card>\n            <br></br>\n            </motion.div>\n        ))}       \n      </Container>  \n    </CardColumns>\n    </motion.div> \n    </AnimatePresence>   \n    </Router>\n   </Container>    \n)};\n\nexport default Members;","D:\\site-vfinal\\src\\navbar\\navbar.js",[],"D:\\site-vfinal\\src\\home\\home.js",[],"D:\\site-vfinal\\src\\api\\test.js",["124","125","126","127"],"import { deleteMember, getAllBlogsDetails, getBlogDetailsById, login } from './requests';\n\nconst test = () => {\n  //   getAllBlogsDetails();\n  //   getBlogDetailsById(1);\n  // login({\n  //   username: 'user',\n  //   password: 'password',\n  // });\n  // deleteMember(2);\n};\n\nexport { test };\n","D:\\site-vfinal\\src\\Achievements\\Achievements.jsx",["128","129"],"import React , {useEffect} from 'react';\nimport { Container, Row, Col, Image, Card, Button } from 'react-bootstrap';\nimport { motion, AnimateSharedLayout } from 'framer-motion';\nimport './Achievements.css';\nimport Modal from '../Modal/Modal';\nimport data from './data.json';\nimport Toolbar from '../DomainToolbar/Toolbar';\nexport default function Achievements() {\n  const [modalShow, setModalShow] = React.useState(false);\n  const [props, setProps] = React.useState({});\n  const [domain, setDomain] = React.useState([].fill(false, 0, 4));\n  const [modalCondn, setModalCondn] = React.useState([].fill(false, 0, 4));\n  const [displayAll, setDisplayAll] = React.useState(true);\n  useEffect(() => {\n    let arr = [];\n    for (let i = 0; i < 4; i++) {\n      arr.push(false);\n    }\n    setDomain([...arr]);\n  }, []);\n  useEffect(() => {\n    console.log(domain);\n    let val = domain[0];\n    for (let i = 1; i < domain.length; i++) {\n      val = val || domain[i];\n    }\n    if (val) {\n      setDisplayAll(false);\n    } else {\n      setDisplayAll(true);\n    }\n  }, [domain])\n\n  const displayContent = (ele,id)=>{\n    if (id % 2 == 0) {\n      return (\n        <Col className=\"my-3\" md={5}>\n          <AnimateSharedLayout>\n            {modalShow && modalCondn[id] ? (\n              createModal()\n            ) : (\n              <motion.div className=\"motion-card\" layoutId={`expandable-card-${id + 1}`}>\n                <Card\n                  style={{ background: '#141C3A' }}\n                  className=\"text-white achv-card\"\n                >\n                  <div className=\"achv-image-bg\">\n                    <Card.Img\n                    className=\"achv-image\"\n                    variant=\"top\"\n                    src={ele.image}\n                  />\n                  </div>\n                  \n                  <Card.Body className=\"text-center achv-body\">\n                    <motion.div>\n                      <Card.Title className=\"achv-title\">{ele.title}</Card.Title>\n                    </motion.div>\n                    <motion.div whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }}>\n                      <Button\n                        variant=\"outline-light\"\n                        onClick={() => {\n                          modalDisplay(\n                            ele.title,\n                            ele.members,\n                            ele.desc,\n                            ele.image,\n                            `expandable-card-${id + 1}`,\n                            `${id + 1}`,\n                          );\n                        }}\n                      >\n                        Learn More\n                      </Button>\n                    </motion.div>\n                  </Card.Body>\n                </Card>\n              </motion.div>\n            )}\n          </AnimateSharedLayout>\n        </Col>\n      )\n    } else {\n      return (\n        <Col className=\"my-3\" md={7}>\n          <AnimateSharedLayout>\n            {modalShow && modalCondn[id] ? (\n              createModal()\n            ) : (\n              <motion.div className=\"motion-card\" layoutId={`expandable-card-${id + 1}`}>\n                <Card\n                  style={{ background: '#141C3A' }}\n                  className=\"text-white achv-card\"\n                >\n                  <div className=\"achv-image-bg\">\n                    <Card.Img\n                    className=\"achv-image\"\n                    variant=\"top\"\n                    src={ele.image}\n                  />\n                  </div>\n                  <Card.Body className=\"text-center achv-body\">\n                    <motion.div>\n                      <Card.Title className=\"achv-title\">{ele.title}</Card.Title>\n                    </motion.div>\n                    <motion.div whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }}>\n                      <Button\n                        variant=\"outline-light\"\n                        onClick={() => {\n                          modalDisplay(\n                            ele.title,\n                            ele.members,\n                            ele.desc,\n                            ele.image,\n                            `expandable-card-${id + 1}`,\n                            `${id + 1}`,\n                          );\n                        }}\n                      >\n                        Learn More\n                      </Button>\n                    </motion.div>\n                  </Card.Body>\n                </Card>\n              </motion.div>\n            )}\n          </AnimateSharedLayout>\n        </Col>\n      )\n    }\n  }\n\n  const modalDisplay = (title, members, info, image, layoutId, key) => {\n    setProps({\n      title: title,\n      members: members,\n      info: info,\n      image: image,\n      layoutId: layoutId,\n    });\n    setModalShow(true);\n    let newArr = [...modalCondn];\n    newArr.fill(false, 0, 4);\n    newArr[Number(key) - 1] = true;\n    setModalCondn(newArr);\n  };\n  const createModal = () => {\n    return <Modal {...props} show={modalShow} onHide={() => setModalShow(false)}></Modal>;\n  };\n  return (\n    <div id=\"achv-page\">\n      <div className=\"achv-intro-section\">\n        {/* <Image\n          className=\"achv_banner\"\n          src=\"https://images.unsplash.com/photo-1488229297570-58520851e868?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=1049&q=80\"\n          fluid\n        ></Image> */}\n        <div className=\"display-3 achv_banner_title\">Achievements</div>\n      </div>\n      <div className=\"domains\">\n      <Toolbar setDomain={setDomain}></Toolbar>\n      </div>\n      <Container fluid=\"md\">\n        <Container fluid>\n          <Row>\n            {displayAll?data.map((ele,id)=>{\n              return displayContent(ele,id);\n            }) : data.filter((ele) => {\n              return domain[ele.domain];\n            }).map((ele,idx)=>{\n              console.log(\"Clicked\");\n              return displayContent(ele,idx);\n            })}\n          </Row>\n        </Container>\n      </Container>\n    </div>\n  );\n}\n","D:\\site-vfinal\\src\\blogs\\blogs.jsx",["130","131","132","133","134"],"import React, { useEffect, useState } from 'react'\r\nimport { Container, Row, Col, Card, Button } from 'react-bootstrap';\r\nimport Typography from \"@material-ui/core/Typography\";\r\nimport './blog.css';\r\nimport data from './blogInfo.json'\r\nimport { Link } from 'react-router-dom';\r\nexport default function Blog() {\r\n    return (\r\n        <div id=\"blogs-page\">\r\n            <Container>\r\n                {/* <Typography variant=\"h1\" style={{fontFamily:\"Product Sans\"}} className=\"text-center text-white\" component=\"div\" gutterBottom>\r\n                    Blogs\r\n                </Typography> */}\r\n                <div className=\"display-3 blogs_header\" style={{ fontFamily: \"Product Sans\" }}>Blogs</div>\r\n            </Container>\r\n            <Container fluid=\"md\">\r\n                <Container style={{maxWidth:\"1300px\"}}>\r\n                    <Row className=\"my-3\">\r\n                        {data.map((ele, id) => {\r\n                            if (id % 2 == 0) {\r\n                                return (\r\n                                    <Col className=\"blog-col\" md={5}>\r\n                                        <Card className=\"text-white blog_card\" style={{ background: '#141C3A' }}>\r\n                                            <Card.Img className=\"blog_card_img\" variant=\"top\" src={ele.image_link} />\r\n                                            <Card.Body className=\"blog_card_body\">\r\n                                                <Card.Title as=\"h3\">{ele.title}</Card.Title>\r\n                                                <Card.Text as=\"h6\">\r\n                                                    {ele.summary}\r\n                                                </Card.Text>\r\n                                                <Button variant=\"primary\" href={ele.article_link} target=\"_blank\">\r\n                                                    Learn More\r\n                                                </Button>\r\n                                            </Card.Body>\r\n                                        </Card>\r\n                                        <br />\r\n                                    </Col>\r\n                                )\r\n                            }else{\r\n                                return (\r\n                                    <Col className=\"blog-col\" md={7}>\r\n                                        <Card className=\"text-white blog_card\" style={{ background: '#141C3A' }}>\r\n                                            <Card.Img className=\"blog_card_img\" variant=\"top\" src={ele.image_link} />\r\n                                            <Card.Body className=\"blog_card_body\">\r\n                                                <Card.Title as=\"h3\">{ele.title}</Card.Title>\r\n                                                <Card.Text as=\"h6\">\r\n                                                    {ele.summary}\r\n                                                </Card.Text>\r\n                                                <Button variant=\"primary\" href={ele.article_link}>\r\n                                                    Learn More\r\n                                                </Button>\r\n                                            </Card.Body>\r\n                                        </Card>\r\n                                        <br />\r\n                                    </Col>\r\n                                )\r\n                            }\r\n                        })}\r\n                    </Row>\r\n                </Container>\r\n            </Container>\r\n        </div>\r\n    )\r\n}\r\n","D:\\site-vfinal\\src\\Projects\\Projects.jsx",["135","136","137"],"import React, { useEffect } from 'react';\nimport { Container, Row, Col, Image, Card, Button } from 'react-bootstrap';\nimport { Typography } from '@material-ui/core';\nimport { motion, AnimateSharedLayout } from 'framer-motion';\nimport './Projects.css';\nimport Modal from '../Modal/Modal';\nimport Toolbar from '../DomainToolbar/Toolbar';\nimport axios from 'axios';\nimport data from './data.json'\nexport default function Projects() {\n  const [modalShow, setModalShow] = React.useState(false);\n  const [props, setProps] = React.useState({});\n  // const [data, setData] = React.useState([]);\n  const [domain,setDomain] = React.useState([].fill(false,0,4));\n  const [modalCondn, setModalCondn] = React.useState([].fill(false, 0, data.length));\n  const [displayAll,setDisplayAll] = React.useState(true);\n  useEffect(() => {\n    let arr = [];\n    for(let i=0;i<4;i++){\n      arr.push(false);\n    }\n    setDomain([...arr]);\n  }, []);\n  useEffect(()=>{\n    let val = domain[0];\n    for(let i=1;i<domain.length;i++){\n      val = val || domain[i];\n    }\n    if(val){\n      setDisplayAll(false);\n    }else{\n      setDisplayAll(true);\n    }\n  },[domain])\n\n  const displayContent = (ele,id)=>{\n    if (id % 2 == 0) {\n      return (\n        <Col className=\"proj-col\" md={5}>\n          <AnimateSharedLayout>\n            {modalShow && modalCondn[id] ? (\n              createModal()\n            ) : (\n              <motion.div className=\"motion-card\" layoutId={`expandable-card-${id + 1}`}>\n                <Card\n                  style={{ background: '#141C3A' }}\n                  className=\"text-white project-card\"\n                >\n                  <div className='proj-image-bg'>\n                      <Card.Img\n                        className=\"project-image\"\n                        variant=\"top\"\n                        src={ele.projImg}\n                      />\n                  </div>\n                  <Card.Body className=\"text-center project-body\">\n                    <motion.div>\n                      <Card.Title className=\"project-title\">{ele.projTitle}</Card.Title>\n                    </motion.div>\n                    <motion.div whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }}>\n                      <Button\n                        variant=\"outline-light\"\n                        onClick={() => {\n                          modalDisplay(\n                            ele.projTitle,\n                            ele.projMembers,\n                            ele.projInfo,\n                            ele.projImage,\n                            `expandable-card-${id + 1}`,\n                            `${id + 1}`,\n                          );\n                        }}\n                      >\n                        Learn More\n                      </Button>\n                    </motion.div>\n                  </Card.Body>\n                </Card>\n              </motion.div>\n            )}\n          </AnimateSharedLayout>\n        </Col>\n      )\n    } else {\n      return (\n        <Col md={7} className=\"proj-col\">\n          <AnimateSharedLayout>\n            {modalShow && modalCondn[id] ? (\n              createModal()\n            ) : (\n              <motion.div className=\"motion-card\" layoutId={`expandable-card-${id + 1}`}>\n                <Card\n                  style={{ background: '#141C3A' }}\n                  className=\"text-white project-card\"\n                >\n                  <div className='proj-image-bg'>\n                    <Card.Img\n                      className=\"project-image\"\n                      variant=\"top\"\n                      src={ele.projImg}\n                    />\n                  </div>\n                  <Card.Body className=\"text-center project-body\">\n                    <motion.div>\n                      <Card.Title className=\"project-title\">{ele.projTitle}</Card.Title>\n                    </motion.div>\n                    <motion.div whileHover={{ scale: 1.1 }}>\n                      <Button\n                        variant=\"outline-light\"\n                        onClick={() => {\n                          modalDisplay(\n                            ele.projTitle,\n                            ele.projMembers,\n                            ele.projInfo,\n                            ele.projImage,\n                            `expandable-card-${id + 1}`,\n                            `${id + 1}`,\n                          );\n                        }}\n                      >\n                        Learn More\n                      </Button>\n                    </motion.div>\n                  </Card.Body>\n                </Card>\n              </motion.div>\n            )}\n          </AnimateSharedLayout>\n        </Col>\n      )\n    }\n  }\n\n  const modalDisplay = (title, members, info, image, layoutId, key) => {\n    setProps({\n      title: title,\n      members: members,\n      info: info,\n      image: image,\n      layoutId: layoutId,\n    });\n    setModalShow(true);\n    let newArr = [...modalCondn];\n    console.log(key);\n    newArr.fill(false, 0, 4);\n    newArr[Number(key) - 1] = true;\n    setModalCondn(newArr);\n  };\n  const createModal = () => {\n    return <Modal {...props} show={modalShow} onHide={() => setModalShow(false)}></Modal>;\n  };\n  return (\n    <div id=\"projects-page\">\n      <Typography className='project-header' variant='h1' align='center'>Projects Page</Typography>\n      <div className=\"domains\">\n        <Toolbar setDomain={setDomain}></Toolbar>\n      </div>\n      <Container fluid=\"md\">\n        <Container fluid>\n          <Row className=\"my-3\">\n            {displayAll ? data.map((ele, id) => {\n              return displayContent(ele,id);\n            }):data.filter(e=>{\n              return domain[e.domain];\n            }).map((ele,id)=>{\n              return displayContent(ele,id);\n            })}\n          </Row>\n        </Container>\n      </Container>\n    </div>\n  );\n}\n","D:\\site-vfinal\\src\\Admin\\Admin.jsx",["138","139"],"import React, { useState, useEffect } from 'react';\r\nimport {Row, Col, Container, ListGroup, Tab} from 'react-bootstrap';\r\nfunction Admin() {\r\n    return ( \r\n    <div style={{height:\"100vh\",color:\"white\"}}>\r\n        <h1 className='text-center'>Admin Dashboard</h1>\r\n            <Container>\r\n                <Tab.Container id=\"list-group-tabs-example\" defaultActiveKey=\"#link1\">\r\n                    <Row>\r\n                        <Col sm={3}>\r\n                            <ListGroup>\r\n                                <ListGroup.Item action href=\"#link1\">\r\n                                    Project\r\n                                </ListGroup.Item>\r\n                                <ListGroup.Item action href=\"#link2\">\r\n                                    Achievement\r\n                                </ListGroup.Item>\r\n                                <ListGroup.Item action href=\"#link3\">\r\n                                    Blogs\r\n                                </ListGroup.Item>\r\n                                <ListGroup.Item action href=\"#link4\">\r\n                                    Members\r\n                                </ListGroup.Item>\r\n                            </ListGroup>\r\n                        </Col>\r\n                        <Col sm={9}>\r\n                            <Tab.Content>\r\n                                <Tab.Pane eventKey=\"#link1\">\r\n                                    <div>Hello World</div>\r\n                                </Tab.Pane>\r\n                                <Tab.Pane eventKey=\"#link2\">\r\n                                    <div>Hello World</div>\r\n                                </Tab.Pane>\r\n                                <Tab.Pane eventKey=\"#link3\">\r\n                                    <div>Hello World</div>\r\n                                </Tab.Pane>\r\n                                <Tab.Pane eventKey=\"#link4\">\r\n                                    <div>Hello World</div>\r\n                                </Tab.Pane>\r\n                            </Tab.Content>\r\n                        </Col>\r\n                    </Row>\r\n                </Tab.Container>\r\n            </Container>\r\n    </div> \r\n    );\r\n}\r\n\r\nexport default Admin;","D:\\site-vfinal\\src\\members\\All_members.js",[],"D:\\site-vfinal\\src\\api\\requests.js",[],"D:\\site-vfinal\\src\\home\\desc\\desc.js",[],"D:\\site-vfinal\\src\\home\\Team\\Team.jsx",["140"],"import React from 'react'\r\nimport { Image,Container,Button } from 'react-bootstrap'\r\nimport './Team.css'\r\nexport default function Team() {\r\n    return (\r\n        <Container className=\"text-center\" id=\"team-container\">\r\n            <h1 className=\"home-team-title\">Our Team</h1>\r\n            <Image src=\"images/team.jpg\" fluid></Image>\r\n            <hr />\r\n            <button id=\"view-team-btn\" onClick={() => {\r\n                window.location.href = \"/members\";\r\n            }}>View All Members</button>\r\n            <hr />\r\n        </Container>\r\n    )\r\n}\r\n","D:\\site-vfinal\\src\\Footer\\footer-overall.jsx",[],"D:\\site-vfinal\\src\\home\\Animation\\Animation.jsx",["141","142","143"],"import React, { useEffect } from 'react'\r\nimport {gsap} from 'gsap';\r\nimport SpiderLogo from './SpiderLogo.png'\r\nimport './Animation.css'\r\nimport svgFile from './svg.svg';\r\nexport default function Animation() {\r\n    useEffect(() => {\r\n        const tl = gsap.timeline();\r\n        // style=\"enable-background:new 0 0 1186.4 662.8;\"\r\n        let svgAnimation = document.querySelector('#svg');\r\n        let bgd = document.querySelector('#background rect');\r\n        let table = document.querySelector('#table_legs, #table');\r\n        let lampLeg = document.querySelector('#lamp > .lamp-leg');\r\n        let lampbt = document.querySelector('#lamp-bottom');\r\n        let lampLight = document.querySelector('#lamp > .light');\r\n        let lampLine = document.querySelector('#lamp-line');\r\n        let lampLineB = document.querySelector('#lamp-line-b');\r\n        let lampLineT = document.querySelector('#lamp-line-t');\r\n        let lampCircle = document.querySelector('#lamp-circle');\r\n        let lampHead = document.querySelector('#lamp-head');\r\n        let lampHeader = document.querySelector('#lamp-header');\r\n        let lampBody = document.querySelector('#lamp-body');\r\n        let computer = document.querySelectorAll('#computer > *');\r\n        let keyboard = document.querySelectorAll('#keyboard > *');\r\n        let logo = document.querySelector('#svg_83');\r\n        let sunIcon = document.querySelector(\"#sun_icon\");\r\n        let asset = document.querySelectorAll('#computer_mouse > * , #coffee_mug > *');\r\n        tl.from(bgd, 0.2, { opacity: 0, scale: 0, transformOrigin: 'center center' })\r\n            .staggerFrom(table, 0.2, { y: \"-=200\", opacity: 0, ease: \"elastic.out(1,1)\" }, 0.1)\r\n            .from(lampLeg, 0.2, { opacity: 0, x: \"-200\", ease: \"elastic.out(1,1)\" })\r\n            .from(lampbt, 0.2, { opacity: 0, scale: 0, transformOrigin: 'center center' })\r\n            .from(lampLineB, 0.3, { opacity: 0, transformOrigin: '100% 100%', rotation: '-180deg' })\r\n            .from(lampCircle, 0.1, { opacity: 0, x: '-=100', y: '-=100' })\r\n            .from(lampLineT, 0.3, { opacity: 0, transformOrigin: '0% 100%', rotation: '-180deg' })\r\n            .from(lampHead, 0.2, { opacity: 0, scale: 0, ease: \"elastic.out(1,1)\" })\r\n            .from(lampHeader, 0.5, { transformOrigin: '60% 60%', rotation: '60deg' })\r\n            .from(lampBody, 0.5, { transformOrigin: '70% 70%', rotation: '-25deg' })\r\n            .staggerFrom(computer, 1, { opacity: 0, scale: 0, transformOrigin: 'center center', ease: \"back.out(1,1)\" }, 0.2)\r\n            .staggerFrom(logo, 1, { opacity: 0, scale: 0, transformOrigin: 'center center', ease: \"back.out(1,1)\" }, 0.2)\r\n            .staggerFrom(keyboard, 0.5, { opacity: 0, y: '-=100', ease: \"linear.inOut(1,1)\" }, 0.05)\r\n            .staggerFrom(asset, 0.5, { opacity: 0 }, 0.05)\r\n            .to(lampLight, 0.2, { opacity: 0.8, ease: \"elastic.out(1,1)\", delay: 0.5 }, \"a\")\r\n            .to(lampLight, 0.1, { opacity: 0 }, \"b\")\r\n            .to(lampLight, 0.1, { opacity: 0.2 }, \"c\")\r\n            .to(bgd, 0.2, { opacity: 0.1, delay: 0.5 }, \"a-=0.05\")\r\n            .to(bgd, 0.1, { opacity: 1 }, \"b-=0.05\")\r\n            .to(bgd, 0.1, { opacity: 0.1 }, \"c-=0.05\")\r\n            .to(bgd, 0.2, { opacity: 1, ease: \"elastic.out(1,1)\",fill: '#192E45' })\r\n            .fromTo(lampLine, 0.2, { opacity: 0 }, { opacity: 0.2, delay: 0.5 }, \"a-=0.05\")\r\n            .to(lampLine, 0.1, { opacity: 1 }, \"b-=0.05\")\r\n            .to(lampLine, 0.1, { opacity: 0.5 }, \"c-=0.05\");\r\n    });\r\n\r\n    return (\r\n        <>\r\n            <div id=\"svg-container\">\r\n                <svg viewBox=\"0 0 1500 662.8\" xmlns=\"http://www.w3.org/2000/svg\" xmlnsXlink=\"http://www.w3.org/1999/xlink\" xmlSpace=\"preserve\" version=\"1.1\">\r\n                    <g>\r\n                        <g stroke=\"null\" id=\"background\">\r\n                            <rect stroke=\"null\" id=\"svg_1\" height=\"675.45826\" width=\"1508.30255\" fill=\"#41C0F2\" y=\"-8.65826\" x=\"-2.7\" />\r\n                        </g>\r\n                        <g id=\"table_legs\">\r\n                            <g id=\"svg_2\">\r\n                                <defs transform=\"translate(44.5312 0) translate(127.06 0) translate(20.2532 -10.1266)\">\r\n                                    <rect height=\"662.8\" width=\"1197.1\" y=\"0\" x=\"-9.7\"