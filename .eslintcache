[{"/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/index.js":"1","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/reportWebVitals.js":"2","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/App.js":"3","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/blogs/Blog.jsx":"4","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/members/Members.jsx":"5","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/navbar/navbar.js":"6","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/home/home.js":"7","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/blogs/blogs.jsx":"8","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/Projects/Projects.jsx":"9","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/Achievements/Achievements.jsx":"10","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/Footer/footer-bottom.jsx":"11","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/members/All_members.js":"12","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/home/desc/desc.js":"13","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/home/Team/Team.jsx":"14","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/Footer/footer-overall.jsx":"15","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/home/Team/CoreMembers/Members.jsx":"16","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/home/Animation/Animation.jsx":"17","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/DomainToolbar/Toolbar.jsx":"18","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/Modal/Modal.jsx":"19","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/Footer/footer-maps.jsx":"20","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/api/test.js":"21","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/Admin/Admin.jsx":"22","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/api/requests.js":"23","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/Admin/AdminProj.jsx":"24","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/api/Index.js":"25"},{"size":543,"mtime":1668949910126,"results":"26","hashOfConfig":"27"},{"size":362,"mtime":1668949910129,"results":"28","hashOfConfig":"27"},{"size":1769,"mtime":1668949910082,"results":"29","hashOfConfig":"27"},{"size":3787,"mtime":1668949910111,"results":"30","hashOfConfig":"27"},{"size":7548,"mtime":1668949910127,"results":"31","hashOfConfig":"27"},{"size":1256,"mtime":1668949910128,"results":"32","hashOfConfig":"27"},{"size":617,"mtime":1668949910125,"results":"33","hashOfConfig":"27"},{"size":4339,"mtime":1668949942179,"results":"34","hashOfConfig":"27"},{"size":6512,"mtime":1668950026304,"results":"35","hashOfConfig":"27"},{"size":7025,"mtime":1668949925409,"results":"36","hashOfConfig":"27"},{"size":991,"mtime":1668949910089,"results":"37","hashOfConfig":"27"},{"size":68692,"mtime":1668949910127,"results":"38","hashOfConfig":"27"},{"size":1165,"mtime":1668949910125,"results":"39","hashOfConfig":"27"},{"size":630,"mtime":1668949910124,"results":"40","hashOfConfig":"27"},{"size":5476,"mtime":1668949910091,"results":"41","hashOfConfig":"27"},{"size":3363,"mtime":1668949910124,"results":"42","hashOfConfig":"27"},{"size":22612,"mtime":1668949910120,"results":"43","hashOfConfig":"27"},{"size":1790,"mtime":1668949910087,"results":"44","hashOfConfig":"27"},{"size":3107,"mtime":1668949910095,"results":"45","hashOfConfig":"27"},{"size":986,"mtime":1668949910090,"results":"46","hashOfConfig":"27"},{"size":290,"mtime":1668949910104,"results":"47","hashOfConfig":"27"},{"size":2228,"mtime":1668949910077,"results":"48","hashOfConfig":"27"},{"size":3575,"mtime":1668949910104,"results":"49","hashOfConfig":"27"},{"size":5878,"mtime":1668949910078,"results":"50","hashOfConfig":"27"},{"size":471,"mtime":1668949910103,"results":"51","hashOfConfig":"27"},{"filePath":"52","messages":"53","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"54","usedDeprecatedRules":"55"},"iwvmqn",{"filePath":"56","messages":"57","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"55"},{"filePath":"58","messages":"59","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"60","usedDeprecatedRules":"55"},{"filePath":"61","messages":"62","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"63","usedDeprecatedRules":"55"},{"filePath":"64","messages":"65","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"66","usedDeprecatedRules":"55"},{"filePath":"67","messages":"68","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"55"},{"filePath":"69","messages":"70","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"71","usedDeprecatedRules":"55"},{"filePath":"72","messages":"73","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"74","messages":"75","errorCount":0,"warningCount":11,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"76","messages":"77","errorCount":0,"warningCount":10,"fixableErrorCount":0,"fixableWarningCount":0,"source":"78","usedDeprecatedRules":"55"},{"filePath":"79","messages":"80","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"81","usedDeprecatedRules":"55"},{"filePath":"82","messages":"83","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"55"},{"filePath":"84","messages":"85","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"55"},{"filePath":"86","messages":"87","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"88","usedDeprecatedRules":"55"},{"filePath":"89","messages":"90","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"91","usedDeprecatedRules":"55"},{"filePath":"92","messages":"93","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"94","usedDeprecatedRules":"55"},{"filePath":"95","messages":"96","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"97","usedDeprecatedRules":"55"},{"filePath":"98","messages":"99","errorCount":0,"warningCount":13,"fixableErrorCount":0,"fixableWarningCount":0,"source":"100","usedDeprecatedRules":"55"},{"filePath":"101","messages":"102","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"103","usedDeprecatedRules":"55"},{"filePath":"104","messages":"105","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"106"},{"filePath":"107","messages":"108","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"109","usedDeprecatedRules":"55"},{"filePath":"110","messages":"111","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"112","usedDeprecatedRules":"55"},{"filePath":"113","messages":"114","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"55"},{"filePath":"115","messages":"116","errorCount":0,"warningCount":7,"fixableErrorCount":0,"fixableWarningCount":0,"source":"117","usedDeprecatedRules":"55"},{"filePath":"118","messages":"119","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"55"},"/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/index.js",["120","121"],"import React from 'react';\nimport ReactDOM from 'react-dom';\nimport './index.css';\nimport App from './App';\nimport './fonts/Product\\ Sans\\ Regular.ttf'\nimport reportWebVitals from './reportWebVitals';\n\nReactDOM.render(\n  <React.StrictMode>\n    <App />\n  </React.StrictMode>,\n  document.getElementById('root')\n);\n\n// If you want to start measuring performance in your app, pass a function\n// to log results (for example: reportWebVitals(console.log))\n// or send to an analytics endpoint. Learn more: https://bit.ly/CRA-vitals\nreportWebVitals();",["122","123"],"/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/reportWebVitals.js",[],"/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/App.js",["124","125","126"],"import './App.css';\nimport Home from './home/home';\nimport NavBar from './navbar/navbar';\nimport Projects from './Projects/Projects';\nimport Members from './members/Members.jsx';\nimport ProjectItems from './blogs/Blog.jsx';\nimport Blog from './blogs/blogs';\nimport FooterBar from './Footer/footer-bottom';\nimport Achievements from './Achievements/Achievements';\nimport { BrowserRouter as Router, Route, Switch } from 'react-router-dom';\n// import { blogs } from './api/requests';\nimport { useEffect } from 'react';\nimport { test } from './api/test';\nimport Admin from './Admin/Admin';\n\nfunction App() {\n  // const getBlogs = async () => {\n  //   try {\n  //     const data = await blogs();\n  //     if (data.status >= 400) {\n  //       console.log('error:', data.statusText);\n  //       // console.log(data.data.message)\n  //       return;\n  //     }\n  //     console.log(data);\n  //   } catch (error) {\n  //     console.log(error);\n  //   }\n  // };\n  useEffect(() => {\n    // getBlogs();\n    test();\n  }, []);\n  return (\n    <Router>\n      <div className=\"App\">\n        <NavBar />\n        <Switch>\n          <Route path=\"/projects\">\n            <Projects></Projects>\n          </Route>\n          <Route path=\"/achievements\">\n            <Achievements></Achievements>\n          </Route>\n          <Route exact path=\"/blogs\">\n            <Blog />\n          </Route>\n          <Route exact path=\"/members\">\n            <Members />\n          </Route>\n          {/* <Route exact path=\"/admin\">\n            <Admin></Admin>\n          </Route> */}\n          <Route path=\"/\">\n            <Home></Home>\n          </Route>\n        </Switch>\n        {/* {window.location.pathname !== '/' ? <FooterBar></FooterBar> : <></>} */}\n      </div>\n    </Router>\n  );\n}\nexport default App;\n","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/blogs/Blog.jsx",["127","128"],"import React, {useState} from \"react\";\nimport CssBaseline from \"@material-ui/core/CssBaseline\";\nimport Grid from \"@material-ui/core/Grid\";\nimport Typography from \"@material-ui/core/Typography\";\nimport Container from \"@material-ui/core/Container\";\nimport Data from \"./blogInfo.json\";\nimport { motion, AnimatePresence} from \"framer-motion\";\nimport Card from 'react-bootstrap/Card';\nimport ExpandLessIcon from '@material-ui/icons/ExpandLess';\nimport ExpandMoreIcon from '@material-ui/icons/ExpandMore';\nimport LocalLibraryIcon from '@material-ui/icons/LocalLibrary';\nimport './blog.css';\nimport {Link} from 'react-bootstrap'\n\nlet data = JSON.stringify(Data);\nlet blogData = JSON.parse(data);\n\nfunction Album(props) {\n  const container = {\n    hidden: { rotate: 180, opacity:0 },\n    show: {\n      rotate: 0,\n      opacity:1,\n    }\n  };\n  // console.log(props.cardOpen)\n  return (\n    <div>\n      <motion.div \n      className=\"cardblock\"\n      variants={container}\n      initial=\"hidden\"\n      animate=\"show\"\n      whileHover={{\n        scale: 1.08,\n        transition: { duration: 0.25 },\n      }}\n      >\n      <Card.Text >\n      <motion.div >\n        <p className=\"heading\" style={{fontSize:20, paddingTop:20}}>\n          {props.blogTitle}\n        </p>\n        </motion.div>\n      </Card.Text>\n      <Card.Body style={{paddingBottom:45}}>\n        <motion.div>\n        <Card.Img \n          src={props.imgsrc} \n          alt=\"Card image\"\n          className=\"cardMedia\" \n        />\n        </motion.div>\n      {props.cardOpen && \n        <AnimatePresence>\n        <motion.div\n        initial={{opacity:0}}\n        animate={{opacity:1, transition:2}}\n        >\n        <p className=\"desc\" gutterbottom>\n          {props.blogDescription}\n        </p>\n         <a href={props.blogLink}\n          style={{color:\"gray\", textDecoration:\"none\", fontSize:17, fontFamily:\"calibri\", fontSmooth: \"auto\", cursor:\"pointer\", display:\"flex\", justifyContent:\"center\"}}>\n            <LocalLibraryIcon style={{marginRight:7}}/>Read blog\n        </a>\n        </motion.div>\n      </AnimatePresence> \n    }\n     {(props.cardOpen) ?\n      <div onClick={props.isOpen} style={{float:\"right\", cursor:\"pointer\"}}>\n        <ExpandLessIcon style={{fontSize:40, color:\"#909090\"}}/>\n    </div> : (\n      <div onClick={props.isOpen} style={{float:\"right\", cursor:\"pointer\"}}>\n        <ExpandMoreIcon style={{fontSize:40, color:\"\t#909090\"}}/>\n    </div>\n    )}\n    </Card.Body>\n    </motion.div>\n    </div>\n  );\n}\n\nexport default function ProjectItems() {\n  const [cardOpen, setCardOpen]= useState(false);\n  return (\n    <React.Fragment>\n      <CssBaseline />\n      <main>\n        <div className=\"heroContent\">\n          <Container maxWidth=\"lg\">\n            <Typography \n              variant=\"h2\"\n              align=\"center\"\n              color=\"whitesmoke\"\n              style={{marginBottom:20, fontSize:70, fontFamily:\"calibri\"}}\n              className=\"root\"\n              gutterBottom\n            >\n              Blogs\n            </Typography>\n          </Container>\n        </div>\n        <Container maxWidth=\"md\">\n        <Grid container spacing={4}>\n        {blogData.map(post => (\n              <Grid item xs={12} sm={6} md={4}  key={post.id}>\n                <div>\n              <Album\n                  blogId={post.id}\n                  blogTitle={post.title}\n                  blogDescription={post.summary}\n                  imgsrc={post.image_link}\n                  blogLink={post.article_link}\n                  isOpen={()=>{setCardOpen(id => {if(post.id==id) return null; return post.id;})}}\n                  cardOpen={cardOpen===post.id}\n                />\n          </div>\n          </Grid>\n          ))}    \n          </Grid>      \n        </Container>\n      </main>\n    </React.Fragment>\n  );\n}","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/members/Members.jsx",["129","130"],"import { React, useEffect, useState } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { Container, Nav } from 'react-bootstrap';\nimport Card from 'react-bootstrap/Card';\nimport CardColumns from 'react-bootstrap/CardColumns';\nimport { BrowserRouter as Router } from 'react-router-dom';\nimport LinkedInIcon from '@material-ui/icons/LinkedIn';\nimport LanguageIcon from '@material-ui/icons/Language';\nimport GitHubIcon from '@material-ui/icons/GitHub';\nimport IconButton from '@material-ui/core/IconButton';\nimport { members } from './All_members';\nimport './members.css';\n\nconst container = {\n  hidden: { opacity: 1, scale: 0 },\n  visible: {\n    opacity: 1,\n    scale: 1,\n    transition: {\n      delayChildren: 0.1,\n      staggerChildren: 0.1,\n    },\n  },\n};\n\nconst item = {\n  hidden: {\n    scale: 0,\n    opacity: 0,\n    transition: { type: 'tween', duration: 0.8 },\n  },\n  visible: {\n    scale: 1,\n    opacity: 1,\n    transition: { type: 'tween', duration: 0.8 },\n  },\n};\n\nconst year = [\n  ['All', 'All'],\n  ['B Tech 4th year', '2020-21'],\n  ['B Tech 3rd Year', '2021-22'],\n  ['B Tech 2nd Year', '2022-23'],\n  ['MCA 2nd year', 'MCA'],\n];\n\nfunction Members() {\n  const [yearName, setYearName] = useState('All');\n  const [ProfileName, setProfileName] = useState('Hardware');\n  const [clickHardware, setClickHardware] = useState(false);\n  const [clickSoftware, setClickSoftware] = useState(false);\n  const [domain, setDomain] = useState([true, false]);\n\n  const handleClickHardware = () => {\n    setClickSoftware(false);\n    setClickHardware(!clickHardware);\n    setDomain([true, false]);\n    setProfileName('Hardware');\n  };\n\n  const handleClickSoftware = () => {\n    setClickHardware(false);\n    setClickSoftware(!clickSoftware);\n    setDomain([false, true]);\n    setProfileName('Software');\n  };\n\n  const subMenuAnimate = {\n    enter: (i) => ({\n      opacity: 1,\n      transition: {\n        duration: i * 0.8,\n      },\n      display: 'block',\n    }),\n    exit: {\n      opacity: 0,\n      transition: {\n        duration: 2,\n      },\n      // display: \"none\"\n    },\n  };\n\n  const displayYearNav = (index) => {\n    const domainCond = [clickHardware, clickSoftware];\n    if (domainCond[index]) {\n      return (\n        <Nav variant=\"tabs\" defaultActiveKey=\"All\" style={{ justifyContent: 'space-between' }}>\n          {year.map((item, idx) => {\n            if (index === 0 && idx === 4) {\n              return <></>;\n            }\n            return (\n              <motion.div\n                initial=\"exit\"\n                animate={domainCond[index] ? 'enter' : 'exit'}\n                variants={subMenuAnimate}\n                custom={idx}\n                key={idx}\n              >\n                <Nav.Item className=\"batch_item\">\n                  <Nav.Link onClick={(e) => handleYearClick(e, item[0])} eventKey={item[1]}>\n                    {item[1]}\n                  </Nav.Link>\n                </Nav.Item>\n              </motion.div>\n            );\n          })}\n        </Nav>\n      );\n    } else {\n      return <></>;\n    }\n  };\n\n  const handleYearClick = (e, yr) => {\n    setYearName(yr);\n  };\n  // console.log(yearName, ProfileName)\n\n  useEffect(()=>{\n    window.scrollTo(0,0)\n  },[])\n\n  return (\n    <Container className=\"members-container\">\n      <Router>\n        <h1\n          style={{\n            color: 'white',\n            textAlign: 'center',\n            padding: 15,\n            fontSize: 55,\n            fontWeight: 600,\n          }}\n        >\n          Members\n        </h1>\n        <br />\n        <>\n          <nav className=\"navbar\">\n            <motion.div className=\"menu-item \">\n              <button onClick={handleClickHardware} className=\"HardwareIcon btn shadow-none mx-5\">\n                <img src=\"images/hardware.png\" />\n              </button>\n            </motion.div>\n            <motion.div className=\"menu-item\">\n              <button onClick={handleClickSoftware} className=\"SoftwareIcon btn shadow-none mx-5\">\n                <img src=\"images/software.png\" />\n              </button>\n            </motion.div>\n          </nav>\n          {displayYearNav(domain.findIndex((e) => e === true))}\n        </>\n        <AnimatePresence initial={true}>\n          <motion.div\n            variants={container}\n            initial=\"hidden\"\n            animate=\"visible\"\n            style={{ display: 'flex', justifyContent: 'space-around', padding: 30 }}\n          >\n            <CardColumns>\n              <Container fluid=\"lg\">\n                {members\n                  .filter((member) => member.Profile === ProfileName)\n                  .filter((member) => member.Year === yearName)\n                  .map((member, id) => (\n                    <motion.div className=\"item\" variants={item} key={`member_${id}`}>\n                      <Card\n                        className=\"bg-dark text-white member_card\"\n                        style={{ margin: 20, background: '#141C3A' }}\n                      >\n                        <Card.Img src={member.Photo} alt={member.Name} />\n                        <Card.Title\n                          className=\"member_name\"\n                          style={{ background: '#141C3A', textAlign: 'center' }}\n                        >\n                          {member.Name}\n                        </Card.Title>\n                        <Card.Body style={{ background: '#141C3A' }}>\n                          <Card.Text style={{ background: '#141C3A' }} className=\"iconLinks\">\n                            {member.LinkedIn ? (\n                              <a href={member.LinkedIn}>\n                                <IconButton>\n                                  <LinkedInIcon fontSize=\"large\" className=\"buttonlinkedInIcon\" />\n                                </IconButton>\n                              </a>\n                            ) : (\n                              <IconButton>\n                                <LinkedInIcon fontSize=\"large\" className=\"buttonlinkedInIcon\" />\n                              </IconButton>\n                            )}\n                            {member.Website ? (\n                              <a href={member.Website}>\n                                <IconButton>\n                                  <LanguageIcon className=\"buttonwebIcon\" fontSize=\"large\" />\n                                </IconButton>\n                              </a>\n                            ) : (\n                              <IconButton>\n                                <LanguageIcon className=\"buttonwebIcon\" fontSize=\"large\" />\n                              </IconButton>\n                            )}\n                            {member.Github ? (\n                              <a href={member.Github}>\n                                <IconButton>\n                                  <GitHubIcon className=\"buttongithubIcon\" fontSize=\"large\" />\n                                </IconButton>\n                              </a>\n                            ) : (\n                              <IconButton>\n                                <GitHubIcon className=\"buttongithubIcon\" fontSize=\"large\" />\n                              </IconButton>\n                            )}\n                          </Card.Text>\n                        </Card.Body>\n                      </Card>\n                      <br></br>\n                    </motion.div>\n                  ))}\n              </Container>\n            </CardColumns>\n          </motion.div>\n        </AnimatePresence>\n      </Router>\n    </Container>\n  );\n}\n\nexport default Members;\n","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/navbar/navbar.js",[],"/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/home/home.js",["131","132","133"],"import React from 'react';\nimport Desc from './desc/desc';\nimport './home.css';\nimport Animation from './Animation/Animation';\nimport Team from './Team/Team';\nimport Members from './Team/CoreMembers/Members';\nimport Footer from '../Footer/footer-overall';\nimport SpiderLogo from '../assets/SpiderLogo.svg';\nfunction Home() {\n  return (\n    <div id=\"home-page\" style={{ overflowX: 'hidden' }}>\n      <img src={SpiderLogo} className=\"home-spiderLogo-img\" />\n      {/* <Animation /> */}\n      <Desc />\n      <hr></hr>\n      <Team></Team>\n      <Members></Members>\n      <Footer></Footer>\n    </div>\n  );\n}\n\nexport default Home;\n","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/blogs/blogs.jsx",["134","135","136"],"/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/Projects/Projects.jsx",["137","138","139","140","141","142","143","144","145","146","147"],"/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/Achievements/Achievements.jsx",["148","149","150","151","152","153","154","155","156","157"],"import React , {useEffect} from 'react';\nimport { Container, Row, Col, Image, Card, Button } from 'react-bootstrap';\nimport { motion, AnimateSharedLayout } from 'framer-motion';\nimport './Achievements.css';\nimport Modal from '../Modal/Modal';\nimport FooterBar from '../Footer/footer-bottom';\n\n// import data from './data.json';\n\nimport Toolbar from '../DomainToolbar/Toolbar';\nimport { getAllAchievementDetails } from '../api/requests';\nexport default function Achievements() {\n  const [modalShow, setModalShow] = React.useState(false);\n  const [props, setProps] = React.useState({});\n  const [data,setData] = React.useState([]);\n  const [domain, setDomain] = React.useState([].fill(false, 0, 4));\n  const [modalCondn, setModalCondn] = React.useState([].fill(false, 0, 4));\n  const [displayAll, setDisplayAll] = React.useState(true);\n  const [domainMap, setDomainMap] = React.useState({\n    \"TRONIX\": 0,\n    \"WEBDEV\": 1,\n    \"ALGOS\": 2,\n    \"APPDEV\": 3\n  });\n  useEffect(() => {\n    let arr = [];\n    for (let i = 0; i < 4; i++) {\n      arr.push(false);\n    }\n    setDomain([...arr]);\n    fetchData();\n  }, []);\n  useEffect(() => {\n    // console.log(domain);\n    let val = domain[0];\n    for (let i = 1; i < domain.length; i++) {\n      val = val || domain[i];\n    }\n    if (val) {\n      setDisplayAll(false);\n    } else {\n      setDisplayAll(true);\n    }\n  }, [domain])\n\n  const fetchData = async ()=>{\n    const res = await getAllAchievementDetails();\n    console.log(res);\n    setData(res);\n  }\n\n  const displayContent = (ele,id)=>{\n    if (id % 2 == 0) {\n      return (\n        <Col className=\"my-3\" md={5}>\n          <AnimateSharedLayout>\n            {modalShow && modalCondn[id] ? (\n              createModal()\n            ) : (\n              <motion.div className=\"motion-card\" layoutId={`expandable-card-${id + 1}`}>\n                <Card\n                  className=\"text-white achv-card\"\n                >\n                  <div className=\"achv-image-bg\">\n                    <Card.Img\n                    className=\"achv-image\"\n                    variant=\"top\"\n                    src={ele.achievement_photo_url}\n                  />\n                  </div>\n                  \n                  <Card.Body className=\"text-center achv-body\">\n                    <motion.div>\n                      <Card.Title className=\"achv-title\">{ele.name_of_event}</Card.Title>\n                    </motion.div>\n                    <motion.div whileHover={{ scale: 1.05 }} whileTap={{ scale: 0.9 }}>\n                      <button\n                        className='achv-card-button'\n                        onClick={() => {\n                          modalDisplay(\n                            ele.name_of_event,\n                            ele.Members,\n                            ele.desc,\n                            ele.achievement_photo_url,\n                            `expandable-card-${id + 1}`,\n                            `${id + 1}`,\n                          );\n                        }}\n                      >\n                        Learn More\n                      </button>\n                    </motion.div>\n                  </Card.Body>\n                </Card>\n              </motion.div>\n            )}\n          </AnimateSharedLayout>\n        </Col>\n      )\n    } else {\n      return (\n        <Col className=\"my-3\" md={5}>\n          <AnimateSharedLayout>\n            {modalShow && modalCondn[id] ? (\n              createModal()\n            ) : (\n              <motion.div className=\"motion-card\" layoutId={`expandable-card-${id + 1}`}>\n                <Card\n                  style={{ background: '#141C3A' }}\n                  className=\"text-white achv-card\"\n                >\n                  <div className=\"achv-image-bg\">\n                    <Card.Img\n                    className=\"achv-image\"\n                    variant=\"top\"\n                    src={ele.achievement_photo_url}\n                  />\n                  </div>\n                  <Card.Body className=\"text-center achv-body\">\n                    <motion.div>\n                      <Card.Title className=\"achv-title\">{ele.name_of_event}</Card.Title>\n                    </motion.div>\n                    <motion.div whileHover={{ scale: 1.05 }} whileTap={{ scale: 0.9 }}>\n                      <button\n                        className='achv-card-button'\n                        onClick={() => {\n                          modalDisplay(\n                            ele.name_of_event,\n                            ele.Members,\n                            ele.desc,\n                            ele.achievement_photo_url,\n                            `expandable-card-${id + 1}`,\n                            `${id + 1}`,\n                          );\n                        }}\n                      >\n                        Learn More\n                      </button>\n                    </motion.div>\n                  </Card.Body>\n                </Card>\n              </motion.div>\n            )}\n          </AnimateSharedLayout>\n        </Col>\n      )\n    }\n  }\n\n  const modalDisplay = (title, members, info, image, layoutId, key) => {\n    let mem = members;\n    let newMemberList = [];\n    for (let i = 0; i < mem.length; i++) {\n      newMemberList.push([mem[i].name, mem[i].photo_url]);\n    }\n    setProps({\n      title: title,\n      members: newMemberList,\n      info: info,\n      image: image,\n      layoutId: layoutId,\n    });\n    setModalShow(true);\n    let newArr = [...modalCondn];\n    newArr.fill(false, 0, 4);\n    newArr[Number(key) - 1] = true;\n    setModalCondn(newArr);\n  };\n  const createModal = () => {\n    return <Modal {...props} show={modalShow} onHide={() => setModalShow(false)}></Modal>;\n  };\n  return (\n    <div id=\"achv-page\">\n      <div className=\"achv-intro-section\">\n        {/* <Image\n          className=\"achv_banner\"\n          src=\"https://images.unsplash.com/photo-1488229297570-58520851e868?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=1049&q=80\"\n          fluid\n        ></Image> */}\n        <div className=\"display-3 achv_banner_title\">ACHIEVEMENTS</div>\n      </div>\n      <div className=\"domains\">\n      <Toolbar setDomain={setDomain} domain={domain}></Toolbar>\n      </div>\n      <Container fluid=\"md\">\n        <Container fluid>\n          <Row className='achv-display-cards'>\n          {displayAll\n              ? data.map((ele, id) => {\n                  return displayContent(ele, id);\n                })\n              : data\n                  .filter((e) => {\n                    if(e.domain == 'TRONIX'){\n                      return domain[0];\n                    }\n                    if(e.domain == 'WEBDEV' || e.domain == 'ALGOS' || e.domain == 'APPDEV'){\n                      return domain[1] ;\n                    }\n                  })\n                  .map((ele, id) => {\n                    return displayContent(ele, id);\n                  })}\n          </Row>\n        </Container>\n      </Container>\n      <FooterBar />\n    </div>\n  );\n}\n","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/Footer/footer-bottom.jsx",["158","159","160","161"],"import React from 'react';\nimport './footer-bottom.css';\n\nexport default function FooterBar() {\n  return (\n    <footer className=\"footer-bottom\">\n      <p>Weaved with 🕸 by Spider</p>\n      <div className=\"footer-bottom-links\">\n        <a\n          href=\"https://www.facebook.com/SpiderNitt/\"\n          rel=\"noopener noreferrer\"\n          target=\"_blank\"\n          className=\"fa fa-facebook\"\n        ></a>\n        <a\n          href=\"https://www.instagram.com/spider_nitt/\"\n          rel=\"noopener noreferrer\"\n          target=\"_blank\"\n          className=\"fa fa-instagram\"\n        ></a>\n        <a\n          href=\"https://www.linkedin.com/company/spider-r-d/\"\n          rel=\"noopener noreferrer\"\n          target=\"_blank\"\n          className=\"fa fa-linkedin\"\n        ></a>\n        <a\n          href=\"https://medium.com/spidernitt\"\n          rel=\"noopener noreferrer\"\n          target=\"_blank\"\n          className=\"fa fa-medium\"\n        ></a>\n      </div>\n      <br />\n    </footer>\n  );\n}\n","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/members/All_members.js",[],"/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/home/desc/desc.js",[],"/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/home/Team/Team.jsx",["162"],"import React from 'react';\r\nimport { Image, Container, Button } from 'react-bootstrap';\r\nimport './Team.css';\r\nexport default function Team() {\r\n  return (\r\n    <Container className=\"text-center\" id=\"team-container\">\r\n      <h1 className=\"home-team-title\">Our Team</h1>\r\n      <Image\r\n        className=\"home-team-image\"\r\n        style={{ borderRadius: 3 }}\r\n        src=\"images/team.jpg\"\r\n        fluid\r\n      ></Image>\r\n      <hr />\r\n      {/* <button id=\"view-team-btn\" onClick={() => {\r\n                window.location.href = \"/members\";\r\n            }}>View All Members</button> */}\r\n      <hr />\r\n    </Container>\r\n  );\r\n}\r\n","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/Footer/footer-overall.jsx",["163","164"],"import React from 'react';\nimport BottomFooter from './footer-bottom';\nimport MapComponent from './footer-maps';\nimport Grid from '@material-ui/core/Grid';\nimport Typography from '@material-ui/core/Typography';\nimport './footer-overall.css';\n\nfunction Footer() {\n  return (\n    <div id=\"Footer-Contacts\">\n      <div className=\"footer-main\">\n        <center>\n          <br />\n          <h3 className=\"footer-header\">\n            <strong>Find Us</strong>\n          </h3>\n        </center>\n      </div>\n      <div className=\"footer-contact-info\">\n        <div className=\"footer-contact-text\">\n          <h6>Primary Office</h6>\n          <p>Spider R&D Lab, </p>\n          <p>Ground floor, Old SAC,</p>\n          <p>(Opposite to CCD), NIT Tiruchirappalli.</p>\n\n          <h6>Email</h6>\n          <p><span>xyz@gmail.com</span> </p>\n        </div>\n        <div className=\"map-component\">\n          <MapComponent />\n        </div>\n        {/* <Grid item xs={12} sm={6}> */}\n        {/* <br />\n          <br />\n          <br />\n          <br />\n          <br />\n          <Typography align=\"center\" variant=\"h6\" gutterBottom>\n            <b>Primary Office</b>\n            <br />\n          </Typography>\n          <Typography align=\"center\" variant=\"body1\" gutterBottom>\n            Spider R&D Lab,\n            <br /> Ground floor, Old SAC,\n            <br /> (Opposite to CCD), NIT Tiruchirappalli.\n            <br />\n            <br />\n          </Typography> */}\n\n        {/* <Typography align=\"center\" variant=\"h6\" gutterBottom>\n            <b>Points of Contact</b>\n            <br />\n          </Typography>\n          <Typography align=\"center\" variant=\"body1\" gutterBottom>\n            Kumar Gaurav Singh\n            <br /> President, Spider\n            <br />\n            Mobile : 8210982383\n          </Typography>\n          <Typography align=\"center\" variant=\"body1\" gutterBottom>\n            Sudharshan S\n            <br /> Treasurer, Spider\n            <br />\n            Mobile : 9600897202\n          </Typography> */}\n        {/* </Grid> */}\n        {/* <Grid item xs={12} sm={6} className=\"map-grid\">\n          <MapComponent />\n        </Grid> */}\n      </div>\n      <br />\n      <br />\n      <br />\n      {/* <Grid container spacing={4}> */}\n      {/* <Grid item xs={12}>\n          <Typography align=\"center\" variant=\"h6\" gutterBottom>\n            <b>Points of Contact</b>\n            <br />\n          </Typography>\n        </Grid>\n\n        <Grid item md={3}>\n          <Typography align=\"center\" variant=\"body1\" gutterBottom>\n            Kumar Gaurav Singh\n            <br /> President, Spider\n            <br />\n            Ph: <span>6546468464</span>\n          </Typography>\n        </Grid>\n        <Grid item md={3}>\n          <Typography align=\"center\" variant=\"body1\" gutterBottom>\n            Kumar Gaurav Singh\n            <br /> President, Spider\n            <br />\n            Ph: <span>6546468464</span>\n          </Typography>\n        </Grid>\n        <Grid item md={3}>\n          <Typography align=\"center\" variant=\"body1\" gutterBottom>\n            Kumar Gaurav Singh\n            <br /> President, Spider\n            <br />\n            Ph: <span>6546468464</span>\n          </Typography>\n        </Grid>\n        <Grid item md={3}>\n          <Typography align=\"center\" variant=\"body1\" gutterBottom>\n            Kumar Gaurav Singh\n            <br /> President, Spider\n            <br />\n            Ph: <span>6546468464</span>\n          </Typography>\n        </Grid> */}\n      {/* <Grid item md={3} >\n        <Typography align=\"center\" variant=\"body1\" gutterBottom>\n            Kumar Gaurav Singh\n            <br /> President, Spider\n            <br />\n            Ph: <span>6546468464</span>\n          </Typography>\n        </Grid>\n        <Grid item md={3}>\n        <Typography align=\"center\" variant=\"body1\" gutterBottom>\n            Kumar Gaurav Singh\n            <br /> President, Spider\n            <br />\n            Ph: <span>6546468464</span>\n          </Typography>\n          </Grid>\n        <Grid item md={3}>\n        <Typography align=\"center\" variant=\"body1\" gutterBottom>\n            Kumar Gaurav Singh\n            <br /> President, Spider\n            <br />\n            Ph: <span>6546468464</span>\n          </Typography>\n          </Grid>\n        <Grid item md={3}>\n        <Typography align=\"center\" variant=\"body1\" gutterBottom>\n            Kumar Gaurav Singh\n            <br /> President, Spider\n            <br />\n            Ph: <span>6546468464</span>\n          </Typography>\n          </Grid> */}\n      {/* </Grid> */}\n      {/* <h4 className=\"footer-header\">\n        <strong>Points of Contact</strong>\n      </h4>\n      <div className=\"footer-points-of-contact\">\n        <div>\n          <strong> Kumar Gaurav Singh </strong>\n          <br /> President, Spider\n          <br />\n          Ph: <span>6546468464</span>\n        </div>\n        <div>\n          <strong> Kumar Gaurav Singh </strong>\n          <br /> President, Spider\n          <br />\n          Ph: <span>6546468464</span>\n        </div>\n        <div>\n          <strong>Kumar Gaurav Singh</strong>\n          <br /> President, Spider\n          <br />\n          Ph: <span>6546468464</span>\n        </div>\n        <div>\n          <strong> Kumar Gaurav Singh </strong>\n          <br /> President, Spider\n          <br />\n          Ph: <span>6546468464</span>\n        </div>\n      </div> */}\n      <br />\n      <hr />\n      <BottomFooter />\n    </div>\n  );\n}\n\nexport default Footer;\n","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/home/Team/CoreMembers/Members.jsx",["165"],"import GitHub from '@material-ui/icons/GitHub';\r\nimport Language from '@material-ui/icons/Language';\r\nimport LinkedIn from '@material-ui/icons/LinkedIn';\r\nimport Card from '@material-ui/core/Card';\r\nimport CardContent from '@material-ui/core/CardContent';\r\nimport Typography from '@material-ui/core/Typography';\r\nimport CardActionArea from '@material-ui/core/CardActionArea';\r\nimport CardActions from '@material-ui/core/CardActions';\r\nimport CardMedia from '@material-ui/core/CardMedia';\r\nimport IconButton from '@material-ui/core/IconButton';\r\nimport React, { useEffect, useState } from 'react';\r\nimport { Container, Row, Col, Button } from 'react-bootstrap';\r\nimport MemData from './coreMembersData.json';\r\nimport './Members.css';\r\nimport { Link } from 'react-router-dom';\r\nexport default function Members() {\r\n  const [data, setData] = useState([]);\r\n\r\n  useEffect(() => {\r\n    setData(MemData);\r\n  }, []);\r\n  return (\r\n    <div>\r\n      <Container id=\"home-core-container\" className=\"text-center\">\r\n        <h1 className=\"home-core-team-title\">Core Members</h1>\r\n        <Row>\r\n          {data.map((members, index) => {\r\n            return (\r\n              <Col md={4} key={index} style={{ margin: 'auto' }}>\r\n                <Card className=\"member_card\" style={{ maxWidth: 500 }}>\r\n                  <CardActionArea>\r\n                    <CardMedia\r\n                      component=\"img\"\r\n                      alt={members.Role}\r\n                      className=\"member_card_img\"\r\n                      // height=\"360\"\r\n                      image={members.Photo}\r\n                      title={members.Role}\r\n                    />\r\n                    <CardContent className=\"member_card_content\">\r\n                      <Typography gutterBottom variant=\"h5\" component=\"h2\">\r\n                        {members.Name}\r\n                      </Typography>\r\n                      <Typography variant=\"p\" color=\"textSecondary\">\r\n                        {members.Role}\r\n                      </Typography>\r\n                    </CardContent>\r\n\r\n                    <CardActions style={{ justifyContent: 'center' }}>\r\n                      <IconButton\r\n                        className=\"link_btn\"\r\n                        aria-label=\"personalSite\"\r\n                        href={members.Website}\r\n                      >\r\n                        <Language></Language>\r\n                      </IconButton>\r\n                      <IconButton\r\n                        aria-label=\"linkedIn\"\r\n                        href={members.LinkedIn}\r\n                        className=\"link_btn\"\r\n                      >\r\n                        <LinkedIn></LinkedIn>\r\n                      </IconButton>\r\n                      <IconButton\r\n                        aria-label=\"gitHubLink\"\r\n                        href={members.Github}\r\n                        className=\"link_btn\"\r\n                      >\r\n                        <GitHub></GitHub>\r\n                      </IconButton>\r\n                    </CardActions>\r\n                  </CardActionArea>\r\n                </Card>\r\n\r\n                <br />\r\n              </Col>\r\n            );\r\n          })}\r\n        </Row>\r\n      </Container>\r\n      <Link to=\"/members\">\r\n        <button className=\"members-buttons\" onClick={() => {}}>\r\n          View All members\r\n        </button>\r\n      </Link>\r\n    </div>\r\n  );\r\n}\r\n","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/home/Animation/Animation.jsx",["166","167","168"],"import React, { useEffect } from 'react'\r\nimport {gsap} from 'gsap';\r\nimport SpiderLogo2 from './spiderlogo2.png'\r\nimport './Animation.css'\r\nimport svgFile from './svg.svg';\r\nexport default function Animation() {\r\n    useEffect(() => {\r\n        const tl = gsap.timeline();\r\n        // style=\"enable-background:new 0 0 1186.4 662.8;\"\r\n        let svgAnimation = document.querySelector('#svg');\r\n        let bgd = document.querySelector('#background rect');\r\n        let table = document.querySelector('#table_legs, #table');\r\n        let lampLeg = document.querySelector('#lamp > .lamp-leg');\r\n        let lampbt = document.querySelector('#lamp-bottom');\r\n        let lampLight = document.querySelector('#lamp > .light');\r\n        let lampLine = document.querySelector('#lamp-line');\r\n        let lampLineB = document.querySelector('#lamp-line-b');\r\n        let lampLineT = document.querySelector('#lamp-line-t');\r\n        let lampCircle = document.querySelector('#lamp-circle');\r\n        let lampHead = document.querySelector('#lamp-head');\r\n        let lampHeader = document.querySelector('#lamp-header');\r\n        let lampBody = document.querySelector('#lamp-body');\r\n        let computer = document.querySelectorAll('#computer > *');\r\n        let keyboard = document.querySelectorAll('#keyboard > *');\r\n        let logo = document.querySelector('#svg_83');\r\n        let sunIcon = document.querySelector(\"#sun_icon\");\r\n        let asset = document.querySelectorAll('#computer_mouse > * , #coffee_mug > *');\r\n        tl.from(bgd, 0.2, { opacity: 0, scale: 0, transformOrigin: 'center center' })\r\n            .staggerFrom(table, 0.2, { y: \"-=200\", opacity: 0, ease: \"elastic.out(1,1)\" }, 0.1)\r\n            .from(lampLeg, 0.2, { opacity: 0, x: \"-200\", ease: \"elastic.out(1,1)\" })\r\n            .from(lampbt, 0.2, { opacity: 0, scale: 0, transformOrigin: 'center center' })\r\n            .from(lampLineB, 0.3, { opacity: 0, transformOrigin: '100% 100%', rotation: '-180deg' })\r\n            .from(lampCircle, 0.1, { opacity: 0, x: '-=100', y: '-=100' })\r\n            .from(lampLineT, 0.3, { opacity: 0, transformOrigin: '0% 100%', rotation: '-180deg' })\r\n            .from(lampHead, 0.2, { opacity: 0, scale: 0, ease: \"elastic.out(1,1)\" })\r\n            .from(lampHeader, 0.5, { transformOrigin: '60% 60%', rotation: '60deg' })\r\n            .from(lampBody, 0.5, { transformOrigin: '70% 70%', rotation: '-25deg' })\r\n            .staggerFrom(computer, 1, { opacity: 0, scale: 0, transformOrigin: 'center center', ease: \"back.out(1,1)\" }, 0.2)\r\n            .staggerFrom(logo, 1, { opacity: 0, scale: 0, transformOrigin: 'center center', ease: \"back.out(1,1)\" }, 0.2)\r\n            .staggerFrom(keyboard, 0.5, { opacity: 0, y: '-=100', ease: \"linear.inOut(1,1)\" }, 0.05)\r\n            .staggerFrom(asset, 0.5, { opacity: 0 }, 0.05)\r\n            .to(lampLight, 0.2, { opacity: 0.8, ease: \"elastic.out(1,1)\", delay: 0.5 }, \"a\")\r\n            .to(lampLight, 0.1, { opacity: 0 }, \"b\")\r\n            .to(lampLight, 0.1, { opacity: 0.2 }, \"c\")\r\n            .to(bgd, 0.2, { opacity: 0.1, delay: 0.5 }, \"a-=0.05\")\r\n            .to(bgd, 0.1, { opacity: 1 }, \"b-=0.05\")\r\n            .to(bgd, 0.1, { opacity: 0.1 }, \"c-=0.05\")\r\n            .to(bgd, 0.2, { opacity: 0, ease: \"elastic.out(1,1)\",fill: '#010213' })\r\n            .fromTo(lampLine, 0.2, { opacity: 0 }, { opacity: 0.2, delay: 0.5 }, \"a-=0.05\")\r\n            .to(lampLine, 0.1, { opacity: 1 }, \"b-=0.05\")\r\n            .to(lampLine, 0.1, { opacity: 0.5 }, \"c-=0.05\");\r\n    });\r\n\r\n    return (\r\n        <>\r\n            <div id=\"svg-container\">\r\n                <svg viewBox=\"0 0 1500 662.8\" xmlns=\"http://www.w3.org/2000/svg\" xmlnsXlink=\"http://www.w3.org/1999/xlink\" xmlSpace=\"preserve\" version=\"1.1\">\r\n                    <g>\r\n                        <g stroke=\"null\" id=\"background\">\r\n                            <rect stroke=\"null\" id=\"svg_1\" height=\"675.45826\" width=\"1508.30255\" fill=\"#192e45\" y=\"-8.65826\" x=\"-2.7\" />\r\n                        </g>\r\n                        <g id=\"table_legs\">\r\n                            <g id=\"svg_2\">\r\n                                <defs transform=\"translate(44.5312 0) translate(127.06 0) translate(20.2532 -10.1266)\">\r\n                                    <rect height=\"662.8\" width=\"1197.1\" y=\"0\" x=\"-9.7\" id=\"SVGID_1_\" />\r\n                                    <pattern height=\"100\" width=\"100\" id=\"logo-pattern\">\r\n                                        <image id=\"svg_3\" height=\"100\" width=\"100\" y=\"186.1\" x=\"423.2\" xlinkHref={SpiderLogo2} />\r\n                                    </pattern>\r\n                                </defs>\r\n                                <clipPath transform=\"translate(44.5312 0) translate(127.06 0) translate(20.2532 -10.1266)\" id=\"SVGID_2_\">\r\n                                    <use x=\"191.84456\" y=\"-10.12658\" id=\"svg_4\" xlinkHref=\"#SVGID_1_\" />\r\n          