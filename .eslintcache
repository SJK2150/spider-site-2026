.3,0l0,-2.1c0,-0.6 1,-1.2 2.3,-1.2l14.6,0c1.3,0 2.4,0.5 2.4,1.2l0,2.1z\" />\r\n                            <path id=\"svg_46\" strokeMiterlimit=\"10\" stroke=\"#0D0D0D\" fill=\"#FFFFFF\" d=\"m766.65991,593.9l-19.3,0l0,-2.1c0,-0.6 1,-1.2 2.3,-1.2l14.6,0c1.3,0 2.4,0.5 2.4,1.2l0,2.1z\" />\r\n                            <path id=\"svg_47\" strokeMiterlimit=\"10\" stroke=\"#0D0D0D\" fill=\"#FFFFFF\" d=\"m863.65991,594l-93.6,0l0,-2.1c0,-0.7 5,-1.2 11.2,-1.2l70.9,0c6.3,0 11.5,0.5 11.5,1.2l0,2.1z\" />\r\n                        </g>\r\n                        <g id=\"computer_mouse\">\r\n                            <path id=\"svg_67\" strokeMiterlimit=\"10\" stroke=\"#0B0B0B\" fill=\"#E5E9ED\" d=\"m992.33398,606.7c0,0 0,-8.6 12.9,-14.3c8.7,-3.9 18.7,-4 27.5,-0.6c6.8,2.6 13.7,7.2 13.7,15l-54.1,-0.1z\" />\r\n                            <path id=\"svg_68\" fill=\"#D1D4D6\" d=\"m1032.73398,592.5c-3.9,-1.4 -9,-2.6 -13.3,-2.4l0,15.7l26.1,0.1c-0.1,-4.3 -4.3,-10.3 -12.8,-13.4z\" />\r\n                        </g>\r\n                        <g id=\"coffee_mug\">\r\n                            <polyline id=\"svg_69\" strokeMiterlimit=\"10\" stroke=\"#0D0D0D\" fill=\"#F9EFE5\" points=\"1058.3211002349854,515.2341918945312 1073.6210269927979,605.5341796875 1116.5210514068604,605.5341796875 1130.9210758209229,515.2341918945312 1062.2211246490479,515.2341918945312 \" />\r\n                            <polygon id=\"svg_70\" fill=\"#F3E5D4\" points=\"1129.7211246490479,518.2341918945312 1094.6210269927979,515.2341918945312 1094.2211246490479,604.6342163085938 1115.9210758209229,604.6342163085938 \" />\r\n                            <polygon id=\"svg_71\" strokeMiterlimit=\"10\" stroke=\"#0D0D0D\" fill=\"#BE5532\" points=\"1061.8211002349854,545.4342041015625 1068.2211246490479,580.4342041015625 1121.3211002349854,580.4342041015625 1127.4210758209229,545.4342041015625 \" />\r\n                            <polygon id=\"svg_72\" fill=\"#AD4025\" points=\"1126.3211002349854,546.4342041015625 1094.7211246490479,546.4342041015625 1094.6210269927979,579.6342163085938 1120.7211246490479,579.6342163085938 \" />\r\n                            <line id=\"svg_73\" strokeMiterlimit=\"10\" strokeLinecap=\"round\" stroke=\"#9B3021\" fill=\"none\" y2=\"549.93418\" x2=\"1123.2211\" y1=\"549.93418\" x1=\"1066.8211\" />\r\n                            <line id=\"svg_74\" strokeMiterlimit=\"10\" strokeLinecap=\"round\" stroke=\"#9B3021\" fill=\"none\" y2=\"556.63418\" x2=\"1122.2211\" y1=\"556.63418\" x1=\"1068.6211\" />\r\n                            <line id=\"svg_75\" strokeMiterlimit=\"10\" strokeLinecap=\"round\" stroke=\"#9B3021\" fill=\"none\" y2=\"564.53418\" x2=\"1120.1211\" y1=\"564.53418\" x1=\"1069.6211\" />\r\n                            <line id=\"svg_76\" strokeMiterlimit=\"10\" strokeLinecap=\"round\" stroke=\"#9B3021\" fill=\"none\" y2=\"571.83418\" x2=\"1119.0211\" y1=\"571.83418\" x1=\"1070.6211\" />\r\n                            <line id=\"svg_77\" strokeMiterlimit=\"10\" strokeLinecap=\"round\" stroke=\"#9B3021\" fill=\"none\" y2=\"577.43418\" x2=\"1118.0211\" y1=\"577.43418\" x1=\"1070.5211\" />\r\n                            <polygon id=\"svg_78\" strokeMiterlimit=\"10\" stroke=\"#0B0B0B\" fill=\"#BE5532\" points=\"1053.8211002349854,523.2341918945312 1134.7211246490479,523.2341918945312 1134.7211246490479,515.2341918945312 1058.3211002349854,515.2341918945312 1053.8211002349854,515.2341918945312 \" />\r\n                            <polygon id=\"svg_79\" strokeMiterlimit=\"10\" stroke=\"#070808\" fill=\"#BE5532\" points=\"1060.3211002349854,504.6341857910156 1058.3211002349854,515.2341918945312 1129.7211246490479,515.2341918945312 1127.4210758209229,504.6341857910156 \" />\r\n                            <polygon id=\"svg_80\" fill=\"#AD4025\" points=\"1133.7211246490479,516.2341918945312 1128.5210514068604,516.2341918945312 1095.2211246490479,516.2341918945312 1095.2211246490479,522.3341674804688 1133.7211246490479,522.5341796875 \" />\r\n                            <polygon id=\"svg_81\" fill=\"#AD4025\" points=\"1128.5210514068604,514.4342041015625 1126.7211246490479,505.4342041015625 1095.3211002349854,505.5341796875 1095.3211002349854,514.4342041015625 \" />\r\n                            <polygon id=\"svg_82\" fill=\"#9B3021\" points=\"1059.4211978912354,514.4342041015625 1059.7211246490479,512.4342041015625 1128.1210269927979,512.4342041015625 1128.5210514068604,514.4342041015625 \" />\r\n                        </g>\r\n                        <image stroke=\"null\" xlinkHref={SpiderLogo2} id=\"svg_83\" height=\"159.99968\" width=\"159.99968\" y=\"315.55537\" x=\"729.83012\" />\r\n                        <g id=\"sun_icon\" stroke=\"null\">\r\n                        </g>\r\n                    </g>\r\n                </svg>\r\n            </div>\r\n        </>\r\n    )\r\n}\r\n","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/DomainToolbar/Toolbar.jsx",["169","170","171","172","173","174","175","176","177","178","179","180","181"],"import React, { useState } from 'react'\r\nimport { Paper, Box } from '@material-ui/core'\r\nimport { Android, Code, Language, SelectAll, CheckBox, Flag } from '@material-ui/icons'\r\nimport './Toolbar.css'\r\n\r\nexport default function Toolbar(props) {\r\n    let setDomain = props.setDomain;\r\n    let domain = props.domain\r\n    const handleOnClick = (index)=>{\r\n        if(index === -1){\r\n            setDomain([false,false,false,false]);\r\n            return;\r\n        }\r\n        // setDomain([false,false,false,false]);\r\n        let domain = [];\r\n        // domain = [];\r\n        for(let i=0;i<4;i++){\r\n            if(i === index){\r\n                domain.push(true)\r\n            }else{\r\n                domain.push(false)\r\n            }\r\n        }\r\n        setDomain(domain);\r\n        // console.log(domain);\r\n    }\r\n    return (\r\n        <div className='domain-toolbar'>\r\n            <Paper onClick={(e) => {\r\n                e.preventDefault();\r\n                handleOnClick(-1)\r\n            }} className={\"domain-box\"+(domain[0] == false && domain[1] == false && domain[2] == false && domain[3] == false ? ' domain-box-clicked' : '')} variant=\"outlined\" elevation={5}  >\r\n                <CheckBox className='domain-icon'></CheckBox>\r\n                <h6>ALL</h6>\r\n            </Paper>\r\n            <Paper onClick={(e)=>{\r\n                e.preventDefault();\r\n                handleOnClick(0)\r\n            }} className={\"domain-box\"+(domain[0] == true  ? ' domain-box-clicked' : '')} variant=\"outlined\" elevation={5} >\r\n                <SelectAll className='domain-icon'></SelectAll>\r\n                <h6>TRONIX</h6>\r\n            </Paper>\r\n            <Paper onClick={(e) => {\r\n                e.preventDefault();\r\n                handleOnClick(1)\r\n            }} className={\"domain-box\"+(domain[1] == true  ? ' domain-box-clicked' : '')} variant=\"outlined\" elevation={2} >\r\n                <Language className='domain-icon'></Language>\r\n                <h6>WEB DEV</h6>\r\n            </Paper>\r\n            <Paper onClick={(e) => {\r\n                e.preventDefault();\r\n                handleOnClick(2)\r\n            }} className={\"domain-box\"+(domain[2] == true  ? ' domain-box-clicked' : '')} variant=\"outlined\" elevation={2}>\r\n                <Code className='domain-icon'></Code>\r\n                <h6>ALGOS</h6>\r\n            </Paper>\r\n            <Paper onClick={(e) => {\r\n                e.preventDefault();\r\n                handleOnClick(3)\r\n            }} className={\"domain-box\"+(domain[3] == true  ? ' domain-box-clicked' : '')} variant=\"outlined\" elevation={2} >\r\n                <Android className='domain-icon'></Android>\r\n                <h6>APP DEV</h6>\r\n            </Paper>\r\n        </div>\r\n    )\r\n}\r\n","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/Modal/Modal.jsx",["182","183"],"import React from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport './Modal.css';\nimport ModalHeader from 'react-bootstrap/esm/ModalHeader';\nimport {\n  ModalBody,\n  ModalFooter,\n  ModalTitle,\n  Button,\n  Image,\n  ModalDialog,\n  Accordion,\n  Card,\n} from 'react-bootstrap';\nconst backdrop = {\n  visible: {\n    opacity: 1,\n    transition: {\n      from: 0,\n      duration: 1,\n    },\n  },\n  hidden: { opacity: 0 },\n};\nconst modal = {\n  hidden: {\n    // opacity:0,\n    // scale:0,\n    transition: { type: 'spring', stiffness: 120 },\n  },\n  visible: {\n    // opacity:1,\n    // scale:1,\n    transition: { type: 'spring', stiffness: 120 },\n  },\n};\nexport default function Modal(props) {\n  const { show, onHide, title, members, info, image, layoutId } = props;\n  return (\n    <motion.div\n      className=\"backdrop\"\n      variants={backdrop}\n      initial=\"hidden\"\n      animate=\"visible\"\n      exit=\"hidden\"\n      layoutId={layoutId}\n    >\n      <motion.div className=\"custom-modal\" variants={modal}>\n        <ModalDialog className=\"custom-modal\" scrollable centered size=\"lg\">\n          <ModalHeader className=\"modal-title\">\n            <ModalTitle>{title}</ModalTitle>\n          </ModalHeader>\n          <Image className=\"modal-image\" height=\"280px\" width=\"80%\" src={image}></Image>\n          <ModalBody className=\"modal-details\">\n            <Accordion className=\"\" defaultActiveKey=\"0\">\n              <Card style={{ background: '#6D4DFF', color: 'white', border:\"none\" }}>\n                <Accordion.Toggle\n                  as={Card.Header}\n                  style={{ padding: '0.5rem 1.25rem' }}\n                  eventKey=\"0\"\n                >\n                  Members\n                </Accordion.Toggle>\n                <Accordion.Collapse eventKey=\"0\">\n                  <div className=\"modal-members\">\n                    {members.map((member) => {\n                      return (\n                        <div>\n                          <Image\n                            width={64}\n                            height={64}\n                            src={member[1]}\n                            roundedCircle\n                          />\n                          <p>{member[0]}</p>\n                        </div>\n                      );\n                    })}\n                  </div>\n                </Accordion.Collapse>\n              </Card>\n            </Accordion>\n            <p className=\"modal-info\">\n              {info}\n              Lorem, ipsum dolor sit amet consectetur adipisicing elit. Non rerum quae harum est\n              quasi ratione! Quam, laudantium suscipit nulla iste distinctio dicta dolores beatae\n              odit eaque nesciunt eveniet, perspiciatis maiores?\n            </p>\n          </ModalBody>\n          <ModalFooter className=\"custom-modal-footer\">\n            <Button\n              variant=\"primary\"\n              onClick={() => {\n                onHide();\n              }}\n            >\n              Close\n            </Button>\n          </ModalFooter>\n        </ModalDialog>\n      </motion.div>\n    </motion.div>\n  );\n}\n","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/Footer/footer-maps.jsx",[],["184","185"],"/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/api/test.js",["186","187","188","189"],"import { deleteMember, getAllBlogsDetails, getBlogDetailsById, login } from './requests';\n\nconst test = () => {\n  //   getAllBlogsDetails();\n  //   getBlogDetailsById(1);\n  // login({\n  //   username: 'user',\n  //   password: 'password',\n  // });\n  // deleteMember(2);\n};\n\nexport { test };\n","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/Admin/Admin.jsx",["190","191"],"import React, { useState, useEffect } from 'react';\r\nimport {Row, Col, Container, ListGroup, Tab} from 'react-bootstrap';\r\nimport AdminProj from './AdminProj';\r\nfunction Admin() {\r\n    return ( \r\n    <div style={{height:\"100vh\",color:\"white\"}}>\r\n        <h1 className='text-center'>Admin Dashboard</h1>\r\n            <Container>\r\n                <Tab.Container id=\"list-group-tabs-example\" defaultActiveKey=\"#link1\">\r\n                    <Row>\r\n                        <Col sm={3}>\r\n                            <ListGroup>\r\n                                <ListGroup.Item action href=\"#link1\">\r\n                                    Project\r\n                                </ListGroup.Item>\r\n                                <ListGroup.Item action href=\"#link2\">\r\n                                    Achievement\r\n                                </ListGroup.Item>\r\n                                <ListGroup.Item action href=\"#link3\">\r\n                                    Blogs\r\n                                </ListGroup.Item>\r\n                                <ListGroup.Item action href=\"#link4\">\r\n                                    Members\r\n                                </ListGroup.Item>\r\n                            </ListGroup>\r\n                        </Col>\r\n                        <Col sm={9}>\r\n                            <Tab.Content>\r\n                                <Tab.Pane eventKey=\"#link1\">\r\n                                    <AdminProj></AdminProj>\r\n                                </Tab.Pane>\r\n                                <Tab.Pane eventKey=\"#link2\">\r\n                                    <div>Hello World</div>\r\n                                </Tab.Pane>\r\n                                <Tab.Pane eventKey=\"#link3\">\r\n                                    <div>Hello World</div>\r\n                                </Tab.Pane>\r\n                                <Tab.Pane eventKey=\"#link4\">\r\n                                    <div>Hello World</div>\r\n                                </Tab.Pane>\r\n                            </Tab.Content>\r\n                        </Col>\r\n                    </Row>\r\n                </Tab.Container>\r\n            </Container>\r\n    </div> \r\n    );\r\n}\r\n\r\nexport default Admin;","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/api/requests.js",[],"/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/Admin/AdminProj.jsx",["192","193","194","195","196","197","198"],"import { TextareaAutosize } from '@material-ui/core';\r\nimport React, { useState, useEffect } from 'react';\r\nimport { Col, Container, Row, Button, Form, Card } from 'react-bootstrap';\r\nimport { getAllProjectsDetails, getProjectDetailsById, addProject, deleteProject, updateProject } from '../api/requests';\r\n\r\nfunction AdminProj() {\r\n    const [projData, setProjData] = useState([]);\r\n    const [edit, setEdit] = useState(false);\r\n    const [currentProj,setCurrentProj] = useState({});\r\n    const [isLoading, setIsLoading] = useState(true);\r\n    useEffect(() => {\r\n        fetchData();\r\n    }, []);\r\n    \r\n    const submitEditForm = async(ele,name,img,desc,domain)=>{\r\n        let data = ele;\r\n        data.name = name;\r\n        data.project_photo_url = img;\r\n        data.desc = desc;\r\n        data.domain = domain;\r\n        const res = await updateProject(data,data.id);\r\n        console.log(res);\r\n    }\r\n\r\n    const fetchData = async () => {\r\n        const res = await getAllProjectsDetails();\r\n        setProjData([...res]);\r\n    }\r\n    return (\r\n        <>\r\n            <div>\r\n                <Row xs={1} md={2} className=\"g-4\">\r\n                    {!edit?(\r\n                        <>\r\n                            {projData.map((ele, id) => {\r\n                                \r\n                                return (\r\n                                    <Col>\r\n                                        <Card>\r\n                                            <Card.Img variant=\"top\" src={ele.project_photo_url} />\r\n                                            <Card.Body style={{ color: \"black\" }}>\r\n                                                <Card.Title>{ele.name}</Card.Title>\r\n                                                <Card.Text>\r\n                                                    <p>{ele.desc}</p>\r\n                                                </Card.Text>\r\n                                                <Card.Text>\r\n                                                    <h4>{ele.domain}</h4>\r\n                                                </Card.Text>\r\n                                            </Card.Body>\r\n                                            <Card.Footer className=\"text-muted\">\r\n                                                <Row>\r\n                                                    <Col><Button variant='Warning'\r\n                                                        onClick={() => {\r\n                                                            setEdit(true);\r\n                                                            setCurrentProj(ele);\r\n                                                        }}\r\n                                                    >Edit</Button></Col>\r\n                                                    {/* <Col><Button></Button></Col> */}\r\n                                                </Row>\r\n                                            </Card.Footer>\r\n                                        </Card>\r\n                                    </Col>\r\n                                )\r\n                            })}\r\n                        </>\r\n                    ):(\r\n                        <>\r\n                                <Form style={{width:\"100%\"}}>\r\n                                    <Form.Group className=\"mb-3\">\r\n                                        <Form.Label>Title</Form.Label>\r\n                                        <Form.Control id=\"edit-name\" type=\"text\" value={currentProj.name} placeholder=\"Enter title\" />\r\n                                    </Form.Group>\r\n                                    <Form.Group className=\"mb-3 d-flex flex-column\">\r\n                                        <Form.Label>Summary</Form.Label>\r\n                                        <textarea name=\"\" id=\"edit-desc\" cols=\"30\" rows=\"10\">\r\n                                            {currentProj.desc}\r\n                                        </textarea>\r\n                                    </Form.Group>\r\n                                    <Form.Group className=\"mb-3\">\r\n                                        <Form.Label>Image Link</Form.Label>\r\n                                        <Form.Control type=\"text\" id=\"edit-img\" value={currentProj.project_photo_url} placeholder=\"Enter Image Link\" />\r\n                                    </Form.Group>\r\n                                    <Form.Group className=\"mb-3\">\r\n                                        <Form.Label>Domain</Form.Label>\r\n                                        <Form.Control id=\"edit-domain\" type=\"text\" value={currentProj.domain} placeholder=\"Enter domain\" />\r\n                                    </Form.Group>\r\n                                    <div>\r\n                                        <Button style={{marginRight:\"10px\"}} variant=\"primary\" type=\"submit\" onClick={()=>{\r\n                                            let name = document.getElementById(\"edit-name\").value;\r\n                                            let desc = document.getElementById(\"edit-desc\").innerHTML;\r\n                                            let img = document.getElementById(\"edit-img\").value;\r\n                                            let domain = document.getElementById(\"edit-domain\").value;\r\n\r\n                                            submitEditForm(currentProj,name,img,desc,domain);\r\n                                        }}>\r\n                                            Submit\r\n                                        </Button>\r\n                                        <Button variant='danger' onClick={() => {\r\n                                            setEdit(false) }}>Close</Button>\r\n                                    </div>\r\n                                </Form>\r\n                        </>\r\n                    )}\r\n                </Row>\r\n            </div>\r\n        </>\r\n    );\r\n}\r\n\r\nexport default AdminProj;","/Users/naveennair/Desktop/projects/spiderMainSite/site-vfinal/src/api/Index.js",[],{"ruleId":"199","severity":1,"message":"200","line":5,"column":24,"nodeType":"201","messageId":"202","endLine":5,"endColumn":25,"suggestions":"203"},{"ruleId":"199","severity":1,"message":"200","line":5,"column":30,"nodeType":"201","messageId":"202","endLine":5,"endColumn":31,"suggestions":"204"},{"ruleId":"205","replacedBy":"206"},{"ruleId":"207","replacedBy":"208"},{"ruleId":"209","severity":1,"message":"210","line":6,"column":8,"nodeType":"211","messageId":"212","endLine":6,"endColumn":20},{"ruleId":"209","severity":1,"message":"213","line":8,"column":8,"nodeType":"211","messageId":"212","endLine":8,"endColumn":17},{"ruleId":"209","severity":1,"message":"214","line":14,"column":8,"nodeType":"211","messageId":"212","endLine":14,"endColumn":13},{"ruleId":"209","severity":1,"message":"215","line":13,"column":9,"nodeType":"211","messageId":"212","endLine":13,"endColumn":13},{"ruleId":"216","severity":1,"message":"217","line":115,"column":61,"nodeType":"218","messageId":"219","endLine":115,"endColumn":63},{"ruleId":"220","severity":1,"message":"221","line":141,"column":17,"nodeType":"222","endLine":141,"endColumn":50},{"ruleId":"220","severity":1,"message":"221","line":146,"column":17,"nodeType":"222","endLine":146,"endColumn":50},{"ruleId":"209","severity":1,"message":"223","line":4,"column":8,"nodeType":"211","mess